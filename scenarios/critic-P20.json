{ "name": "critic P20 d1 round1 - every effect read, gaps re-measured", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 30000},
  {"wait": 900},

  {"note": "DATA: the 28-spell table, the audit, the fx library"},
  {"eval": "__DQ.spells()"},
  {"eval": "__DQ.spellTable()"},
  {"eval": "(function(){ var s=__DQ.state(); return { fx: s.fx, demo: s.demo }; })()"},
  {"eval": "(async function(){ var m = await import('/src/art/fx.js'); return { ids: m.FX.ids(), specs: m.FX.ids().map(function(i){var p=m.FX.spec(i); return i+':'+p.ms+'/'+p.peak+'/'+(p.sfx||'none');}) }; })()"},

  {"note": "GAP 3 re-check: showAll grid geometry and one band shot to measure a pad in pixels"},
  {"eval": "(__DQ.fxClear(), __DQ.showAll(0))"}, {"wait": 110}, {"shot": "g3-band1"},
  {"eval": "(__DQ.fxClear(), __DQ.showAll(1))"}, {"wait": 150}, {"shot": "g3-band2"},
  {"eval": "(__DQ.fxClear(), __DQ.showAll(2))"}, {"wait": 150}, {"shot": "g3-band3"},
  {"eval": "(__DQ.fxClear(), __DQ.showAll(3))"}, {"wait": 150}, {"shot": "g3-band4"},

  {"note": "GAP 4 re-check: fire held still at its own stated peak, and a plain frame to diff against"},
  {"eval": "__DQ.fxClear()"}, {"wait": 700}, {"shot": "g4-empty-meadow"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('fire_burst', 90))"}, {"wait": 260}, {"shot": "g4-fire-burst-peak"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('fire_burst', 200))"}, {"wait": 260}, {"shot": "g4-fire-burst-200"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('fire_big', 120))"}, {"wait": 260}, {"shot": "g4-fire-big-peak"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('fire_big', 300))"}, {"wait": 260}, {"shot": "g4-fire-big-300"},
  {"eval": "__DQ.fxResume()"},

  {"note": "GAP 1 regression re-check: does the comet actually fly from caster to target"},
  {"eval": "(__DQ.fxClear(), __DQ.orbit(20), __DQ.fx('fire_burst', {at:{x:3.2,y:0.7,z:-2.0}, from:{x:-4.5,y:1.0,z:3.2}, travelMs:900, sound:false, flash:false}))"},
  {"wait": 160}, {"shot": "g1-fly-160"},
  {"wait": 250}, {"shot": "g1-fly-410"},
  {"wait": 250}, {"shot": "g1-fly-660"},
  {"wait": 320}, {"shot": "g1-impact"},
  {"eval": "__DQ.orbit(0)"},

  {"note": "GAP 2 re-check: who listens for the shake a heavy spell asks for"},
  {"eval": "(async function(){ var B = (await import('/src/engine/events.js')).Bus; return { fxShakeListeners: B.count('fx.shake'), fxPlayListeners: B.count('fx.play') }; })()"},
  {"eval": "(__DQ.fxClear(), __DQ.fx('fire_big'))"}, {"wait": 70},
  {"eval": "(function(){ return { asked: __DQ.state().fx.shakes, hook: __DQ.state().fx.shakeHook, cam: __DQ.state().demo.shake }; })()"},
  {"shot": "g2-shake-frame"},

  {"note": "READ EVERY EFFECT, held still at its own peak, camera on it"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('fire_burst'))"}, {"wait": 200}, {"shot": "e01-fire_burst"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('fire_big'))"}, {"wait": 200}, {"shot": "e02-fire_big"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('ice_shards'))"}, {"wait": 200}, {"shot": "e03-ice_shards"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('frost'))"}, {"wait": 200}, {"shot": "e04-frost"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('lightning'))"}, {"wait": 200}, {"shot": "e05-lightning"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('wind_slash'))"}, {"wait": 200}, {"shot": "e06-wind_slash"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('holy_light'))"}, {"wait": 200}, {"shot": "e07-holy_light"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('heal_sparkle'))"}, {"wait": 200}, {"shot": "e08-heal_sparkle"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('buff_aura'))"}, {"wait": 200}, {"shot": "e09-buff_aura"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('debuff_aura'))"}, {"wait": 200}, {"shot": "e10-debuff_aura"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('chime_ring'))"}, {"wait": 200}, {"shot": "e11-chime_ring"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('sleep_z', 500))"}, {"wait": 200}, {"shot": "e12-sleep_z"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('confusion_birds', 400))"}, {"wait": 200}, {"shot": "e13-confusion_birds"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('poison_bubbles', 400))"}, {"wait": 200}, {"shot": "e14-poison_bubbles"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('root_vines'))"}, {"wait": 200}, {"shot": "e15-root_vines"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('shockwave'))"}, {"wait": 200}, {"shot": "e16-shockwave"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('smoke_puff', 300))"}, {"wait": 200}, {"shot": "e17-smoke_puff"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('defeat_poof'))"}, {"wait": 200}, {"shot": "e18-defeat_poof"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('level_pillar'))"}, {"wait": 200}, {"shot": "e19-level_pillar"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('chest_sparkle'))"}, {"wait": 200}, {"shot": "e20-chest_sparkle"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('footstep_dust', 120))"}, {"wait": 200}, {"shot": "e21-footstep_dust"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('water_splash'))"}, {"wait": 200}, {"shot": "e22-water_splash"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('warp_swirl'))"}, {"wait": 200}, {"shot": "e23-warp_swirl"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('lantern_glow'))"}, {"wait": 200}, {"shot": "e24-lantern_glow"},
  {"eval": "(__DQ.fxClear(), __DQ.fxHold('screen_flash', 40))"}, {"wait": 200}, {"shot": "e25-screen_flash"},
  {"eval": "__DQ.fxResume()"},

  {"note": "MOTION: does a fire spell read as fire while it moves, frame by frame"},
  {"eval": "(__DQ.fxClear(), __DQ.fx('fire_burst'))"},
  {"burst": {"name": "m-fire", "count": 8, "interval": 70}},
  {"eval": "(__DQ.fxClear(), __DQ.fx('heal_sparkle'))"},
  {"burst": {"name": "m-heal", "count": 8, "interval": 110}},
  {"eval": "(__DQ.fxClear(), __DQ.fx('lightning'))"},
  {"burst": {"name": "m-bolt", "count": 6, "interval": 60}},

  {"note": "BLIND A/B: a fire spell and a heal at the scale a real battle would use (0.7)"},
  {"eval": "(__DQ.fxClear(), __DQ.fx('fire_burst', {scale:0.7}))"}, {"wait": 90}, {"shot": "ab-fire-battlescale"},
  {"eval": "(__DQ.fxClear(), __DQ.fx('heal_sparkle', {scale:0.7}))"}, {"wait": 200}, {"shot": "ab-heal-battlescale"},
  {"eval": "(__DQ.fxClear(), __DQ.cast('kascorcha'))"}, {"wait": 130}, {"shot": "ab-kascorcha"},
  {"eval": "(__DQ.fxClear(), __DQ.cast('mendall'))"}, {"wait": 210}, {"shot": "ab-mendall"},
  {"eval": "(__DQ.fxClear(), __DQ.cast('fullmend'))"}, {"wait": 260}, {"shot": "ab-fullmend"},

  {"note": "does anything leak"},
  {"eval": "__DQ.fxClear()"}, {"wait": 1400}, {"shot": "z-quiet"},
  {"eval": "(function(){ var f=__DQ.state().fx; return { particles: f.particles, dropped: f.dropped, draws: f.draws }; })()"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"},
  {"assert": "__DQ.state().fx.particles === 0", "msg": "every particle retired"}
]}
