{
  "name": "P04 corner wallpaper green census",
  "steps": [
    {"waitFor": "window.__DQ && __DQ.ready && typeof __DQ.teleport==='function'", "timeout": 60000},
    {"wait": 900},
    {"eval": "(()=>{if(__DQ.title)try{__DQ.title('game');}catch(e){}return 'go';})()"},
    {"wait": 1500},
    {"eval": "JSON.stringify(__DQ.teleport('meadow',0,0))"},
    {"wait": 1800},
    {"eval": "(()=>{for(let i=0;i<10;i++){try{__DQ.press&&__DQ.press('Enter');}catch(e){}}return 'skip';})()"},
    {"wait": 400},
    {"eval": "(()=>{__DQ.teleport('meadow',-18,20);return 'nw';})()"},
    {"wait": 1000},
    {"eval": "(()=>{if(__DQ.cameraOrbit)__DQ.cameraOrbit(315);return 'nw';})()"},
    {"wait": 600},
    {"shot": "01-corner-nw"},
    {"eval": "(()=>{__DQ.teleport('meadow',18,22);return 'ne';})()"},
    {"wait": 1000},
    {"eval": "(()=>{if(__DQ.cameraOrbit)__DQ.cameraOrbit(45);return 'ne';})()"},
    {"wait": 600},
    {"shot": "02-corner-ne"},
    {"eval": "(()=>{__DQ.teleport('meadow',-18,-18);return 'sw';})()"},
    {"wait": 1000},
    {"eval": "(()=>{if(__DQ.cameraOrbit)__DQ.cameraOrbit(225);return 'sw';})()"},
    {"wait": 600},
    {"shot": "03-corner-sw"},
    {"eval": "(()=>{__DQ.teleport('meadow',20,-12);return 'se';})()"},
    {"wait": 1000},
    {"eval": "(()=>{if(__DQ.cameraOrbit)__DQ.cameraOrbit(135);return 'se';})()"},
    {"wait": 600},
    {"shot": "04-corner-se"},
    {"note": "green-hue census offline"}
  ]
}
