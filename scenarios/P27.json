{ "name": "P27 music — the Sound Room jukebox, live playback, crossfades, stingers, ducking",
  "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 30000},
  {"wait": 600}, {"shot": "jukebox-idle"},
  {"assert": "__DQ.themes().length >= 27", "msg": "every theme, variant and cue is registered"},
  {"assert": "['title','village','overworld','castle','town','church','inn','dungeon','tension','battle','boss','victory','levelup','befriend','family','family.short','family.broken','family.whole','inn.sleep','lullaby','wedding','highfeather','quiet_hand','finale'].every(id => __DQ.themes().some(t => t.id === id))", "msg": "all CANON §9 music ids exist"},
  {"assert": "__DQ.harmony().every(h => h.clash.length === 0 || ['tension','lullaby'].includes(h.id))", "msg": "melody sits on the harmony on strong beats (tension/lullaby chromatics are intentional)"},
  {"eval": "(__DQ.select('overworld'), __DQ.play('overworld', {fade: 0.2}))"},
  {"wait": 3200}, {"shot": "playing-overworld"},
  {"assert": "__DQ.state().audio.theme === 'overworld' && __DQ.state().audio.voices > 0", "msg": "overworld is actually sounding live"},
  {"assert": "__DQ.state().audio.bar >= 1", "msg": "the beat clock advances"},
  {"eval": "(__DQ.select('village'), __DQ.play('village', {fade: 1.2}))"},
  {"wait": 2600}, {"shot": "crossfade-to-village"},
  {"assert": "__DQ.state().audio.theme === 'village'", "msg": "crossfaded to the village"},
  {"eval": "__DQ.stinger('battle_start')"},
  {"wait": 2000}, {"shot": "battle-after-stinger"},
  {"assert": "__DQ.state().audio.theme === 'battle'", "msg": "battle stinger chains into the battle theme"},
  {"eval": "__DQ.stinger('victory')"},
  {"wait": 1500}, {"shot": "victory"},
  {"assert": "__DQ.state().audio.theme === 'victory'", "msg": "victory fanfare cuts the battle"},
  {"eval": "(__DQ.play('family'), __DQ.duck(0.55, 1500))"},
  {"wait": 400},
  {"assert": "__DQ.state().audio.ducked === 0.55", "msg": "dialogue duck applied"},
  {"eval": "__DQ.stinger('level_up')"},
  {"wait": 2500}, {"shot": "family-with-levelup"},
  {"eval": "__DQ.play('silence', {fade: 0.6})"},
  {"wait": 1200},
  {"assert": "__DQ.state().audio.theme === 'silence'", "msg": "silence is a real cue"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"}
]}
