{
 "name": "P16 monster models — roster, formation, clips, budget",
 "steps": [
  {
   "waitFor": "window.__DQ && __DQ.ready",
   "timeout": 30000
  },
  {
   "wait": 1800
  },
  {
   "note": "DQ battle formation of five, animating, UI on"
  },
  {
   "shot": "formation"
  },
  {
   "eval": "__DQ.list().length"
  },
  {
   "assert": "__DQ.list().length >= 20",
   "msg": "first-build roster present"
  },
  {
   "wait": 1500
  },
  {
   "eval": "__DQ.state().fps"
  },
  {
   "assert": "__DQ.state().fps >= 60",
   "msg": ">= 60 fps with a formation of 5 animating"
  },
  {
   "eval": "__DQ.play(\"*\",\"attack\")"
  },
  {
   "burst": {
    "name": "formation-attack",
    "count": 5,
    "interval": 90
   }
  },
  {
   "wait": 400
  },
  {
   "eval": "__DQ.play(\"*\",\"hurt\")"
  },
  {
   "burst": {
    "name": "formation-hurt",
    "count": 3,
    "interval": 80
   }
  },
  {
   "wait": 500
  },
  {
   "eval": "__DQ.play(\"*\",\"defeat\")"
  },
  {
   "burst": {
    "name": "formation-defeat",
    "count": 5,
    "interval": 110
   }
  },
  {
   "eval": "__DQ.state().fps"
  },
  {
   "assert": "__DQ.state().fps >= 60",
   "msg": ">= 60 fps while five monsters poof"
  },
  {
   "eval": "__DQ.play(\"*\",\"join\")"
  },
  {
   "burst": {
    "name": "formation-join",
    "count": 5,
    "interval": 180
   }
  },
  {
   "wait": 600
  },
  {
   "eval": "(__DQ.show([\"gloopold\",\"sunmane\"]), 0)"
  },
  {
   "wait": 600
  },
  {
   "shot": "formation-bosses"
  },
  {
   "eval": "(() => { const d = __DQ.drawCalls(); const w = Object.entries(d).sort((a,b)=>b[1].max-a[1].max)[0]; return {monsters: Object.keys(d).length, worst: w[0], worstCalls: w[1].max}; })()"
  },
  {
   "assert": "Object.values(__DQ.drawCalls()).every(v => v.max <= 10)",
   "msg": "<= 10 draw calls per monster (idle, hit sparkles and poof, shadow pass included)"
  },
  {
   "eval": "__DQ.ui(false)"
  },
  {
   "eval": "(__DQ.freeze(false), __DQ.cameraOrbit(0), __DQ.show([\"gloop\"]))"
  },
  {
   "wait": 500
  },
  {
   "shot": "gloop-front"
  },
  {
   "eval": "__DQ.cameraOrbit(38)"
  },
  {
   "wait": 180
  },
  {
   "shot": "gloop-34"
  },
  {
