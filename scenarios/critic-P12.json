  {
   "note": "P11 gap 1 evidence part A: does a standing villager animate at all? 40 samples over 8s"
  },
  {
   "eval": "(async () => { const s=ms=>new Promise(r=>setTimeout(r,ms)); const out={}; for (const id of ['wat','dimity','gudgeon','budge','nib']) out[id]=[]; for (let k=0;k<40;k++){ for (const id of Object.keys(out)) { const m=__DQ.npcModel(id); const p=m.pose||{}; out[id].push([+m.y.toFixed(4), +(p.amp||0).toFixed(3), +(p.phase||0).toFixed(3), p.blinking?1:0, p.clip]); } await s(200); } const sum={}; for (const id of Object.keys(out)) { const A=out[id]; const ys=A.map(a=>a[0]); sum[id]={rootYrange:+(Math.max(...ys)-Math.min(...ys)).toFixed(4), ampMax:Math.max(...A.map(a=>a[1])), distinctPhases:new Set(A.map(a=>a[2])).size, blinkFrames:A.filter(a=>a[3]).length, clip:A[0][4]}; } return JSON.stringify(sum); })()"
  },
  {
   "assert": "false",
   "msg": "P11 #1 - a standing villager must breathe: pose.amp>0 and pose.phase must advance (measured amp 0, 1 distinct phase, root Y range 0.0000)"
