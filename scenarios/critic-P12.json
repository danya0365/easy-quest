{
 "name": "critic-P12 round 1 \u2014 dialogue + NPC life in the real game",
 "steps": [
  {
   "waitFor": "window.__DQ && __DQ.ready",
   "timeout": 60000
  },
  {
   "note": "=== P12/P11 critic round 1 \u2014 REAL GAME /index.html ==="
  },
  {
   "wait": 1600
  },
  {
   "eval": "__DQ.state().map.id + ' | maps=' + JSON.stringify(__DQ.listMaps())"
  },
  {
   "eval": "JSON.stringify(__DQ.teleport('puddlewick'))"
  },
  {
   "wait": 600
  },
  {
   "shot": "00-field-open"
  },
  {
   "note": "--- P11 NPC LIFE: sample every 5s, 3 times, with bursts ---"
  },
  {
   "eval": "window.__snap=(t)=>__DQ.npcs().map(n=>n.id+' @'+n.x.toFixed(2)+','+n.z.toFixed(2)+' f'+Math.round(n.facing)+' '+n.mode+' moved'+(n.moved||0).toFixed(1)).join(' // '); __snap(0)"
  },
  {
   "eval": "__DQ.cameraOrbit(0)"
  },
  {
   "burst": {
    "name": "life-a",
    "count": 8,
    "interval": 250
   }
  },
  {
   "wait": 5000
  },
  {
   "eval": "__snap(1)"
  },
  {
   "burst": {
    "name": "life-b",
    "count": 8,
    "interval": 250
   }
  },
  {
   "wait": 8000
  },
  {
   "eval": "__snap(2)"
  },
  {
   "burst": {
    "name": "life-c",
    "count": 8,
    "interval": 250
   }
  },
  {
   "wait": 8000
  },
  {
   "eval": "__snap(3)"
  },
  {
   "shot": "01-life-after-21s"
  },
  {
   "note": "--- does an NPC turn to face the player? facing before vs after walking up ---"
  },
  {
   "eval": "JSON.stringify(__DQ.npcs().filter(n=>n.id==='gudgeon').map(n=>({f:n.facing,mode:n.mode})))"
  },
  {
   "eval": "__DQ.walkTo ? __DQ.walkTo(__DQ.npcs().find(n=>n.id==='gudgeon').x+1.4, __DQ.npcs().find(n=>n.id==='gudgeon').z+1.4) : 'no walkTo'"
  },
  {
   "wait": 2500
  },
  {
   "eval": "JSON.stringify(__DQ.npcs().filter(n=>n.id==='gudgeon').map(n=>({f:n.facing,mode:n.mode})))"
  },
  {
   "shot": "02-stood-next-to-gudgeon"
  },
  {
   "note": "--- real input path: press confirm while stood beside him (no debug hook) ---"
  },
  {
   "press": "Enter"
  },
  {
   "wait": 1200
  },
  {
   "eval": "JSON.stringify(__DQ.state().dialogue && {open:__DQ.state().dialogue.open,npc:__DQ.state().dialogue.npc,name:__DQ.state().dialogue.name})"
  },
  {
   "shot": "03-real-confirm-talk"
  },
  {
   "eval": "JSON.stringify(__DQ.npcs().filter(n=>n.id==='gudgeon').map(n=>({f:n.facing,mode:n.mode,talking:n.talking})))"
