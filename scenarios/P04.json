{ "name": "P04 props & set dressing — the whole kit on one hillside", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 40000},
  {"wait": 1200},
  {"assert": "__DQ.errors.length === 0", "msg": "boots with no runtime errors"},
  {"eval": "__DQ.state().demo"},
  {"eval": "__DQ.views()"},
  {"eval": "__DQ.view('wide')"}, {"wait": 700}, {"shot": "wide"},
  {"eval": "__DQ.view('species')"}, {"wait": 600}, {"shot": "species-row"},
  {"eval": "__DQ.view('yard')"}, {"wait": 600}, {"shot": "prop-yard"},

  {"note": "GROUNDING (gap 1): the same yard with every contact pool switched off — nothing is planted"},
  {"eval": "__DQ.contacts(false)"}, {"wait": 500}, {"shot": "prop-yard-NO-pools"},
  {"eval": "__DQ.contacts(true)"}, {"wait": 500}, {"shot": "prop-yard-pools-back"},
  {"eval": "__DQ.pools()"},
  {"assert": "__DQ.state().demo.counts.contactShadows > 300", "msg": "every standing prop registered a contact pool"},
  {"assert": "__DQ.state().demo.pools.spread >= 1.5", "msg": "pools reach past their prop's own footprint"},

  {"eval": "__DQ.view('well')"}, {"wait": 600}, {"shot": "well-hay-stile"},
  {"eval": "__DQ.view('scarecrow')"}, {"wait": 600}, {"shot": "scarecrow-garden"},
  {"eval": "__DQ.view('orchard')"}, {"wait": 600}, {"shot": "orchard-ladder-crates"},
  {"eval": "__DQ.view('pond')"}, {"wait": 900}, {"shot": "pond-ripples-lilies"},
  {"eval": "__DQ.view('bridge')"}, {"wait": 600}, {"shot": "footbridge"},
  {"eval": "__DQ.view('hedge')"}, {"wait": 600}, {"shot": "hedgerow-rim"},
  {"eval": "__DQ.view('rim')"}, {"wait": 600}, {"shot": "rim-rows-and-hills"},
  {"eval": "__DQ.view('hills')"}, {"wait": 600}, {"shot": "out-over-the-hills"},

  {"note": "THE OUTFIELD KIT (gap 5): a green world needs stone grey, ochre stubble, bare earth, bramble purple and toadstool red"},
  {"eval": "__DQ.view('fallen')"}, {"wait": 700}, {"shot": "fallen-oak-stump-log-fungi"},
  {"eval": "__DQ.view('fold')"}, {"wait": 700}, {"shot": "drystone-wall-and-gate"},
  {"eval": "__DQ.view('hayfield')"}, {"wait": 700}, {"shot": "stooks-and-handcart"},
  {"assert": "__DQ.state().demo.counts.molehills >= 2 && __DQ.state().demo.counts.bracken >= 2 && __DQ.state().demo.counts.scrapes >= 1", "msg": "bare earth, bracken and a scrape are in the kit"},
  {"assert": "__DQ.state().demo.counts.stooks >= 4 && __DQ.state().demo.counts.wallRuns >= 2 && __DQ.state().demo.counts.mushrooms >= 8", "msg": "stooks, drystone wall runs and toadstools are in the kit"},
  {"assert": "__DQ.state().demo.counts.dryTufts >= 120", "msg": "straw tufts run through the green ones"},

  {"note": "LANTERNS (gap 4): the glass must be visible from every angle by day and blaze at night"},
  {"eval": "__DQ.view('yard')"}, {"wait": 500}, {"shot": "lantern-day"},

  {"note": "SEE-THROUGH (gap 2): stand the hero behind an oak, lens on the near side. Clean alpha, ink kept, no dither."},
  {"eval": "__DQ.see('off')"}, {"eval": "__DQ.underTree(0)"}, {"wait": 900}, {"shot": "seethrough-OFF-solid-tree"},
  {"eval": "__DQ.see('auto')"},
  {"burst": {"name": "seethrough-fade-in", "count": 5, "interval": 60}},
  {"wait": 700}, {"shot": "seethrough-ON-ghosted"},
  {"eval": "__DQ.see()"},
  {"assert": "__DQ.see().fading === 1 && __DQ.see().ghosts === 1", "msg": "exactly the one tree in the way is ghosted"},
  {"assert": "__DQ.see().dither.fades === 0 && __DQ.see().dither.hero === false", "msg": "the screen-door dither is switched off"},
  {"assert": "__DQ.see().tuning.alpha >= 0.35 && __DQ.see().tuning.alpha <= 0.45", "msg": "the ghost sits at 35-45 percent"},
  {"assert": "__DQ.see().tuning.outMs <= 160", "msg": "eased out in 150ms"},
  {"eval": "__DQ.underTree(3)"}, {"wait": 800}, {"shot": "seethrough-second-tree"},
  {"note": "and step out from under it: everything solid again"},
  {"eval": "__DQ.walk(0, 6)"}, {"eval": "__DQ.view('wide')"}, {"wait": 900},
  {"assert": "__DQ.see().fading === 0", "msg": "nothing fades when nothing covers the hero"},

  {"eval": "__DQ.budget()"},
  {"assert": "__DQ.budget().calls < 150", "msg": "under 150 draw calls"},
  {"assert": "__DQ.budget().tris < 150000", "msg": "under 150k triangles"},
  {"note": "wind: the same view three seconds apart — trees, grass, flowers and washing all move"},
  {"eval": "__DQ.view('life')"}, {"wait": 500},
  {"burst": {"name": "wind-and-life", "count": 5, "interval": 900}},
  {"note": "the birds: walk the stand-in hero into the flock by the lane and they clatter up and away"},
  {"eval": "__DQ.view('birds')"}, {"eval": "__DQ.walk(0.5, 14)"}, {"wait": 900}, {"shot": "birds-pecking"},
  {"eval": "__DQ.walk(0.5, 8.5)"},
  {"burst": {"name": "birds-take-off", "count": 5, "interval": 320}},
  {"eval": "__DQ.state().demo.counts"},
  {"eval": "__DQ.view('wide')"}, {"eval": "__DQ.orbit(true, 10)"},
  {"burst": {"name": "orbit", "count": 4, "interval": 1400}},
  {"eval": "__DQ.orbit(false)"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"},
  {"assert": "__DQ.state().fps >= 55", "msg": "fps >= 55"},
  {"assert": "__DQ.state().demo.grove.species >= 9 && __DQ.state().demo.grove.instances > 150", "msg": "the mixed grove is planted (9+ species)"},
  {"assert": "__DQ.state().demo.counts.butterflies >= 5 && __DQ.state().demo.counts.birds >= 6 && __DQ.state().demo.counts.motes >= 40", "msg": "butterflies, birds and pollen motes are alive"},
  {"assert": "__DQ.screenshotReady() === true", "msg": "screenshotReady"}
]}
