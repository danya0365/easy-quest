{ "name": "P04 props & set dressing — the whole kit on one hillside", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 40000},
  {"wait": 1200},
  {"assert": "__DQ.errors.length === 0", "msg": "boots with no runtime errors"},
  {"eval": "__DQ.state().demo"},
  {"eval": "__DQ.views()"},
  {"eval": "__DQ.view('wide')"}, {"wait": 700}, {"shot": "wide"},
  {"eval": "__DQ.view('species')"}, {"wait": 600}, {"shot": "species-row"},
  {"eval": "__DQ.view('yard')"}, {"wait": 600}, {"shot": "prop-yard"},
  {"eval": "__DQ.view('well')"}, {"wait": 600}, {"shot": "well-hay-stile"},
  {"eval": "__DQ.view('scarecrow')"}, {"wait": 600}, {"shot": "scarecrow-garden"},
  {"eval": "__DQ.view('orchard')"}, {"wait": 600}, {"shot": "orchard-ladder-crates"},
  {"eval": "__DQ.view('pond')"}, {"wait": 900}, {"shot": "pond-ripples-lilies"},
  {"eval": "__DQ.view('bridge')"}, {"wait": 600}, {"shot": "footbridge"},
  {"eval": "__DQ.view('hedge')"}, {"wait": 600}, {"shot": "hedgerow-rim"},
  {"eval": "__DQ.view('rim')"}, {"wait": 600}, {"shot": "rim-rows-and-hills"},
  {"eval": "__DQ.view('hills')"}, {"wait": 600}, {"shot": "out-over-the-hills"},
  {"eval": "__DQ.budget()"},
  {"assert": "__DQ.budget().calls < 150", "msg": "under 150 draw calls"},
  {"assert": "__DQ.budget().tris < 150000", "msg": "under 150k triangles"},
  {"note": "wind: the same view three seconds apart — trees, grass, flowers and washing all move"},
  {"eval": "__DQ.view('life')"}, {"wait": 500},
  {"burst": {"name": "wind-and-life", "count": 5, "interval": 900}},
  {"note": "the birds: walk the stand-in hero into the flock by the lane and they clatter up and away"},
  {"eval": "__DQ.view('birds')"}, {"eval": "__DQ.walk(0.5, 14)"}, {"wait": 900}, {"shot": "birds-pecking"},
  {"eval": "__DQ.walk(0.5, 8.5)"},
  {"burst": {"name": "birds-take-off", "count": 5, "interval": 320}},
  {"eval": "__DQ.state().demo.counts"},
  {"eval": "__DQ.view('wide')"}, {"eval": "__DQ.orbit(true, 10)"},
  {"burst": {"name": "orbit", "count": 4, "interval": 1400}},
  {"eval": "__DQ.orbit(false)"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"},
  {"assert": "__DQ.state().fps >= 55", "msg": "fps >= 55"},
  {"assert": "__DQ.state().demo.grove.species >= 9 && __DQ.state().demo.grove.instances > 150", "msg": "the mixed grove is planted (9+ species)"},
  {"assert": "__DQ.state().demo.counts.butterflies >= 5 && __DQ.state().demo.counts.birds >= 6 && __DQ.state().demo.counts.motes >= 40", "msg": "butterflies, birds and pollen motes are alive"},
  {"assert": "__DQ.screenshotReady() === true", "msg": "screenshotReady"}
]}
