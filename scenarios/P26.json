{ "name": "P26 cutscene engine, story flags, quest hint and Act I",
  "steps": [
    {"waitFor": "window.__DQ && __DQ.ready", "timeout": 30000},
    {"wait": 1400},
    {"note": "the boot: the field, the ledger panel, the quest hint from the flags"},
    {"shot": "01-boot-ledger"},
    {"assert": "__DQ.state().story && __DQ.state().story.scenes>=9", "msg": "nine Act I beats are registered"},
    {"assert": "!!(__DQ.state().quest && __DQ.state().quest.hint)", "msg": "there is a next-thing-to-do sentence"},

    {"note": "a scene written in the demo page itself: letterbox, a cutscene camera, one DQ conversation"},
    {"eval": "__DQ.storyAuto(false)"},
    {"eval": "(__DQ.dsl(), 'started')"},
    {"wait": 2400},
    {"shot": "02-dsl-letterbox"},
    {"assert": "!!__DQ.storyState().playing", "msg": "the runner reports the scene it is playing"},
    {"assert": "__DQ.storyActors().length>=1", "msg": "cutscene actors are standing in the world"},
    {"press": "Enter", "times": 5, "delay": 460},
    {"wait": 900},
    {"shot": "03-dsl-talking"},
    {"press": "Enter", "times": 14, "delay": 380},
    {"wait": 2200},
    {"shot": "04-dsl-done"},
    {"assert": "__DQ.flag('ch1.awake')===true", "msg": "the scene set the CANON flag ch1.awake"},
    {"assert": "!__DQ.storyState().playing", "msg": "the scene finished and handed the world back"},
    {"assert": "__DQ.state().scene==='field'", "msg": "the field is the top scene again"},
    {"assert": "__DQ.storyActors().length===0", "msg": "every cutscene actor was cleared up"},

    {"note": "B1 in Hollybank: Papa, the boots, and the flag"},
    {"eval": "__DQ.flagsClear()"},
    {"eval": "__DQ.teleport('hollybank')"},
    {"wait": 1600},
    {"eval": "(__DQ.beat('b1'), 'started')"},
    {"wait": 1800},
    {"shot": "05-b1-cottage"},
    {"press": "Enter", "times": 8, "delay": 460},
    {"wait": 1400},
    {"shot": "06-b1-boots"},
    {"press": "Enter", "times": 14, "delay": 420},
    {"wait": 2400},
    {"shot": "07-b1-after"},
    {"assert": "__DQ.flag('ch1.awake')===true", "msg": "B1 sets ch1.awake"},
    {"assert": "(__DQ.state().quest||{}).beat==='B2'", "msg": "the hint moved on to B2"},

    {"note": "the ribbon: B6's Long Stair, the memory the whole game hangs off"},
    {"eval": "__DQ.flag('ch1.dare_taken', true)"},
    {"eval": "__DQ.teleport('meadow')"},
    {"wait": 1400},
    {"eval": "(__DQ.beat('b6'), 'started')"},
    {"wait": 2600},
    {"shot": "08-b6-manor-card"},
    {"press": "Enter", "times": 10, "delay": 420},
    {"wait": 1600},
    {"shot": "09-b6-children"},
    {"eval": "__DQ.storySkip()"},
    {"wait": 1500},
    {"assert": "!__DQ.storyState().playing", "msg": "Cancel gets a child out of any scene"},
    {"assert": "__DQ.state().scene==='field'", "msg": "a skip leaves you standing in the field"},
    {"shot": "10-after-skip"},

    {"note": "B9 — Look at the sky, lad. The locked wide-and-low shot, the silence, the chapter card"},
    {"eval": "__DQ.flagsClear()"},
    {"eval": "__DQ.flag('ch1.bertie_taken', true)"},
    {"eval": "(__DQ.beat('b9'), 'started')"},
    {"wait": 3400},
    {"shot": "11-b9-wide-low"},
    {"press": "Enter", "times": 4, "delay": 560},
    {"wait": 2400},
    {"shot": "12-b9-push-in"},
    {"press": "Enter", "times": 16, "delay": 460},
    {"wait": 5000},
    {"shot": "13-b9-ten-years"},
    {"press": "Enter", "times": 6, "delay": 460},
    {"wait": 2600},
    {"assert": "__DQ.flag('ch1.halvard_fallen')===true", "msg": "B9 sets ch1.halvard_fallen"},
    {"assert": "__DQ.flag('ch2.start')===true", "msg": "B9 opens Act II"},
    {"assert": "__DQ.flags().act===2", "msg": "the Act is derived from the flags"},
    {"assert": "__DQ.flag('party.pip')===null", "msg": "Pip bolts into the dark at B9"},
    {"wait": 800},
    {"shot": "14-act-two"},

    {"note": "the save carries the story: write, clear, read back"},
    {"eval": "__DQ.flag('ch1.ribbon', true)"},
    {"assert": "__DQ.state().flags['ch1.ribbon']===true", "msg": "state() publishes the flags"},
    {"assert": "__DQ.errors.length===0", "msg": "no runtime errors"},
    {"assert": "__DQ.state().scene==='field'", "msg": "the world is playable at the end"}
  ]
}
