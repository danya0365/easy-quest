{ "name": "P26 cutscene engine, story flags, quest hint and Act I",
  "steps": [
    {"waitFor": "window.__DQ && __DQ.ready", "timeout": 30000},
    {"wait": 1400},
    {"note": "the boot: the field, the ledger panel, the quest hint read off the flags"},
    {"shot": "01-boot-ledger"},
    {"assert": "__DQ.state().story && __DQ.state().story.scenes>=9", "msg": "nine Act I beats are registered"},
    {"assert": "!!(__DQ.state().quest && __DQ.state().quest.hint)", "msg": "there is a next-thing-to-do sentence"},
    {"assert": "__DQ.flags().of>=60", "msg": "every CANON flag name is in the registry"},
    {"eval": "__DQ.storyAuto(false)"},
    {"eval": "__DQ.autoAdvance(true, 300)"},

    {"note": "a scene written in the demo page itself: letterbox, a two-shot, one DQ conversation, a choice"},
    {"eval": "(__DQ.dsl(), 'started')"},
    {"wait": 700},
    {"assert": "__DQ.state().sceneStack.indexOf('cutscene')>=0", "msg": "the scene locks the controls from step one"},
    {"wait": 1900},
    {"shot": "02-dsl-letterbox"},
    {"assert": "!!__DQ.storyState().playing", "msg": "the runner reports the scene it is playing"},
    {"assert": "__DQ.storyActors().length>=1", "msg": "cutscene actors are standing in the world"},
    {"assert": "!!document.querySelector('#story-bars.on')", "msg": "the letterbox is up for the whole scene"},
    {"wait": 2600},
    {"shot": "03-dsl-talking"},
    {"waitFor": "!__DQ.storyState().playing", "timeout": 60000},
    {"wait": 900},
    {"shot": "04-dsl-done"},
    {"assert": "__DQ.flag('ch1.awake')===true", "msg": "the scene set the CANON flag ch1.awake"},
    {"assert": "__DQ.state().sceneStack.indexOf('cutscene')<0", "msg": "the cutscene scene is off the stack"},
    {"assert": "__DQ.storyActors().length===0", "msg": "every cutscene actor was cleared up"},

    {"note": "B1 in Hollybank: Papa by his chair, the boots, the flag, the hint moving on"},
    {"eval": "__DQ.flagsClear()"},
    {"eval": "(__DQ.listMaps().indexOf('hollybank')>=0 ? __DQ.teleport('hollybank') : 'B1 plays by road')"},
    {"wait": 1600},
    {"eval": "(__DQ.beat('b1'), 'started')"},
    {"wait": 2200},
    {"shot": "05-b1-cottage"},
    {"assert": "__DQ.storyActors().some(function(a){return a.id==='halvard';})", "msg": "Papa is standing in the scene"},
    {"wait": 3600},
    {"shot": "06-b1-boots"},
    {"waitFor": "!__DQ.storyState().playing", "timeout": 90000},
    {"wait": 900},
    {"shot": "07-b1-after"},
    {"assert": "__DQ.flag('ch1.awake')===true", "msg": "B1 sets ch1.awake"},
    {"assert": "(__DQ.state().quest||{}).beat==='B2'", "msg": "the hint moved on to B2"},

    {"note": "B3 on the Long Lane: the Gloop, a real fight, and Bobble joining"},
    {"eval": "__DQ.teleport('meadow', 3.6, 28.0)"},
    {"wait": 1500},
    {"eval": "__DQ.flag('ch1.left_home', true)"},
    {"eval": "(__DQ.beat('b3'), 'started')"},
    {"wait": 3000},
    {"shot": "08-b3-gloop"},
    {"waitFor": "__DQ.state().scene==='battle' || !__DQ.storyState().playing", "timeout": 40000},
    {"wait": 1800},
    {"shot": "09-b3-battle"},
    {"waitFor": "!__DQ.storyState().playing", "timeout": 180000},
    {"wait": 900},
    {"shot": "10-b3-bobble-joined"},
    {"assert": "__DQ.flag('party.bobble')===true", "msg": "Bobble joins at B3, as CANON says"},
    {"assert": "__DQ.flags().party.indexOf('bobble')>=0", "msg": "the party reads off the party.* flags"},
    {"assert": "__DQ.state().sceneStack.join(',')==='field'", "msg": "a story fight leaves nothing on the stack"},

    {"note": "the skip: a child can get out of any scene, with the key or with the word on the bar"},
    {"eval": "__DQ.autoAdvance(false)"},
    {"eval": "__DQ.flag('ch1.dare_taken', true)"},
    {"eval": "(__DQ.beat('b6'), 'started')"},
    {"wait": 2800},
    {"shot": "11-b6-manor-card"},
    {"assert": "__DQ.storyState().skippable===true", "msg": "the story says it can be skipped"},
    {"press": "Escape", "times": 1},
    {"wait": 2200},
    {"assert": "!__DQ.storyState().playing", "msg": "Cancel ends the scene"},
    {"assert": "__DQ.state().sceneStack.indexOf('cutscene')<0", "msg": "a skip leaves you standing in the field"},
    {"assert": "__DQ.storyActors().length===0", "msg": "a skip clears the actors up too"},
    {"shot": "12-after-skip"},

    {"note": "the skip works mid-conversation too, where the message box eats Cancel itself"},
    {"eval": "(__DQ.beat('b5'), 'started')"},
    {"wait": 3200},
    {"assert": "!!__DQ.storyState().playing", "msg": "B5 is talking"},
    {"press": "x", "times": 1},
    {"wait": 2200},
    {"assert": "!__DQ.storyState().playing", "msg": "X skips a scene while a message box is open"},

    {"note": "B9 - Look at the sky, lad: wide and low, then the push in, then the chapter card"},
    {"eval": "__DQ.flagsClear()"},
    {"eval": "__DQ.flag('ch1.bertie_taken', true)"},
    {"eval": "__DQ.autoAdvance(true, 300)"},
    {"eval": "(__DQ.beat('b9'), 'started')"},
    {"wait": 4200},
    {"shot": "13-b9-wide-low"},
    {"wait": 5200},
    {"shot": "14-b9-push-in"},
    {"waitFor": "__DQ.flag('ch2.start')===true", "timeout": 120000},
    {"wait": 600},
    {"shot": "15-b9-ten-years"},
    {"waitFor": "!__DQ.storyState().playing", "timeout": 60000},
    {"eval": "__DQ.autoAdvance(false)"},
    {"assert": "__DQ.flag('ch1.halvard_fallen')===true", "msg": "B9 sets ch1.halvard_fallen"},
    {"assert": "__DQ.flags().act===2", "msg": "the Act is derived from the flags"},
    {"assert": "(__DQ.state().quest||{}).act===2", "msg": "the hint is an Act II hint now"},
    {"wait": 900},
    {"shot": "16-act-two"},

    {"eval": "__DQ.flag('ch1.ribbon', true)"},
    {"assert": "__DQ.state().flags['ch1.ribbon']===true", "msg": "state() publishes the flags"},
    {"assert": "__DQ.flags().unknown.length===0", "msg": "every flag the story set is a CANON name"},
    {"assert": "__DQ.state().sceneStack[0]==='field'", "msg": "the world is playable at the end"},
    {"assert": "__DQ.state().sceneStack.indexOf('cutscene')<0", "msg": "no letterbox is left nailed to the screen"},
    {"assert": "!document.querySelector('#story-bars.on')", "msg": "and the bars are down again"},
    {"eval": "JSON.stringify({errors: __DQ.errors.length, mine: __DQ.errors.filter(function(e){return String(e).indexOf('story')>=0;}).length})"},
    {"assert": "__DQ.errors.filter(function(e){return String(e).indexOf('story')>=0;}).length===0", "msg": "the story reported no errors of its own"},
    {"assert": "__DQ.errors.length===0", "msg": "no runtime errors"}
  ]
}
