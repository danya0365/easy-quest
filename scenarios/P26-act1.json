{ "name": "P24 Act I end to end: B1 to the chapter card, every CANON flag",
  "steps": [
    {"waitFor": "window.__DQ && __DQ.ready", "timeout": 30000},
    {"wait": 1400},
    {"eval": "__DQ.storyAuto(false)"},
    {"eval": "__DQ.flagsClear()"},
    {"eval": "__DQ.autoAdvance(true, 260)"},
    {"note": "one sitting: nine beats back to back, with the real fights in them"},
    {"eval": "(__DQ.act1(), 'the whole Act started')"},
    {"wait": 20000},
    {"shot": "01-act-opening"},
    {"waitFor": "__DQ.flag('ch1.left_home')===true", "timeout": 240000},
    {"shot": "02-left-home"},
    {"waitFor": "__DQ.flag('party.bobble')===true", "timeout": 300000},
    {"shot": "03-bobble"},
    {"waitFor": "__DQ.flag('ch1.dare_taken')===true", "timeout": 300000},
    {"shot": "04-the-dare"},
    {"waitFor": "__DQ.flag('ch1.ribbon')===true", "timeout": 420000},
    {"shot": "05-the-ribbon"},
    {"waitFor": "__DQ.flag('ch1.farewell')===true", "timeout": 420000},
    {"shot": "06-goodbyes"},
    {"waitFor": "__DQ.flag('ch2.start')===true", "timeout": 420000},
    {"wait": 1200},
    {"shot": "07-ten-years-pass"},
    {"waitFor": "!__DQ.storyState().playing", "timeout": 120000},
    {"eval": "__DQ.autoAdvance(false)"},
    {"wait": 1200},
    {"shot": "08-act-two-playable"},
    {"eval": "JSON.stringify(__DQ.flags())"},
    {"assert": "__DQ.flag('ch1.awake')===true", "msg": "B1"},
    {"assert": "__DQ.flag('ch1.left_home')===true", "msg": "B2"},
    {"assert": "__DQ.flag('party.bobble')===true", "msg": "B3"},
    {"assert": "__DQ.flag('ch1.met_willow')===true && __DQ.flag('ch1.met_sera')===true", "msg": "B4"},
    {"assert": "__DQ.flag('ch1.dare_taken')===true", "msg": "B5"},
    {"assert": "__DQ.flag('ch1.manor_cleared')===true && __DQ.flag('ch1.ribbon')===true", "msg": "B6"},
    {"assert": "__DQ.flag('ch1.farewell')===true", "msg": "B7"},
    {"assert": "__DQ.flag('ch1.pass_open')===true && __DQ.flag('ch1.bertie_taken')===true", "msg": "B8"},
    {"assert": "__DQ.flag('ch1.halvard_fallen')===true && __DQ.flag('ch2.start')===true", "msg": "B9"},
    {"assert": "__DQ.flags().act===2", "msg": "Act II has begun"},
    {"assert": "__DQ.flags().unknown.length===0", "msg": "every flag the Act set is a CANON name"},
    {"assert": "__DQ.state().sceneStack[0]==='field'", "msg": "the child is standing in a playable world at the end"},
    {"assert": "__DQ.state().scene==='field' || __DQ.state().scene==='dialogue'", "msg": "nothing but the world or a message box is left up"},
    {"assert": "__DQ.state().sceneStack.indexOf('cutscene')<0", "msg": "no letterbox left behind"},
    {"assert": "!!(__DQ.state().quest && __DQ.state().quest.hint)", "msg": "there is a next thing to do in Act II"},
    {"assert": "__DQ.errors.filter(function(e){return String(e).indexOf('story')>=0;}).length===0", "msg": "the story reported no errors of its own"}
  ]
}
