{ "name": "critic-P27 a2r2 — the music, live path (sample loading, fallbacks, missed notes)",
  "steps": [
    {"waitFor": "window.__DQ && __DQ.ready", "timeout": 30000},
    {"note": "wake the context the way a player would"},
    {"eval": "document.getElementById('wake').click()"},
    {"wait": 400},

    {"note": "home-village theme — measure how long the live path takes to have its samples"},
    {"eval": "(__DQ.select('village'), __DQ.play('village'))"},
    {"wait": 1200}, {"shot": "village-1200ms"},
    {"eval": "JSON.stringify(__DQ.state().audio)"},
    {"wait": 8000}, {"shot": "village-9s"},
    {"eval": "JSON.stringify({s:__DQ.state().audio, samp:__DQ.samples().mbFetched})"},

    {"note": "overworld"},
    {"eval": "__DQ.play('overworld')"},
    {"wait": 1200}, {"shot": "overworld-1200ms"},
    {"wait": 8000}, {"shot": "overworld-9s"},
    {"eval": "JSON.stringify(__DQ.state().audio)"},

    {"note": "battle: the stinger, then the loop, then victory — the real in-game chain"},
    {"eval": "__DQ.stinger('battle_start')"},
    {"wait": 2200}, {"shot": "battle-start"},
    {"eval": "__DQ.play('battle')"},
    {"wait": 6000}, {"shot": "battle-6s"},
    {"eval": "__DQ.stinger('victory')"},
    {"wait": 3000}, {"shot": "victory"},
    {"eval": "JSON.stringify({s:__DQ.state().audio, samp:__DQ.samples()})"},

    {"note": "dialogue duck and the fade to silence"},
    {"eval": "__DQ.duck(0.55, 2000)"},
    {"wait": 900}, {"shot": "ducked"},
    {"eval": "__DQ.stop({fade:1.2})"},
    {"wait": 1800}, {"shot": "stopped"},

    {"assert": "__DQ.errors.length===0", "msg": "no runtime errors while the music plays"},
    {"assert": "__DQ.harmony().every(r=>r.clash.length<=3)", "msg": "no theme has more than 3 strong-beat clashes"},
    {"assert": "!__DQ.state().audio.missed", "msg": "no notes were missed by the live scheduler"}
  ]}
