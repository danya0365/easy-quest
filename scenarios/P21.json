{ "name": "P21 items and equipment", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 30000},
  {"wait": 500},
  {"note": "the whole table at a glance"},
  {"shot": "01-at-a-glance"},
  {"eval": "__DQ.state().items.total"},
  {"eval": "JSON.stringify(__DQ.state().items.counts)"},
  {"eval": "JSON.stringify(__DQ.itemAudit().missingWords)"},
  {"eval": "JSON.stringify(__DQ.fit())"},
  {"eval": "__DQ.show('all')"}, {"wait": 250}, {"shot": "02-everything-p1"},
  {"eval": "__DQ.turn(1)"}, {"wait": 200}, {"shot": "03-everything-p2"},
  {"eval": "__DQ.show('consumable')"}, {"wait": 250}, {"shot": "04-things-to-use"},
  {"eval": "__DQ.turn(1)"}, {"wait": 200}, {"shot": "05-seeds"},
  {"eval": "__DQ.show('key')"}, {"wait": 250}, {"shot": "06-important-things"},
  {"eval": "__DQ.show('weapon')"}, {"wait": 250}, {"shot": "07-weapons"},
  {"eval": "__DQ.turn(1)"}, {"wait": 200}, {"shot": "08-weapons-p2"},
  {"eval": "__DQ.show('armour')"}, {"wait": 250}, {"shot": "09-armour"},
  {"eval": "__DQ.show('guard')"}, {"wait": 250}, {"shot": "10-shields-and-helms"},
  {"eval": "__DQ.show('accessory')"}, {"wait": 250}, {"shot": "11-trinkets"},
  {"eval": "JSON.stringify(__DQ.item('larksteel_sword'))"},
  {"eval": "JSON.stringify(__DQ.item('herb'))"},
  {"key": "ArrowDown"}, {"wait": 200}, {"key": "ArrowRight"}, {"wait": 200}, {"shot": "12-keyboard"},
  {"assert": "__DQ.errors.length===0", "msg": "no runtime errors"},
  {"assert": "__DQ.state().items.total>=60", "msg": "at least 60 items in the table"},
  {"assert": "__DQ.itemAudit().missingWords.length===0", "msg": "every item has a description and a where"},
  {"assert": "__DQ.itemAudit().duplicateIds.length===0", "msg": "no duplicate item ids"},
  {"assert": "__DQ.fit().windowsOffScreen.length===0", "msg": "no window runs off the screen"},
  {"assert": "__DQ.fit().clippedCells.length===0", "msg": "no item's words are clipped"},
  {"assert": "__DQ.fit().rowsFit===true", "msg": "the rows fit inside the sheet"}
]}
