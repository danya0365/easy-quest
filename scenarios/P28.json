{ "name": "P28 sound effects + mixer", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 30000},
  {"wait": 600},
  {"shot": "board"},
  {"eval": "__DQ.unlock()"},
  {"press": "ArrowDown", "times": 3, "delay": 140},
  {"press": "Enter"},
  {"wait": 120},
  {"note": "the real P27 score on THIS mixer's music bus, then a scripted fight over it"},
  {"eval": "__DQ.music('battle')"},
  {"wait": 1500},
  {"assert": "__DQ.state().musicEngine && __DQ.state().musicEngine.theme === 'battle'", "msg": "battle theme is playing through the mixer"},
  {"eval": "__DQ.select('sword_hit')"},
  {"eval": "__DQ.play('sword_hit')"},
  {"wait": 50},
  {"shot": "sword-hit-dips-music"},
  {"wait": 700},
  {"eval": "__DQ.dipProbe('sword_hit').then((r) => (window.__dip = r))"},
  {"assert": "window.__dip && __dip.minDip <= 0.6 && __dip.recovered > 0.95", "msg": "a hit dips the live music bus (about -6 dB for 150 ms) and recovers by itself"},
  {"eval": "__DQ.fight()"},
  {"wait": 2000},
  {"shot": "fight-crit"},
  {"wait": 6500},
  {"eval": "__DQ.ambience('amb_meadow')"},
  {"eval": "__DQ.talk('bobble')"},
  {"wait": 400},
  {"assert": "__DQ.state().audio.ducks.music < 0.6", "msg": "dialogue ducks the music"},
  {"shot": "talk-meadow"},
  {"assert": "__DQ.state().sfx.bed && __DQ.state().sfx.bed.segments >= 1 && __DQ.state().sfx.bed.scheduledAhead > 0", "msg": "the meadow bed is playing as a chain of crossfaded variants"},
  {"press": "Escape"},
  {"wait": 700},
  {"assert": "__DQ.state().audio.ducks.music === 1", "msg": "Esc mid-line releases the dialogue duck"},
  {"eval": "__DQ.play('level_up_sparkle')"},
  {"wait": 400},
  {"shot": "levelup"},
  {"eval": "__DQ.music('')"},
  {"eval": "__DQ.state()"},
  {"eval": "__DQ.selfTest()"},
  {"assert": "__DQ.selfTestResult() && __DQ.selfTestResult().ok", "msg": "every effect renders: audible, not clipping, no NaN, one-shots end, loops seamless"},
  {"eval": "__DQ.hitCheck()"},
  {"assert": "__DQ.hitCheckResult() && __DQ.hitCheckResult().ok", "msg": "every impact is >= 6 dB over the battle theme with lows cut, and lifts the true mix by >= 6 dB"},
  {"assert": "__DQ.list().length >= 50", "msg": "full library present"},
  {"assert": "__DQ.state().audio.ctxState === 'running'", "msg": "audio context unlocked"},
  {"assert": "__DQ.state().sfx.played > 0", "msg": "live playback happened"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"}
]}
