{ "name": "P28 sound effects + mixer", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 30000},
  {"wait": 600},
  {"shot": "board"},
  {"eval": "__DQ.unlock()"},
  {"press": "ArrowDown", "times": 3, "delay": 140},
  {"press": "Enter"},
  {"wait": 120},
  {"eval": "__DQ.play('sword_crit')"},
  {"wait": 150},
  {"shot": "crit-scope"},
  {"eval": "__DQ.ambience('amb_meadow')"},
  {"eval": "__DQ.talk('bobble')"},
  {"wait": 900},
  {"shot": "talk-meadow"},
  {"eval": "__DQ.play('level_up_sparkle')"},
  {"wait": 400},
  {"shot": "levelup"},
  {"eval": "__DQ.state()"},
  {"eval": "__DQ.selfTest()"},
  {"assert": "__DQ.selfTestResult() && __DQ.selfTestResult().ok", "msg": "every effect renders: audible, not clipping, no NaN, one-shots end, loops seamless"},
  {"assert": "__DQ.list().length >= 50", "msg": "full library present"},
  {"assert": "__DQ.state().audio.ctxState === 'running'", "msg": "audio context unlocked"},
  {"assert": "__DQ.state().sfx.played > 0", "msg": "live playback happened"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"}
]}
