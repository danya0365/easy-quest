{ "name": "critic P21 — seed, equip on a mage, and a shop counter", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 40000},
  {"wait": 1800},
  {"eval": "JSON.stringify(__DQ.give('seed_of_life', 3))"},
  {"eval": "JSON.stringify(__DQ.gold ? __DQ.gold(9000) : 'no gold hook')"},
  {"eval": "const F=(await import('/src/battle/formulas.js')); const G=(await import('/src/data/growth.js')); const R=(await import('/src/battle/scene.js')).Roster; window.__mx=()=>{const m=R.party[0]; const s=G.statsFor(m); return {name:m.name,hp:m.hp,maxHp:s.hp,might:s.might};}; JSON.stringify(__mx())"},
  {"eval": "__DQ.menuOpen()"}, {"wait": 500},
  {"eval": "__DQ.menuPick('items')"}, {"wait": 600},
  {"eval": "__DQ.menuChoose('m-whose','bag')"}, {"wait": 600},
  {"eval": "__DQ.menuChoose('m-bag','seed_of_life')"}, {"wait": 600},
  {"eval": "__DQ.menuChoose('m-do','use')"}, {"wait": 1200}, {"shot": "20-seed-used"},
  {"eval": "JSON.stringify(__mx())"},
  {"eval": "JSON.stringify(__DQ.state().menu.bag)"},
  {"eval": "JSON.stringify(__DQ.menuWindows())"},
  {"eval": "__DQ.menuOpen(false)"}, {"wait": 500},
  {"note": "what can a mage put in her shield and hat slots?"},
  {"eval": "const I=await import('/src/data/items.js'); JSON.stringify({willowShields:I.equipOptions('willow','shield').map(r=>r.name),willowHelms:I.equipOptions('willow','helm').map(r=>r.name),seraWeapons:I.equipOptions('sera','weapon').map(r=>r.name)})"},
  {"note": "a real shop counter"},
  {"eval": "JSON.stringify(__DQ.shop())"},
  {"eval": "JSON.stringify(__DQ.shop('puddlewick_shop'))"}, {"wait": 1400}, {"shot": "21-shop-open"},
  {"eval": "JSON.stringify(__DQ.state().shop)"},
  {"eval": "await __DQ.shopPick('buy')"}, {"wait": 1200}, {"shot": "22-shop-buy-list"},
  {"eval": "JSON.stringify(__DQ.state().shop)"},
  {"eval": "JSON.stringify(__DQ.economyAudit ? __DQ.economyAudit() : 'none')"},
  {"eval": "await __DQ.shopPick('copper_sword')"}, {"wait": 1200}, {"shot": "23-shop-compare"},
  {"eval": "JSON.stringify(__DQ.state().shop)"},
  {"eval": "await __DQ.shopBack(3)"}, {"wait": 800},
  {"eval": "__DQ.shopClose()"}, {"wait": 600},
  {"eval": "JSON.stringify(__DQ.shop('puddlewick_hats'))"}, {"wait": 1400},
  {"eval": "await __DQ.shopPick('buy')"}, {"wait": 1200}, {"shot": "24-hats-shop"},
  {"eval": "JSON.stringify(__DQ.state().shop)"},
  {"eval": "__DQ.shopClose()"}, {"wait": 500},
  {"assert": "__DQ.errors.length===0", "msg": "no runtime errors in the running game"}
]}
