{ "name": "Vertical slice — Puddlewick Vale: boot, walk, orbit, signpost dialogue", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 40000},
  {"wait": 1500},

  {"note": "1. boot straight into the meadow"},
  {"assert": "__DQ.errors.length === 0", "msg": "boots with no runtime errors"},
  {"assert": "__DQ.state().scene === 'field' && __DQ.state().map && __DQ.state().map.id === 'meadow'", "msg": "boots into the field on the meadow map"},
  {"assert": "__DQ.listMaps().includes('meadow') && __DQ.state().player && Number.isFinite(__DQ.state().player.x)", "msg": "state() reports map and player position"},
  {"assert": "__DQ.state().dialogue === null", "msg": "no dialogue at boot"},
  {"eval": "window.__slice = {start: __DQ.state().player}"},
  {"shot": "opening"},

  {"note": "2. walk all four directions with the real keyboard (camera-relative)"},
  {"eval": "__DQ.cameraAuto(false)"},
  {"key": "ArrowUp", "hold": 900},
  {"wait": 250},
  {"shot": "walked-north"},
  {"eval": "window.__slice.n = __DQ.state().player"},
  {"assert": "window.__slice.n.z < window.__slice.start.z - 1.5", "msg": "up walks away from the camera (north)"},
  {"key": "ArrowRight", "hold": 800},
  {"wait": 250},
  {"shot": "walked-east"},
  {"eval": "window.__slice.e = __DQ.state().player"},
  {"assert": "window.__slice.e.x > window.__slice.n.x + 1.5", "msg": "right walks east"},
  {"key": "ArrowDown", "hold": 800},
  {"wait": 250},
  {"shot": "walked-south-facing-camera"},
  {"eval": "window.__slice.s = __DQ.state().player"},
  {"assert": "window.__slice.s.z > window.__slice.e.z + 1.5", "msg": "down walks toward the camera (south)"},
  {"key": "ArrowLeft", "hold": 800},
  {"wait": 250},
  {"shot": "walked-west"},
  {"eval": "window.__slice.w = __DQ.state().player"},
  {"assert": "window.__slice.w.x < window.__slice.s.x - 1.5", "msg": "left walks west"},
  {"eval": "__DQ.hold('run', 700)"},
  {"key": "ArrowUp", "hold": 700},
  {"wait": 100},
  {"shot": "running"},

  {"note": "3. orbit the camera: real look keys (E), then the debug accessor"},
  {"key": "KeyE", "hold": 900},
  {"wait": 700},
  {"shot": "orbit-look-keys"},
  {"assert": "Math.abs(__DQ.state().field.camera.orbit - 4) > 40", "msg": "look keys orbit the camera"},
  {"eval": "__DQ.cameraOrbit(150)"},
  {"wait": 1200},
  {"shot": "orbit-150"},
  {"assert": "Math.abs(__DQ.state().field.camera.current - 150) < 3", "msg": "cameraOrbit springs to the requested angle"},

  {"note": "4. walk to the signpost"},
  {"eval": "__DQ.teleport('meadow', 0.9, 16.5)"},
  {"eval": "__DQ.cameraOrbit(0)"},
  {"wait": 900},
  {"key": "ArrowUp", "hold": 1200},
  {"key": "ArrowRight", "hold": 420},
  {"wait": 400},
  {"eval": "__DQ.state().player"},
  {"assert": "__DQ.state().player.near && __DQ.state().player.near.name === 'signpost'", "msg": "the hero has walked up to the signpost"},
  {"assert": "__DQ.state().field.prompt === true", "msg": "a talk prompt floats over the sign"},
  {"shot": "at-the-sign"},

  {"note": "5. confirm opens a real F4 dialogue that types the sign's words"},
  {"press": "Enter", "delay": 450},
  {"shot": "dialogue-typing"},
  {"assert": "__DQ.state().scene === 'dialogue' && __DQ.state().dialogue && __DQ.state().dialogue.open", "msg": "dialogue scene is open"},
  {"assert": "__DQ.state().dialogue.typing === true", "msg": "the words type out (not instant)"},
  {"waitFor": "__DQ.state().dialogue && __DQ.state().dialogue.waitingForConfirm", "timeout": 8000},
  {"wait": 300},
  {"shot": "dialogue-page1"},
  {"assert": "/Puddlewick/.test(__DQ.state().dialogue.text) && __DQ.state().dialogue.pages === 3", "msg": "page 1 typed out, three pages, waits for confirm"},
  {"press": "Enter", "delay": 200},
  {"waitFor": "__DQ.state().dialogue && __DQ.state().dialogue.waitingForConfirm", "timeout": 8000},
  {"wait": 300},
  {"shot": "dialogue-page2"},
  {"assert": "/Saltmarrow/.test(__DQ.state().dialogue.text) && __DQ.state().dialogue.page === 2", "msg": "confirm turns to page 2"},

  {"note": "6. orbit again, with the dialogue up"},
  {"key": "KeyQ", "hold": 700},
  {"wait": 600},
  {"shot": "dialogue-orbit"},
  {"press": "Enter", "delay": 200},
  {"waitFor": "__DQ.state().dialogue && __DQ.state().dialogue.waitingForConfirm", "timeout": 8000},
  {"wait": 300},
  {"shot": "dialogue-page3"},
  {"assert": "/dragon/.test(__DQ.state().dialogue.text) && __DQ.state().dialogue.page === 3", "msg": "page 3: the carved dragon"},
  {"press": "Enter", "delay": 600},
  {"waitFor": "__DQ.state().scene === 'field' && __DQ.state().dialogue === null", "timeout": 4000},
  {"assert": "__DQ.state().scene === 'field' && __DQ.state().dialogue === null", "msg": "the last confirm closes the dialogue back to the field"},
  {"assert": "__DQ.state().player.anim.nodding === true || __DQ.state().field.lastTalk.name === 'signpost'", "msg": "Bram nods after reading the sign"},
  {"eval": "__DQ.cameraOrbit(35)"},
  {"wait": 1200},
  {"shot": "after-dialogue-orbit"},

  {"note": "7. the debug API is honest: freeze + advance replay deterministically, bad maps say so, goto works"},
  {"eval": "(() => { __DQ.freeze(true); const run = () => { __DQ.cameraOrbit(0); __DQ.teleport('meadow', 1.4, 19.2); __DQ.hold('up', 700); __DQ.hold('right', 400); __DQ.advance(1200); return __DQ.state().player; }; const a = run(), b = run(); __DQ.freeze(false); window.__det = {a, b}; return [a.x, a.z, b.x, b.z]; })()"},
  {"assert": "window.__det.a.x === window.__det.b.x && window.__det.a.z === window.__det.b.z && window.__det.a.z < 19.2", "msg": "advance(ms) + injected holds replay identically and really move the hero"},
  {"assert": "__DQ.teleport('nowhere').ok === false && __DQ.goto('dialogue', {push: true, text: 'Hello.'}).ok === true && __DQ.state().dialogue.open", "msg": "teleport refuses unknown maps; goto pushes a dialogue"},
  {"wait": 900},
  {"press": "Enter", "delay": 700},
  {"assert": "__DQ.state().scene === 'field' && __DQ.state().dialogue === null", "msg": "confirm closes the goto'd dialogue"},
  {"eval": "__DQ.cameraOrbit(4)"},
  {"wait": 1200},

  {"note": "8. the vale is closed by woodland on every side (real outlined oaks in front, painted treetops behind)"},
  {"eval": "__DQ.teleport('meadow', 30, 2)"},
  {"eval": "__DQ.cameraOrbit(270)"},
  {"wait": 1400},
  {"press": "Enter", "delay": 300},
  {"press": "Enter", "delay": 300},
  {"press": "Enter", "delay": 900},
  {"eval": "__DQ.state().field.view.counts"},
  {"assert": "__DQ.state().field.view.counts.forestTrees > 40 && __DQ.state().field.view.counts.forestCards > 200", "msg": "a woodland ring several rows deep surrounds the meadow"},
  {"shot": "east-lane-into-the-woods"},

  {"note": "9. the camera never zooms into trees: it keeps its distance and trees in the way dissolve"},
  {"eval": "__DQ.teleport('meadow', 10.1, 13.5)"},
  {"eval": "__DQ.cameraOrbit(4)"},
  {"wait": 1200},
  {"eval": "(() => { window.__cam = {min: 99, fade: 0}; window.__camT = setInterval(() => { const c = __DQ.state().field.camera; window.__cam.min = Math.min(window.__cam.min, c.dist); window.__cam.fade = Math.max(window.__cam.fade, c.seeThrough.fading); }, 50); return true; })()"},
  {"key": "ArrowDown", "hold": 1000},
  {"shot": "walking-past-a-tree"},
  {"eval": "__DQ.hold('run', 1100)"},
  {"key": "ArrowRight", "hold": 1100},
  {"wait": 900},
  {"eval": "(() => { clearInterval(window.__camT); return window.__cam; })()"},
  {"assert": "window.__cam.min > 10.4", "msg": "camera distance never collapses near trees"},
  {"assert": "window.__cam.fade > 0", "msg": "trees between the lens and the hero dissolve instead"},

  {"note": "10. a quick tap turns the hero in place (line up with a sign or a sheep)"},
  {"eval": "__DQ.teleport('meadow', 1.4, 19.2)"},
  {"eval": "__DQ.cameraOrbit(0)"},
  {"eval": "__DQ.face(180)"},
  {"wait": 900},
  {"eval": "(() => { window.__tap = __DQ.state().player; return window.__tap; })()"},
  {"press": "ArrowDown", "delay": 50},
  {"wait": 700},
  {"assert": "Math.abs(((__DQ.state().player.facing) + 540) % 360 - 180) < 8", "msg": "a Down tap turns all the way round to face the camera"},
  {"assert": "Math.hypot(__DQ.state().player.x - window.__tap.x, __DQ.state().player.z - window.__tap.z) < 0.2", "msg": "...without taking a step"},

  {"note": "11. the Menu button opens the command window in the field; Cancel backs out"},
  {"press": "Tab", "delay": 60},
  {"wait": 700},
  {"assert": "__DQ.state().scene === 'menu' && __DQ.state().menu.open && __DQ.state().menu.windows.includes('fieldcmd')", "msg": "Tab opens the command window"},
  {"shot": "field-menu"},
  {"press": "Escape", "delay": 60},
  {"wait": 700},
  {"assert": "__DQ.state().scene === 'field' && !__DQ.state().menu.open", "msg": "Cancel closes it"},
  {"eval": "__DQ.goto('dialogue', {push: true, text: ['One.', 'Two.']})"},
  {"wait": 700},
  {"press": "Escape", "delay": 200},
  {"wait": 500},
  {"assert": "__DQ.state().dialogue && __DQ.state().dialogue.page === 2", "msg": "Cancel turns a message page too"},
  {"press": "Escape", "delay": 900},
  {"assert": "__DQ.state().dialogue === null", "msg": "...and closes the last one"},
  {"eval": "__DQ.cameraOrbit(4)"},
  {"wait": 1200},

  {"note": "12. health"},
  {"eval": "__DQ.budget()"},
  {"eval": "__DQ.state().field"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"},
  {"assert": "__DQ.state().fps >= 55", "msg": "fps >= 55"},
  {"assert": "__DQ.budget().calls < 400 && __DQ.budget().tris < 150000", "msg": "within draw-call / triangle budget"},
  {"assert": "__DQ.screenshotReady() === true", "msg": "screenshotReady"}
]}
