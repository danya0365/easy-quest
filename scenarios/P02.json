{ "name": "P02 + P03 — sky, skyline, terrain, water, day-night and weather", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 40000},
  {"wait": 1400},
  {"note": "1. the gameplay view: painterly grass, a worn lane with cart ruts, a cobbled green, a real woodland rim, hills beyond"},
  {"shot": "01-field-day"},
  {"eval": "JSON.stringify(__DQ.state().demo)"},
  {"assert": "__DQ.state().demo.buildMs < 6000", "msg": "the vale builds in under 6 s"},
  {"assert": "__DQ.ground(0,0).cobble > 0.9 && __DQ.ground(4.5,19).path > 0.5 && __DQ.ground(24.5,-27).water > 0.5", "msg": "masks: cobbled green, worn lane, water"},
  {"assert": "__DQ.state().demo.trees.forestCards > 60", "msg": "the demo is judged behind the SAME wall of wood the real vale has"},

  {"note": "2. the world beyond: three landscape layers fading into aerial blue, and the sky over them"},
  {"eval": "__DQ.view('vista')"}, {"wait": 900}, {"shot": "02-vista"},
  {"eval": "__DQ.view('hills')"}, {"wait": 900}, {"shot": "03-hill-layers"},
  {"eval": "__DQ.view('sky')"}, {"wait": 900}, {"shot": "04-sky-clouds"},

  {"note": "2b. THE SKYLINE. Not 'is the card on screen' — is any of it NOT BEHIND A TREE. landmarkScreen fires"},
  {"note": "    a 16x10 grid of rays at the live scene inside each place's own painted rect; hiddenPct is the answer."},
  {"eval": "JSON.stringify(__DQ.landmarks())"},
  {"eval": "JSON.stringify(__DQ.skyline(-100, 260, 20))"},
  {"eval": "__DQ.view('coddleston')"}, {"wait": 1000}, {"shot": "02b-coddleston-castle"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l => l.id === 'coddleston'))"},
  {"assert": "(function(l){return l.onScreen && !l.clipped && l.visible && l.hiddenPct < 45 && l.visiblePx > 24})(__DQ.landmarkScreen().find(l => l.id === 'coddleston'))", "msg": "Coddleston Castle is REALLY visible from the lane, not just on screen"},
  {"eval": "__DQ.view('saltmarrow')"}, {"wait": 1000}, {"shot": "02c-saltmarrow-sea"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l => l.id === 'saltmarrow'))"},
  {"assert": "(function(l){return l.onScreen && !l.clipped && l.visible})(__DQ.landmarkScreen().find(l => l.id === 'saltmarrow'))", "msg": "Saltmarrow is REALLY visible down the Beck lane"},
  {"eval": "__DQ.view('puddlewick')"}, {"wait": 1000}, {"shot": "02d-puddlewick"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l => l.id === 'puddlewick'))"},
  {"assert": "(function(l){return l.onScreen && !l.clipped && l.visible})(__DQ.landmarkScreen().find(l => l.id === 'puddlewick'))", "msg": "Puddlewick is REALLY visible up the village lane"},
  {"eval": "__DQ.view('wood')"}, {"wait": 1000}, {"shot": "02e-whispering-wood"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l => l.id === 'whispering_wood'))"},
  {"assert": "__DQ.landmarks().length >= 4", "msg": "four places stand on the skyline, one down each signposted bearing"},
  {"assert": "__DQ.landmarkScreen().filter(l => l.onScreen && l.clipped).length === 0", "msg": "nothing on the skyline is cut off by the top of the frame"},

  {"note": "2f. WHAT THE PASSES ARE WORTH: close the painted treetops back over the lane mouths and measure again."},
  {"note": "    This is the change P02 is asking P23 for in the real map's WOOD_ROWS (mouth on the card rows)."},
  {"eval": "__DQ.view('coddleston')"}, {"wait": 800},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l => l.id === 'coddleston'))"},
  {"eval": "__DQ.mouths(false)"}, {"wait": 1000}, {"shot": "02f-mouths-shut"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l => l.id === 'coddleston'))"},
  {"eval": "__DQ.mouths(true)"}, {"wait": 1000}, {"shot": "02g-mouths-open"},
  {"assert": "__DQ.state().demo.mouths === true", "msg": "the passes are open again"},

  {"note": "3. the clouds really CROSS the sky: the drift phase is integrated, and __DQ.cloudDrift(n) scales it linearly"},
  {"eval": "JSON.stringify(__DQ.cloudDrift())"},
  {"eval": "window.__p0 = __DQ.cloudDrift().phaseRad"}, {"wait": 2000},
  {"eval": "JSON.stringify({p0: window.__p0, p1: __DQ.cloudDrift().phaseRad})"},
  {"assert": "__DQ.cloudDrift().phaseRad > window.__p0 + 0.004", "msg": "the cloud flock has really travelled in 2 s"},
  {"eval": "__DQ.cloudDrift(90)"}, {"burst": {"name": "cloud-drift", "count": 4, "interval": 700}},
  {"eval": "JSON.stringify(__DQ.cloudDrift())"},
  {"assert": "__DQ.cloudDrift().degPerMin > 900", "msg": "cloudDrift(90) really is 90x the gentle rate"},
  {"eval": "__DQ.cloudDrift(1)"},
  {"assert": "Math.abs(__DQ.cloudDrift().degPerMin - 14.4) < 1.5", "msg": "the gentle rate is about 14 degrees a minute"},
  {"assert": "__DQ.cloudDrift().cards >= 28", "msg": "a sky full of separate cumulus cards, each on its own drift"},

  {"note": "4. the sun: a disc with a glow, and the aerial haze under it"},
  {"eval": "__DQ.view('sun')"}, {"wait": 900}, {"shot": "05-sun-disc"},

  {"note": "5. the hours: midday, late afternoon, dusk, night, and dawn"},
  {"eval": "__DQ.view('vista')"}, {"eval": "__DQ.timeOfDay(12)"}, {"wait": 700}, {"shot": "06-noon"},
  {"eval": "__DQ.timeOfDay(17.6)"}, {"wait": 700}, {"shot": "07-late-afternoon"},
  {"eval": "__DQ.timeOfDay(18.6)"}, {"wait": 700}, {"shot": "08-dusk"},
  {"eval": "__DQ.view('sunset')"}, {"wait": 700}, {"shot": "09-dusk-sun"},
  {"eval": "__DQ.timeOfDay(22)"}, {"eval": "__DQ.view('moon')"}, {"wait": 900}, {"shot": "10-night-moon"},
  {"eval": "__DQ.view('sky')"}, {"wait": 700}, {"shot": "11-night-stars"},
  {"eval": "__DQ.view('field')"}, {"wait": 700}, {"shot": "12-night-field"},

  {"note": "5b. the night MOVES: the moon crosses and the stars turn, so 21:30 and 03:00 are not the same sky"},
  {"eval": "__DQ.view('moon')"}, {"eval": "__DQ.timeOfDay(21.5)"}, {"wait": 800}, {"shot": "12b-night-2130"},
  {"eval": "JSON.stringify(__DQ.state().demo.sky.moonDir)"},
  {"eval": "__DQ.timeOfDay(3)"}, {"wait": 800}, {"shot": "12c-night-0300"},
  {"eval": "JSON.stringify(__DQ.state().demo.sky.moonDir)"},
  {"assert": "__DQ.state().demo.sky.skyTurn === 45", "msg": "the star field has turned with the hours"},

  {"eval": "__DQ.timeOfDay(6.6)"}, {"eval": "__DQ.view('vista')"}, {"wait": 900}, {"shot": "13-dawn"},
  {"assert": "__DQ.state().demo.sky.weights.night > 0.3 && __DQ.state().demo.sky.twilight > 0.7", "msg": "dawn is half night, and full twilight"},
  {"assert": "__DQ.state().demo.sky.dawn > 0.8", "msg": "dawn has rose in it, not just an un-warm dusk"},
  {"eval": "__DQ.timeOfDay(9)"}, {"wait": 700},

  {"note": "5c. the SUN travels: it climbs out of the east, stands highest at noon, and sinks west"},
  {"eval": "__DQ.view('sun')"}, {"eval": "__DQ.timeOfDay(8)"}, {"wait": 700}, {"shot": "13b-sun-at-eight"},
  {"eval": "JSON.stringify([__DQ.state().demo.sky.sunEl, __DQ.state().demo.sky.sunAz])"},
  {"eval": "__DQ.timeOfDay(12)"}, {"wait": 700}, {"shot": "13c-sun-at-noon"},
  {"assert": "__DQ.state().demo.sky.sunEl > 45.5", "msg": "noon is the top of the arc (the tuned day light)"},
  {"eval": "__DQ.timeOfDay(16)"}, {"wait": 700}, {"shot": "13d-sun-at-four"},
  {"assert": "__DQ.state().demo.sky.sunEl < 33", "msg": "by four o'clock the sun has come down again"},
  {"eval": "__DQ.timeOfDay(9)"}, {"eval": "__DQ.view('vista')"}, {"wait": 700},

  {"note": "6. gentle weather: cloudy, rain (wet lanes, puddles, rings on the water), snow (a dusting)"},
  {"eval": "__DQ.weather('cloudy', {instant: true})"}, {"wait": 900}, {"shot": "14-cloudy"},
  {"eval": "__DQ.weather('rain', {instant: true})"}, {"wait": 1400}, {"shot": "15-rain"},
  {"eval": "__DQ.view('water')"}, {"wait": 900}, {"shot": "16-rain-on-the-water"},
  {"eval": "__DQ.view('lane')"}, {"wait": 700}, {"shot": "17-wet-lane"},
  {"assert": "__DQ.state().demo.sky.weather.wet > 0.9 && __DQ.state().demo.sky.particles.length === 1", "msg": "rain falls and the ground is wet"},
  {"eval": "__DQ.weather('snow', {instant: true})"}, {"wait": 1600}, {"eval": "__DQ.view('field')"}, {"wait": 700}, {"shot": "18-snow"},
  {"eval": "__DQ.view('green')"}, {"wait": 700}, {"shot": "19-snow-on-the-green"},
  {"eval": "__DQ.weather('clear', {instant: true})"}, {"wait": 1200},

  {"note": "7. the ground close up: the cobbled green, the lane's worn edge, the map read"},
  {"eval": "__DQ.view('green')"}, {"wait": 800}, {"shot": "20-cobbled-green"},
  {"eval": "__DQ.view('lane')"}, {"wait": 800}, {"shot": "21-lane-edge"},

  {"note": "7b. THE WATER: a surface with a moving normal, the sky and the bank in it, a broken glitter path,"},
  {"note": "     light on the bed — and a hero who WADES, with rings round him and a splash where he stepped in."},
  {"eval": "__DQ.view('water')"}, {"wait": 900}, {"shot": "22-water-edge"},
  {"eval": "JSON.stringify(__DQ.hero(0, -21))"},
  {"assert": "__DQ.hero(0,-21).inWater === true", "msg": "the hero is standing in the Beck"},
  {"eval": "__DQ.view('wading')"}, {"wait": 1600}, {"shot": "22a-wading"},
  {"burst": {"name": "22b-ripples", "count": 4, "interval": 420}},
  {"eval": "__DQ.hero(4.5, 19)"}, {"wait": 800},
  {"eval": "__DQ.view('beck')"}, {"wait": 900}, {"shot": "22c-beck"},
  {"note": "7c. the same water at dusk and at night: the sky lies in it and the glitter path moves with the hour"},
  {"eval": "__DQ.view('water')"}, {"eval": "__DQ.timeOfDay(18.6)"}, {"wait": 900}, {"shot": "22d-water-at-dusk"},
  {"eval": "__DQ.timeOfDay(22)"}, {"wait": 900}, {"shot": "22e-water-at-night"},
  {"eval": "__DQ.timeOfDay(9)"}, {"wait": 700},
  {"eval": "__DQ.view('high')"}, {"wait": 900}, {"shot": "23-high-read"},
  {"eval": "__DQ.view('field')"}, {"wait": 800}, {"shot": "24-field-again"},

  {"note": "8. health"},
  {"eval": "JSON.stringify(__DQ.budget())"},
  {"eval": "JSON.stringify(__DQ.state().demo.sky)"},
  {"eval": "JSON.stringify(__DQ.state().fps)"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"},
  {"assert": "__DQ.state().fps >= 55", "msg": "fps >= 55"},
  {"assert": "__DQ.budget().calls < 400", "msg": "within the draw-call budget"}
]}
