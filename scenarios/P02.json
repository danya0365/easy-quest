{ "name": "P02 + P03 — sky, terrain, day-night and weather", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 40000},
  {"wait": 1200},
  {"note": "1. the gameplay view: painterly grass, a worn lane with cart ruts, a cobbled green, hills beyond"},
  {"shot": "01-field-day"},
  {"eval": "JSON.stringify(__DQ.state().demo)"},
  {"assert": "__DQ.state().demo.buildMs < 4000", "msg": "the vale builds in under 4 s"},
  {"assert": "__DQ.ground(0,0).cobble > 0.9 && __DQ.ground(4.5,19).path > 0.5 && __DQ.ground(24.5,-27).water > 0.5", "msg": "masks: cobbled green, worn lane, water"},

  {"note": "2. the world beyond: three landscape layers fading into aerial blue, and the sky over them"},
  {"eval": "__DQ.view('vista')"}, {"wait": 900}, {"shot": "02-vista"},
  {"eval": "__DQ.view('hills')"}, {"wait": 900}, {"shot": "03-hill-layers"},
  {"eval": "__DQ.view('sky')"}, {"wait": 900}, {"shot": "04-sky-clouds"},

  {"note": "2b. THE SKYLINE: four places you can see from the vale, each down the bearing its signpost points"},
  {"eval": "JSON.stringify(__DQ.landmarks())"},
  {"eval": "__DQ.view('coddleston')"}, {"wait": 900}, {"shot": "02b-coddleston-castle"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen())"},
  {"eval": "__DQ.view('saltmarrow')"}, {"wait": 900}, {"shot": "02c-saltmarrow-sea"},
  {"eval": "__DQ.view('puddlewick')"}, {"wait": 900}, {"shot": "02d-puddlewick"},
  {"eval": "__DQ.view('wood')"}, {"wait": 900}, {"shot": "02e-whispering-wood"},
  {"assert": "__DQ.landmarks().length >= 3", "msg": "at least three landmarks stand on the skyline"},
  {"assert": "__DQ.landmarkScreen().filter(l => l.onScreen).length >= 1", "msg": "a landmark is measurably on screen"},

  {"note": "3. the clouds really drift and billow (a time-lapse, so a still comparison can see it)"},
  {"eval": "__DQ.cloudDrift(90)"}, {"burst": {"name": "cloud-drift", "count": 4, "interval": 700}},
  {"eval": "__DQ.cloudDrift(1)"},
  {"assert": "__DQ.cloudDrift().cards >= 28", "msg": "a sky full of separate cumulus cards, each on its own drift"},

  {"note": "4. the sun: a disc with a glow, and the aerial haze under it"},
  {"eval": "__DQ.view('sun')"}, {"wait": 900}, {"shot": "05-sun-disc"},

  {"note": "5. the hours: midday, late afternoon, dusk, night, and dawn"},
  {"eval": "__DQ.view('vista')"}, {"eval": "__DQ.timeOfDay(12)"}, {"wait": 700}, {"shot": "06-noon"},
  {"eval": "__DQ.timeOfDay(17.6)"}, {"wait": 700}, {"shot": "07-late-afternoon"},
  {"eval": "__DQ.timeOfDay(18.6)"}, {"wait": 700}, {"shot": "08-dusk"},
  {"eval": "__DQ.view('sunset')"}, {"wait": 700}, {"shot": "09-dusk-sun"},
  {"eval": "__DQ.timeOfDay(22)"}, {"eval": "__DQ.view('moon')"}, {"wait": 900}, {"shot": "10-night-moon"},
  {"eval": "__DQ.view('sky')"}, {"wait": 700}, {"shot": "11-night-stars"},
  {"eval": "__DQ.view('field')"}, {"wait": 700}, {"shot": "12-night-field"},

  {"note": "5b. the night MOVES: the moon crosses and the stars turn, so 21:30 and 03:00 are not the same sky"},
  {"eval": "__DQ.view('moon')"}, {"eval": "__DQ.timeOfDay(21.5)"}, {"wait": 800}, {"shot": "12b-night-2130"},
  {"eval": "JSON.stringify(__DQ.state().demo.sky.moonDir)"},
  {"eval": "__DQ.timeOfDay(3)"}, {"wait": 800}, {"shot": "12c-night-0300"},
  {"eval": "JSON.stringify(__DQ.state().demo.sky.moonDir)"},
  {"assert": "__DQ.state().demo.sky.skyTurn === 45", "msg": "the star field has turned with the hours"},

  {"eval": "__DQ.timeOfDay(6.6)"}, {"eval": "__DQ.view('vista')"}, {"wait": 900}, {"shot": "13-dawn"},
  {"assert": "__DQ.state().demo.sky.weights.night > 0.3 && __DQ.state().demo.sky.twilight > 0.7", "msg": "dawn is half night, and full twilight"},
  {"assert": "__DQ.state().demo.sky.dawn > 0.8", "msg": "dawn has rose in it, not just an un-warm dusk"},
  {"eval": "__DQ.timeOfDay(9)"}, {"wait": 700},

  {"note": "6. gentle weather: cloudy, rain (wet lanes, puddles, rings on the water), snow (a dusting)"},
  {"eval": "__DQ.weather('cloudy', {instant: true})"}, {"wait": 900}, {"shot": "14-cloudy"},
  {"eval": "__DQ.weather('rain', {instant: true})"}, {"wait": 1400}, {"shot": "15-rain"},
  {"eval": "__DQ.view('water')"}, {"wait": 900}, {"shot": "16-rain-on-the-water"},
  {"eval": "__DQ.view('lane')"}, {"wait": 700}, {"shot": "17-wet-lane"},
  {"assert": "__DQ.state().demo.sky.weather.wet > 0.9 && __DQ.state().demo.sky.particles.length === 1", "msg": "rain falls and the ground is wet"},
  {"eval": "__DQ.weather('snow', {instant: true})"}, {"wait": 1600}, {"eval": "__DQ.view('field')"}, {"wait": 700}, {"shot": "18-snow"},
  {"eval": "__DQ.view('green')"}, {"wait": 700}, {"shot": "19-snow-on-the-green"},
  {"eval": "__DQ.weather('clear', {instant: true})"}, {"wait": 1200},

  {"note": "7. the ground close up: the cobbled green, the lane's worn edge, the water's edge, the map read"},
  {"eval": "__DQ.view('green')"}, {"wait": 800}, {"shot": "20-cobbled-green"},
  {"eval": "__DQ.view('lane')"}, {"wait": 800}, {"shot": "21-lane-edge"},
  {"eval": "__DQ.view('water')"}, {"wait": 800}, {"shot": "22-water-edge"},
  {"note": "7b. the same water edge at dusk and at night: the sky lies in it and the glitter path moves"},
  {"eval": "__DQ.timeOfDay(18.6)"}, {"wait": 800}, {"shot": "22b-water-at-dusk"},
  {"eval": "__DQ.timeOfDay(22)"}, {"wait": 800}, {"shot": "22c-water-at-night"},
  {"eval": "__DQ.timeOfDay(9)"}, {"wait": 700},
  {"eval": "__DQ.view('high')"}, {"wait": 900}, {"shot": "23-high-read"},
  {"eval": "__DQ.view('field')"}, {"wait": 800}, {"shot": "24-field-again"},

  {"note": "8. health"},
  {"eval": "JSON.stringify(__DQ.budget())"},
  {"eval": "JSON.stringify(__DQ.state().demo.sky)"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"},
  {"assert": "__DQ.state().fps >= 55", "msg": "fps >= 55"},
  {"assert": "__DQ.budget().calls < 400 && __DQ.budget().tris < 150000", "msg": "within the draw-call / triangle budget"}
]}
