  {
   "eval": "(async()=>{const m=await import('/src/world/maps/puddlewick.js');const L=m.puddlewickLayout();window.__L=L;window.__W={};window.__MEM=[];const sleep=ms=>new Promise(r=>setTimeout(r,ms));window.__sleep=sleep;window.__clear=async()=>{for(let i=0;i<10;i++){const d=__DQ.state().dialogue;if(!d||!d.open)break;__DQ.press('confirm');await sleep(260);}return !!(__DQ.state().dialogue&&__DQ.state().dialogue.open);};window.__walk=async(orbitDeg,chunks)=>{__DQ.cameraOrbit(orbitDeg,true);await sleep(420);const start=__DQ.state().map.id;for(let k=0;k<chunks;k++){await __clear();__DQ.hold('up');await sleep(480);__DQ.release('up');await sleep(560);if(__DQ.state().map.id!==start)break;}await sleep(500);return __DQ.state().map.id;};window.__enter=async(id)=>{const d=L.doors[id];if(__DQ.state().map.id!=='puddlewick'){await __DQ.teleport('puddlewick');await sleep(1100);}await __clear();__DQ.walkTo(d.x,d.z);await sleep(300);const p0=__DQ.state().player;const landed=await __walk(d.facing*180/Math.PI+180,5);const s=__DQ.state();const r=__DQ.state().render;window.__MEM.push({room:id,geo:r.geometries,tex:r.textures,prog:r.programs,calls:r.calls,tris:r.tris});return {door:id,askedFrom:[+d.x.toFixed(2),+d.z.toFixed(2)],from:[+p0.x.toFixed(2),+p0.z.toFixed(2)],landed:s.map.id,name:s.map.name,kind:s.map.kind,size:s.map.size,npcs:s.map.npcs,chests:s.map.chests,interactables:s.map.interactables,props:s.map.props,colliders:s.map.colliders,lines:s.map.lines,missingLines:s.map.missingLines,music:s.map.music,y:+s.player.y.toFixed(3),ground:s.player.ground,fps:s.fps};};window.__leave=async()=>{await __clear();const landed=await __walk(180,6);const s=__DQ.state();return {landed:s.map.id,name:s.map.name,at:[+s.player.x.toFixed(2),+s.player.z.toFixed(2)]};};return JSON.stringify({doors:Object.keys(L.doors).length,exits:L.exits.length});})()"
  },
