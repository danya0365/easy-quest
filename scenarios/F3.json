{ "name": "F3 art foundation — Puddlewick Sampler", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 30000},
  {"wait": 1200},
  {"assert": "__DQ.errors.length === 0", "msg": "boots with no runtime errors"},
  {"eval": "__DQ.freeze(true)"},
  {"eval": "__DQ.view('wide')"}, {"wait": 400}, {"shot": "wide"},
  {"eval": "__DQ.view('front')"}, {"wait": 300}, {"shot": "front"},
  {"eval": "__DQ.view('cottage')"}, {"wait": 300}, {"shot": "cottage"},
  {"eval": "__DQ.view('beds')"}, {"wait": 300}, {"shot": "beds-sand-snow"},
  {"eval": "__DQ.view('yard')"}, {"wait": 300}, {"shot": "yard-pond-cobble-brick"},
  {"eval": "__DQ.view('shed')"}, {"wait": 300}, {"shot": "shed-thatch"},
  {"eval": "__DQ.view('tree')"}, {"wait": 300}, {"shot": "tree-laundry"},
  {"eval": "__DQ.view('back')"}, {"wait": 300}, {"shot": "back"},
  {"eval": "__DQ.view('sun')"}, {"wait": 300}, {"shot": "toward-sun"},
  {"eval": "__DQ.view('high')"}, {"wait": 300}, {"shot": "high"},
  {"eval": "__DQ.view('wide')"}, {"eval": "__DQ.sheet(true)"}, {"wait": 500}, {"shot": "texture-sheet"},
  {"eval": "__DQ.sheet(false)"},
  {"eval": "__DQ.timeOfDay(18)"}, {"wait": 300}, {"shot": "dusk"},
  {"eval": "__DQ.timeOfDay(22)"}, {"wait": 300}, {"shot": "night"},
  {"eval": "__DQ.timeOfDay(12)"},
  {"eval": "__DQ.outline(false)"}, {"eval": "__DQ.view('tree')"}, {"wait": 300}, {"shot": "tree-no-outline"},
  {"eval": "__DQ.outline(true)"},
  {"note": "orbit: unfreeze and let the camera drift"},
  {"eval": "__DQ.view('wide')"}, {"eval": "__DQ.orbit(true, 6)"}, {"eval": "__DQ.freeze(false)"},
  {"burst": {"name": "orbit", "count": 3, "interval": 1500}},
  {"eval": "__DQ.state().art"},
  {"eval": "__DQ.budget()"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"},
  {"assert": "__DQ.state().fps >= 55", "msg": "fps >= 55"},
  {"assert": "__DQ.budget().calls < 400 && __DQ.budget().tris < 150000", "msg": "within draw-call / triangle budget (all passes)"},
  {"assert": "__DQ.texNames().length >= 20 && Object.values(__DQ.texInfo()).filter(v => v.built).length >= 16", "msg": "texture recipes built"},
  {"eval": "__DQ.seams()"},
  {"assert": "Object.values(__DQ.seams()).every(v => v.x <= 1.05 && v.y <= 1.05)", "msg": "every material texture tiles seamlessly (wrap jump <= largest interior jump)"},
  {"assert": "__DQ.screenshotReady() === true", "msg": "screenshotReady"}
]}
