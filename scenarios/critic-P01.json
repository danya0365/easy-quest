{
 "name": "critic P01 - cold boot of index.html, keyboard only, all the way into play and back through Carry On",
 "steps": [
  {"wait": 1200},
  {"note": "FIRST FRAME 1.2s after load, before __DQ.ready - what a child actually sees first"},
  {"shot": "00-first-frame-cold"},
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 60000},
  {"wait": 300},
  {"shot": "01-ready"},
  {"eval": "JSON.stringify({scene: __DQ.state().scene, phase: (__DQ.state().title||{}).phase, buildMs: (__DQ.state().title||{}).buildMs})"},
  {"note": "SOUND: the title asks for the title theme - measure whether anything is actually playing"},
  {"wait": 2500},
  {"eval": "JSON.stringify({wants: (__DQ.state().title||{}).music, theme: __DQ.state().audio.theme, ambience: __DQ.state().audio.ambience, sfxPlayed: __DQ.state().audio.sfx.played})"},
  {"note": "the attract sweep across its whole 6-leg cycle"},
  {"burst": {"name": "02-sweep", "count": 10, "interval": 2300}},
  {"eval": "JSON.stringify({leg: (__DQ.state().title||{}).leg, segs: (__DQ.state().title||{}).segs})"},
  {"press": "Enter"},
  {"wait": 1000},
  {"shot": "03-menu"},
  {"burst": {"name": "04-menu-open", "count": 4, "interval": 220}},
  {"press": "ArrowDown", "times": 1, "delay": 300},
  {"wait": 400},
  {"shot": "05-cursor-moved"},
  {"note": "SOUND: a cursor move and a menu open should both have made a noise by now"},
  {"eval": "JSON.stringify({sfxPlayed: __DQ.state().audio.sfx.played, last: __DQ.state().audio.sfx.last})"},
  {"press": "Escape"},
  {"wait": 700},
  {"eval": "JSON.stringify({phase: (__DQ.state().title||{}).phase, note: 'cancel must fall back to the sweep'})"},
  {"press": "Enter"},
  {"wait": 900},
  {"press": "Enter"},
  {"wait": 1400},
  {"note": "A New Tale -> the naming grid, cursor parked on Done"},
  {"shot": "06-naming-grid"},
  {"press": "Escape"},
  {"wait": 800},
  {"eval": "JSON.stringify({phase: (__DQ.state().title||{}).phase, note: 'the naming grid must be cancellable'})"},
  {"press": "Enter"},
  {"wait": 1400},
  {"note": "name the boy something nothing else in the game uses"},
  {"press": "ArrowLeft", "times": 1, "delay": 220},
  {"press": "Enter", "times": 6, "delay": 200},
  {"wait": 400},
  {"eval": "JSON.stringify({afterRubOut: (__DQ.state().title||{}).name})"},
  {"eval": "__DQ.titleName('Zigglesworth')"},
  {"wait": 400},
  {"shot": "07-named-zigglesw"},
  {"eval": "JSON.stringify({name: (__DQ.state().title||{}).name})"},
  {"press": "ArrowRight", "times": 1, "delay": 250},
  {"wait": 300},
  {"press": "Enter"},
  {"wait": 1800},
  {"eval": "JSON.stringify({phase: (__DQ.state().title||{}).phase, name: (__DQ.state().title||{}).name})"},
  {"note": "the storybook intro, one page at a time"},
  {"wait": 2200},
  {"shot": "08-intro-p1"},
  {"press": "Enter"}, {"wait": 2600}, {"shot": "09-intro-p2"},
  {"press": "Enter"}, {"wait": 2600}, {"shot": "10-intro-p3"},
  {"press": "Enter"}, {"wait": 2600}, {"shot": "11-intro-p4"},
  {"press": "Enter"}, {"wait": 2600}, {"shot": "12-intro-p5"},
  {"press": "Enter"}, {"wait": 2600}, {"shot": "13-intro-p6"},
  {"eval": "JSON.stringify({theme: __DQ.state().audio.theme, sfxPlayed: __DQ.state().audio.sfx.played})"},
  {"press": "Enter", "times": 8, "delay": 1000},
  {"wait": 3000},
  {"shot": "14-handoff-transition"},
  {"wait": 5000},
  {"note": "the hand-off into play"},
  {"shot": "15-in-play"},
  {"eval": "JSON.stringify({scene: __DQ.state().scene, map: __DQ.state().map && __DQ.state().map.id, party: (__DQ.state().party||[]).map(p=>p.name)})"},
  {"note": "DOES THE NAME THE CHILD TYPED REACH THE GAME"},
  {"eval": "JSON.stringify({heroInPlay: (__DQ.state().party||[])[0] && (__DQ.state().party||[])[0].name, titleName: (__DQ.state().title||{}).name})"},
  {"key": "ArrowUp", "hold": 1000},
  {"wait": 600},
  {"shot": "16-walking"},
  {"note": "back to the title, now with a save, and Carry On from the default selection"},
  {"eval": "__DQ.toTitle()"},
  {"wait": 4000},
  {"shot": "17-back-at-title"},
  {"eval": "JSON.stringify({hasSave: (__DQ.state().title||{}).hasSave, slots: (__DQ.state().title||{}).slots})"},
  {"press": "Enter"},
  {"wait": 1200},
  {"shot": "18-menu-with-a-save"},
  {"press": "Enter"},
  {"wait": 1600},
  {"shot": "19-carry-on-slots"},
  {"eval": "JSON.stringify({phase: (__DQ.state().title||{}).phase, widgets: (__DQ.state().title||{}).widgets})"},
  {"press": "Enter"},
  {"wait": 6000},
  {"shot": "20-carried-on"},
  {"eval": "JSON.stringify({scene: __DQ.state().scene, map: __DQ.state().map && __DQ.state().map.id, hero: (__DQ.state().party||[])[0] && (__DQ.state().party||[])[0].name})"},
  {"eval": "JSON.stringify({fps: __DQ.state().fps, errors: __DQ.errors.slice(0,8)})"},
  {"assert": "__DQ.state().scene==='field'", "msg": "Carry On lands back in the field"},
  {"assert": "__DQ.errors.length===0", "msg": "no runtime errors anywhere on the cold-boot path"},
  {"assert": "((__DQ.state().party||[])[0]||{}).name==='Zigglesw'", "msg": "GAP 2 - the name the child typed is the hero name in play"}
 ]
}
