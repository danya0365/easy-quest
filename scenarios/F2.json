{ "name": "F2 input", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 30000},
  {"wait": 700},
  {"note": "1. boot: overlay forced on, polling every fixed tick, press/hold/release wired to Input"},
  {"assert": "__DQ.state().input && __DQ.state().input.driver === 'tick'", "msg": "Input.update runs from App beforeUpdate every tick"},
  {"assert": "__DQ.state().input.touch.visible === true && document.querySelector('.dq-touch.is-visible .dq-tb-confirm') !== null", "msg": "touch overlay visible (forced on in the demo)"},
  {"assert": "!__DQ.state().stubs.includes('press') && !__DQ.state().stubs.includes('hold') && !__DQ.state().stubs.includes('release')", "msg": "__DQ.press/hold/release are implemented by Input"},
  {"assert": "__DQ.press('bogus').ok === false && __DQ.errors.length === 0", "msg": "unknown button is refused politely"},
  {"shot": "board"},

  {"note": "2. real keyboard through Playwright: quick taps latch, WASD walks"},
  {"eval": "__DQ.resetDemo()"},
  {"press": "ArrowDown", "times": 3, "delay": 160},
  {"wait": 120},
  {"assert": "__DQ.menuIndex() === 3", "msg": "three instant key taps = exactly three menu steps"},
  {"assert": "__DQ.state().input.counts.down.presses === 3 && __DQ.state().input.counts.down.repeats === 0", "msg": "no spurious repeats from taps"},
  {"key": "KeyD", "hold": 700},
  {"wait": 100},
  {"assert": "__DQ.state().demo.bobble.x > 0.8", "msg": "holding D walks Bobble to the right"},
  {"press": "Tab"},
  {"wait": 150},
  {"assert": "__DQ.state().scene === 'pause'", "msg": "Tab opens the menu scene via onInput"},
  {"shot": "paused-by-tab"},
  {"press": "Escape"},
  {"wait": 150},
  {"assert": "__DQ.state().scene === 'field'", "msg": "Escape closes it"},

  {"note": "3. live: W+D+Shift held -> diagonal run on the dial"},
  {"eval": "__DQ.resetDemo()"},
  {"eval": "(__DQ.key('KeyW', true), __DQ.key('KeyD', true), __DQ.key('ShiftLeft', true), true)"},
  {"wait": 450},
  {"assert": "(() => { const a = __DQ.state().input.axis; return Math.abs(a.x - 0.707) < 0.01 && Math.abs(a.y - 0.707) < 0.01 && a.source === 'keyboard'; })()", "msg": "8-way keys: diagonal is unit length"},
  {"assert": "__DQ.state().input.down.includes('run')", "msg": "Shift = run"},
  {"shot": "keys-diagonal-run"},
  {"eval": "(__DQ.key('KeyW', false), __DQ.key('KeyD', false), __DQ.key('ShiftLeft', false), true)"},

  {"note": "4. live: injected hold on down -> menu key repeat (timeline shows press, 300 ms gap, steady repeats)"},
  {"eval": "__DQ.resetDemo()"},
  {"eval": "__DQ.hold('down')"},
  {"waitFor": "__DQ.state().input.counts.down.repeats >= 5", "timeout": 5000},
  {"shot": "menu-repeat-held"},
  {"eval": "__DQ.release('down')"},
  {"wait": 120},
  {"assert": "__DQ.state().input.counts.down.presses === 1 && __DQ.state().input.counts.down.repeats >= 5", "msg": "one press then repeats while held"},

  {"note": "5. deterministic key-repeat timing"},
  {"eval": "(() => { window.__rep = __DQ.repeatTest(); return window.__rep; })()"},
  {"assert": "JSON.stringify(window.__rep.offsets) === '[0,18,24,30,36,42,48,54]'", "msg": "press at 0, first repeat at 300 ms (18 ticks), then every 100 ms (6 ticks)"},
  {"assert": "window.__rep.gapsLong[0] === 18 && window.__rep.gapsLong.slice(1, 10).every(g => g === 6) && window.__rep.gapsLong.slice(10).every(g => g === 4) && window.__rep.gapsLong.length > 12", "msg": "after 10 repeats it speeds up to 66 ms (4 ticks)"},

  {"note": "6. taps, diagonals, last-pressed-wins"},
  {"eval": "(() => { window.__tap = __DQ.tapTest(); return window.__tap; })()"},
  {"assert": "window.__tap.presses === 1 && window.__tap.sawPress && window.__tap.released && !window.__tap.downAfter", "msg": "keydown+keyup inside one tick still gives one press then one release"},
  {"eval": "(() => { window.__diag = __DQ.diagTest(); return window.__diag; })()"},
  {"assert": "Math.abs(window.__diag.diag.x - 0.707) < 0.01 && Math.abs(window.__diag.diag.y - 0.707) < 0.01", "msg": "W+D = (0.707, 0.707)"},
  {"assert": "window.__diag.socd.x < -0.7 && window.__diag.after.mag === 0", "msg": "pressing A while D is held: last pressed wins; all released -> zero"},

  {"note": "7. gamepad: dead zones, hysteresis, blur suppression"},
  {"eval": "(() => { window.__pad = __DQ.padTest(); return window.__pad; })()"},
  {"assert": "window.__pad.inDeadZone.mag === 0", "msg": "stick at 0.18 is inside the 0.2 radial dead zone"},
  {"assert": "Math.abs(window.__pad.partial.x - 0.533) < 0.01 && window.__pad.partial.source === 'gamepad'", "msg": "0.6 rescales to (0.6-0.2)/0.75 = 0.533"},
  {"assert": "window.__pad.diagFull.mag === 1 && window.__pad.diagDigital.up && window.__pad.diagDigital.right", "msg": "full diagonal = unit vector + up and right digital"},
  {"assert": "window.__pad.hysteresisHold.up === true", "msg": "digital direction holds through the hysteresis band"},
  {"assert": "window.__pad.confirm.pressed && window.__pad.confirm.device === 'gamepad'", "msg": "A = confirm"},
  {"assert": "!window.__pad.afterBlur.down && window.__pad.afterBlur.released && window.__pad.afterBlur.suppressed.includes('confirm')", "msg": "blur releases a held pad button"},
  {"assert": "!window.__pad.stillSuppressed.down && window.__pad.pressAgain", "msg": "...which must be let go before it presses again"},

  {"note": "8. blur releases keyboard + injected holds"},
  {"eval": "(() => { window.__blur = __DQ.blurTest(); return window.__blur; })()"},
  {"assert": "window.__blur.before.left && window.__blur.before.run && window.__blur.before.confirm", "msg": "held before blur"},
  {"assert": "!window.__blur.immediate.left && !window.__blur.immediate.run && !window.__blur.immediate.confirm", "msg": "down() is false the moment the window blurs"},
  {"assert": "window.__blur.edges.left && window.__blur.edges.run && window.__blur.edges.confirm && window.__blur.edges.axis === 0 && !window.__blur.anyDown", "msg": "released() fires next tick; axis zero"},

  {"note": "9. scene delivery + consume on stack change; block"},
  {"eval": "(() => { window.__cons = __DQ.consumeTest(); return window.__cons; })()"},
  {"assert": "window.__cons.spinOnField === 1 && window.__cons.paused === 'pause' && window.__cons.back === 'field'", "msg": "cancel spins on the field; menu pushes pause; cancel pops it"},
  {"assert": "window.__cons.spinWhenClosingPause === 0", "msg": "the cancel that closed the pause is consumed: the field does not also spin"},
  {"eval": "(() => { window.__lock = __DQ.repeatLockTest(); return window.__lock; })()"},
  {"assert": "window.__lock.heldRepeats > 0 && window.__lock.whilePaused === 0 && window.__lock.locked.includes('down') && window.__lock.stillLocked === 0 && window.__lock.afterRepress > 0", "msg": "a direction held while a menu opens does not scroll it; re-pressing repeats again"},
  {"eval": "(() => { window.__blk = __DQ.blockTest(); return window.__blk; })()"},
  {"assert": "!window.__blk.blocked.down && window.__blk.blocked.released && !window.__blk.afterUnblock.down && window.__blk.afterUnblock.suppressed.includes('confirm') && window.__blk.pressesAgain", "msg": "block releases; unblock waits for a real re-press"},

  {"note": "10. touch: floating stick + buttons through real pointer handlers"},
  {"eval": "(() => { window.__touch = __DQ.touchTest(); return window.__touch; })()"},
  {"assert": "window.__touch.small.source === 'touch' && window.__touch.small.mag > 0 && window.__touch.small.mag < 0.5", "msg": "small drag = gentle analog"},
  {"assert": "window.__touch.up.axis.y > 0.99 && window.__touch.up.up && window.__touch.up.run", "msg": "drag far up = full up + run"},
  {"assert": "window.__touch.released.mag === 0 && window.__touch.confirm.pressed && window.__touch.confirm.device === 'touch' && window.__touch.confirmUp", "msg": "lift = zero; OK button = confirm"},

  {"note": "11. live screenshots: virtual gamepad, then touch"},
  {"eval": "__DQ.resetDemo()"},
  {"eval": "__DQ.fakePad({axes:[-0.55, -0.45, 0.3, 0], buttons:[{pressed:true,value:1}, 0, 0, 0, 0, 0, 0, 0.8]})"},
  {"wait": 500},
  {"assert": "__DQ.state().input.gamepad.virtual && __DQ.state().input.down.includes('confirm') && __DQ.state().input.down.includes('run')", "msg": "virtual pad drives confirm + run (R2 analog 0.8)"},
  {"shot": "gamepad-virtual"},
  {"eval": "__DQ.fakePad(null)"},
  {"wait": 200},
  {"eval": "__DQ.resetDemo()"},
  {"eval": "(__DQ.touchStick('down'), __DQ.touchStick('move', 58, -34), __DQ.touchButton('confirm', true))"},
  {"wait": 400},
  {"assert": "__DQ.state().input.touch.stick.active && __DQ.state().input.axis.source === 'touch'", "msg": "touch stick active"},
  {"shot": "touch-stick-and-ok"},
  {"eval": "(__DQ.touchButton('confirm', false), __DQ.touchStick('move', 140, -20))"},
  {"wait": 250},
  {"shot": "touch-run-overdrive"},
  {"eval": "__DQ.touchStick('up')"},
  {"wait": 300},

  {"note": "12. sequence injection + harness press while frozen"},
  {"eval": "__DQ.resetDemo()"},
  {"eval": "__DQ.pressSeq(['down', 'down', 'right', 'confirm'])"},
  {"waitFor": "__DQ.state().input.injected.sequence === 0 && __DQ.state().input.down.length === 0", "timeout": 5000},
  {"wait": 60},
  {"assert": "__DQ.menuIndex() === 6 && __DQ.state().demo.bobble.hops === 1", "msg": "down, down, right, confirm in order -> 'Search' picked, one hop"},
  {"eval": "__DQ.freeze(true)"},
  {"eval": "__DQ.press('up')"},
  {"assert": "__DQ.menuIndex() === 6", "msg": "frozen: an injected press waits for simulated time"},
  {"eval": "__DQ.advance(200)"},
  {"assert": "__DQ.menuIndex() === 5", "msg": "...and lands on advance()"},
  {"eval": "__DQ.freeze(false)"},
  {"wait": 700},
  {"shot": "final"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"},
  {"assert": "__DQ.state().fps >= 50", "msg": "fps"},
  {"eval": "__DQ.state().input"}
]}
