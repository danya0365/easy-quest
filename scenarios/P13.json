{ "name": "P13 menus + P32 field HUD — every window, in the real field", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 60000},
  {"waitFor": "__DQ.state().input.blocked.length === 0", "timeout": 90000},
  {"waitFor": "__DQ.state().scene === 'field' && __DQ.screenshotReady()", "timeout": 30000},
  {"wait": 1200},
  {"note": "P32: arriving anywhere announces the place — one thing at a time, nothing lands on top of it"},
  {"eval": "__DQ.hudCard()"},
  {"wait": 600},
  {"eval": "JSON.stringify(__DQ.state().hud)"},
  {"assert": "__DQ.state().hud.card && __DQ.state().hud.card.name", "msg": "the place card names the place"},
  {"assert": "!__DQ.state().hud.ribbon", "msg": "the ribbon does not sit on top of the place card"},
  {"shot": "01-place-card"},
  {"note": "...then, when the card has had its moment, the ribbon says what to do next"},
  {"eval": "__DQ.hudRibbon()"},
  {"wait": 600},
  {"assert": "!!__DQ.state().hud.ribbon", "msg": "the ribbon says what to do next"},
  {"assert": "!__DQ.state().hud.card", "msg": "and the card has gone, so the two never overlap"},
  {"shot": "01b-what-to-do-next"},
  {"note": "P32: the little map, and the prompt in front of somebody you can talk to"},
  {"eval": "__DQ.minimap(true)"},
  {"wait": 900},
  {"eval": "__DQ.talkNear ? 1 : 0"},
  {"eval": "__DQ.npcFace ? __DQ.npcFace('nib') : __DQ.walkTo(1.4, 17.0)"},
  {"wait": 1200},
  {"shot": "02-minimap-and-prompt"},
  {"assert": "__DQ.state().hud.map.open === true", "msg": "the map is unrolled"},
  {"assert": "__DQ.state().hud.map.tiles > 20", "msg": "the map really drew the ground, not an empty square"},
  {"assert": "__DQ.state().hud.map.marks.you >= 12", "msg": "you are a hand-sized arrow on the plan, not a speck"},
  {"assert": "__DQ.state().hud.map.marks.folk > 0 && __DQ.state().hud.map.marks.ways > 0", "msg": "the plan marks the people and the ways out"},
  {"assert": "!!__DQ.state().hud.prompt", "msg": "standing in front of somebody says who they are and which button"},
  {"eval": "JSON.stringify(__DQ.state().hud)"},
  {"eval": "__DQ.minimap(false)"},
  {"wait": 400},
  {"note": "P13: the command window, the party window and the purse"},
  {"eval": "__DQ.demoAct(2)"},
  {"eval": "__DQ.press('menu')"},
  {"wait": 900},
  {"shot": "03-command-window"},
  {"assert": "__DQ.state().menu.open === true", "msg": "the menu opens on the Menu button"},
  {"assert": "__DQ.state().menu.windows.indexOf('m-cmd') >= 0 && __DQ.state().menu.windows.indexOf('m-party') >= 0 && __DQ.state().menu.windows.indexOf('m-gold') >= 0", "msg": "command, party and gold windows are all up"},
  {"assert": "__DQ.state().hud.shown === false", "msg": "the HUD gets out of the way of the menu"},
  {"eval": "JSON.stringify(__DQ.state().menu.tables)"},
  {"assert": "__DQ.state().menu.tables.items >= 73 && __DQ.state().menu.tables.itemsFrom === 'src/data/items.js'", "msg": "the bag, Items and Equip read the canon item table, not the test fixture"},
  {"assert": "__DQ.state().menu.tables.spells >= 28 && __DQ.state().menu.tables.spellsFrom === 'src/data/spells.js'", "msg": "...and the canon spell table too"},
  {"note": "P13: Status — a little 3D portrait, every number, the kit and the magic"},
  {"eval": "__DQ.menuTo('status')"},
  {"wait": 1500},
  {"shot": "04-status-bram"},
  {"assert": "__DQ.state().menu.portrait && __DQ.state().menu.portrait.live", "msg": "the 3D portrait is really rendering"},
  {"assert": "__DQ.state().menu.portrait.frames > 20", "msg": "...and it is animating, not one still frame"},
  {"eval": "JSON.stringify(__DQ.state().menu.statusFit)"},
  {"assert": "__DQ.state().menu.statusFit.bottom <= 720", "msg": "the whole Status page, footer and all, is on the screen"},
  {"eval": "__DQ.press('right')"},
  {"wait": 1100},
  {"shot": "05-status-next-character"},
  {"assert": "__DQ.state().menu.statusFit.bottom <= 720", "msg": "...for the next character too"},
  {"eval": "__DQ.press('right')"},
  {"wait": 1100},
  {"shot": "06-status-a-monster-friend"},
  {"assert": "__DQ.state().menu.statusFit.bottom <= 720", "msg": "...and for a monster friend"},
  {"eval": "JSON.stringify(__DQ.state().menu.fit)"},
  {"eval": "__DQ.press('cancel')"},
  {"wait": 600},
  {"note": "P13: Items — the bag, then a person's pockets, then use / hand over / wear / throw away"},
  {"eval": "__DQ.menuTo('items')"},
  {"wait": 700},
  {"eval": "__DQ.menuChoose('m-whose','bag')"},
  {"wait": 700},
  {"shot": "07-the-bag"},
  {"assert": "__DQ.state().menu.bag.length >= 8", "msg": "the bag has things in it"},
  {"assert": "__DQ.state().menu.bag.join(' ').indexOf('Strong Herb') >= 0", "msg": "the bag shows real item names out of src/data/items.js"},
  {"eval": "document.querySelector('.dq-blurb') ? (document.querySelector('.dq-blurb')||{textContent:''}).textContent : 'no blurb'"},
  {"assert": "/leaf|stops/i.test((document.querySelector('.dq-blurb')||{textContent:''}).textContent)", "msg": "the line under the bag is the item's own words, not a bare stat line"},
  {"assert": "/gold in a shop/.test((document.querySelector('.dq-blurb')||{textContent:''}).textContent)", "msg": "...and it says what a shop wants for it"},
  {"eval": "__DQ.menuChoose('m-bag','herb')"},
  {"wait": 700},
  {"shot": "08-use-give-wear-throw"},
  {"assert": "__DQ.state().menu.windows.indexOf('m-itemact') >= 0", "msg": "every item offers Use, Wear it, Hand over and Throw away"},
  {"eval": "__DQ.menuChoose('m-itemact','give')"},
  {"wait": 700},
  {"shot": "09-hand-it-over"},
  {"eval": "__DQ.press('cancel')"},
  {"wait": 400},
  {"note": "using a herb: one press of Confirm, one plain sentence, and the numbers really move"},
  {"eval": "__DQ.demoHurt(0.3)"},
  {"eval": "__DQ.menuChoose('m-itemact','use')"},
  {"wait": 800},
  {"eval": "__DQ.menuChoose('m-who','hero')"},
  {"wait": 1400},
  {"shot": "09b-a-herb-and-a-plain-sentence"},
  {"assert": "!!(__DQ.state().ui.text && /hit points/.test(__DQ.state().ui.text.text || ''))", "msg": "using a herb says what it did, in words"},
  {"eval": "__DQ.press('confirm')"},
  {"wait": 700},
  {"eval": "__DQ.press('cancel')"},
  {"wait": 400},
  {"eval": "__DQ.menuChoose('m-whose','hero')"},
  {"wait": 700},
  {"shot": "10-his-own-pockets"},
  {"note": "P13: a way to SEE the keys you carry — P30 keeps them out of the bag, so they get a page of their own"},
  {"eval": "JSON.stringify(__DQ.treasureGive('rusty_key'))"},
  {"eval": "__DQ.press('cancel')"},
  {"wait": 600},
  {"assert": "__DQ.state().menu.keys.indexOf('Rusty Key') >= 0", "msg": "the menu can see the Rusty Key a child found in the pot"},
  {"eval": "__DQ.menuChoose('m-whose','keys')"},
  {"wait": 900},
  {"shot": "10b-the-keys-you-carry"},
  {"assert": "(__DQ.menuWindows().find(w => w.id === 'm-bag')||{items:[]}).items.indexOf('rusty_key') >= 0", "msg": "the Rusty Key has its own row, with its own words"},
  {"assert": "/keyhole/i.test((document.querySelector('.dq-blurb')||{textContent:''}).textContent)", "msg": "...and the line underneath says what it is for"},
  {"assert": "__DQ.state().menu.fit.every(b => b.over === 0 && b.spill === 0)", "msg": "the keys page fits the screen and nothing runs out of it"},
  {"eval": "__DQ.menuChoose('m-bag','rusty_key')"},
  {"wait": 700},
  {"shot": "10c-a-key-is-never-thrown-away"},
  {"assert": "__DQ.state().menu.windows.indexOf('m-itemact') >= 0", "msg": "a key offers something to do, and refuses the rest kindly"},
  {"eval": "__DQ.press('cancel')"},
  {"wait": 400},
  {"eval": "__DQ.press('cancel')"},
  {"wait": 400},
  {"note": "P13: Equip — five slots, everything that fits, and what it does to your numbers"},
  {"eval": "__DQ.menuTo('equip')"},
  {"wait": 700},
  {"eval": "__DQ.menuChoose('m-who','hero')"},
  {"wait": 700},
  {"shot": "11-equip-slots"},
  {"eval": "__DQ.menuChoose('m-slots','weapon')"},
  {"wait": 800},
  {"shot": "12-stat-arrows"},
  {"assert": "__DQ.state().menu.windows.indexOf('m-stats') >= 0", "msg": "the numbers panel is open beside the list"},
  {"eval": "JSON.stringify(__DQ.state().ui.windows.filter(w => w.id === 'm-kit'))"},
  {"note": "P13: field Spells — MP, one plain line of what each one does, and who to cast it on"},
  {"eval": "__DQ.demoAct(3)"},
  {"eval": "__DQ.menuTo('spells')"},
  {"wait": 700},
  {"eval": "__DQ.menuChoose('m-who','hero')"},
  {"wait": 800},
  {"shot": "13-field-spells"},
  {"eval": "JSON.stringify((__DQ.state().ui.windows.find(w => w.id === 'm-spells')||{}).items)"},
  {"assert": "__DQ.state().menu.fit.every(b => b.over === 0 && b.spill === 0)", "msg": "no window runs off the screen, and no words run out of a window"},
  {"note": "the grown-up Status page: Act III, a dozen spells, and it still fits"},
  {"eval": "__DQ.menuTo('status')"},
  {"wait": 1400},
  {"shot": "13b-status-act-three"},
  {"assert": "__DQ.state().menu.portrait && __DQ.state().menu.portrait.live", "msg": "the portrait is still there on the SECOND look at Status, not an empty frame"},
  {"eval": "JSON.stringify(__DQ.state().menu.portrait)"},
  {"eval": "JSON.stringify(__DQ.state().menu.statusFit)"},
  {"assert": "__DQ.state().menu.statusFit.bottom <= 720", "msg": "the Act III Status page fits the screen"},
  {"eval": "__DQ.press('right')"},
  {"wait": 900},
  {"eval": "JSON.stringify(__DQ.state().menu.statusFit)"},
  {"shot": "13c-status-the-mage"},
  {"assert": "__DQ.state().menu.statusFit.bottom <= 720", "msg": "...and so does the mage's"},
  {"eval": "__DQ.press('cancel')"},
  {"wait": 600},
  {"note": "P13: Tactics — how each friend fights when you are not telling them"},
  {"eval": "__DQ.menuTo('tactics')"},
  {"wait": 800},
  {"shot": "14-tactics"},
  {"eval": "__DQ.press('down')"},
  {"eval": "__DQ.press('confirm')"},
  {"wait": 800},
  {"shot": "15-how-they-fight"},
  {"note": "P13: Misc — words, bigger words, music, sounds, touch buttons, and the tale's secret code"},
  {"eval": "__DQ.menuTo('misc')"},
  {"wait": 800},
  {"shot": "16-misc"},
  {"eval": "__DQ.press('right')"},
  {"wait": 400},
  {"eval": "__DQ.press('down')"},
  {"eval": "__DQ.press('down')"},
  {"wait": 300},
  {"eval": "__DQ.press('left')"},
  {"eval": "__DQ.press('left')"},
  {"wait": 500},
  {"shot": "17-turning-the-music-down"},
  {"eval": "JSON.stringify(__DQ.state().menu.settings)"},
  {"assert": "__DQ.state().menu.settings.music < 0.75", "msg": "left really turns the music down"},
  {"note": "P13: the escape hatch — the whole tale as a line of letters a grown-up can keep"},
  {"eval": "__DQ.menuChoose('m-misc','code')"},
  {"wait": 700},
  {"eval": "__DQ.menuChoose('m-code','copy')"},
  {"wait": 1600},
  {"shot": "17b-the-secret-code"},
  {"eval": "JSON.stringify(__DQ.menuWindows().map(w => w.id))"},
  {"eval": "__DQ.press('confirm')"},
  {"wait": 700},
  {"eval": "__DQ.press('cancel')"},
  {"wait": 500},
  {"note": "nothing traps you: Cancel at the command window hands the field back"},
  {"eval": "__DQ.press('cancel')"},
  {"wait": 900},
  {"shot": "18-back-in-the-field"},
  {"assert": "__DQ.state().menu.open === false", "msg": "the menu closed itself"},
  {"assert": "__DQ.state().scene === 'field'", "msg": "...and gave the field back"},
  {"assert": "__DQ.state().hud.shown === true", "msg": "the HUD comes back with it"},
  {"eval": "JSON.stringify(__DQ.errors.slice(0, 6))"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"}
] }
