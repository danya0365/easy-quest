{ "name": "P05/P23 Puddlewick — the home village, live in /index.html", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 40000},
  {"wait": 1500},
  {"note": "register the map exactly as src/world/maps/index.js will (NEEDS: one line in that index)"},
  {"eval": "(await import('/src/world/map.js')).Maps.loadModule({ id: 'puddlewick', layers: [] })"},
  {"eval": "__DQ.listMaps()"},
  {"eval": "JSON.stringify(__DQ.teleport('puddlewick'))"},
  {"wait": 2500},
  {"eval": "JSON.stringify(__DQ.state().map)"},
  {"eval": "JSON.stringify((__DQ.state().field.view||{}).counts||null)"},
  {"eval": "JSON.stringify((__DQ.state().field.view||{}).buildings||null).slice(0,400)"},
  {"assert": "__DQ.state().map.id === 'puddlewick' && __DQ.state().map.exits >= 11", "msg": "every door is an exit, plus the lane out"},
  {"assert": "__DQ.state().map.music === 'village'", "msg": "Puddlewick plays its own theme (CANON §9)"},
  {"assert": "__DQ.state().map.missingLines.length === 0", "msg": "everything that can be talked to has words"},

  {"note": "1. you arrive at the south-east gate and look up the lane"},
  {"shot": "01-arrive-at-the-gate"},

  {"note": "2. the whole village from above: the green, the ring lane, the Beck, the bridge, the fields"},
  {"eval": "__DQ.cameraRig({pitch: 78, dist: 62, fov: 42, lookUp: 0})"}, {"eval": "__DQ.teleport('puddlewick', 0, 2)"}, {"wait": 2200}, {"shot": "02-plan"},
  {"eval": "__DQ.cameraRig({pitch: 28, dist: 11, fov: 49, lookUp: 2.2})"},

  {"note": "3. the green: the well, the chestnut tree, the market, the festival"},
  {"eval": "__DQ.teleport('puddlewick', 2.2, 10.5)"}, {"eval": "__DQ.cameraOrbit(0)"}, {"wait": 2000}, {"shot": "03-the-green-and-the-well"},
  {"eval": "__DQ.teleport('puddlewick', -5.0, 1.0)"}, {"eval": "__DQ.cameraOrbit(150)"}, {"wait": 2000}, {"shot": "04-the-green-looking-south"},

  {"note": "4. the buildings, from the far side of the green (the follow camera fades whatever you stand against)"},
  {"eval": "__DQ.teleport('puddlewick', 2.0, 4.0)"}, {"eval": "__DQ.cameraOrbit(330)"}, {"eval": "__DQ.cameraZoom(16)"}, {"wait": 2200}, {"shot": "05-the-inn"},
  {"eval": "__DQ.teleport('puddlewick', 7.0, 8.0)"}, {"eval": "__DQ.cameraOrbit(290)"}, {"wait": 2200}, {"shot": "06-the-shop-and-the-twins-house"},
  {"eval": "__DQ.teleport('puddlewick', -6.0, 2.0)"}, {"eval": "__DQ.cameraOrbit(60)"}, {"wait": 2200}, {"shot": "07-hollybank-cottage"},
  {"eval": "__DQ.cameraZoom(11)"},
  {"eval": "__DQ.teleport('puddlewick', -0.6, -9.0)"}, {"eval": "__DQ.cameraOrbit(0)"}, {"wait": 2000}, {"shot": "08-the-bridge-and-the-chapel"},
  {"eval": "__DQ.teleport('puddlewick', 5.2, -17.0)"}, {"eval": "__DQ.cameraOrbit(20)"}, {"wait": 2000}, {"shot": "09-the-chapel"},
  {"eval": "__DQ.teleport('puddlewick', -14.8, -9.6)"}, {"eval": "__DQ.cameraOrbit(115)"}, {"wait": 2000}, {"shot": "10-the-mill"},
  {"eval": "__DQ.teleport('puddlewick', -19.0, 10.5)"}, {"eval": "__DQ.cameraOrbit(80)"}, {"wait": 2000}, {"shot": "11-the-sheep-pen"},
  {"eval": "__DQ.teleport('puddlewick', 18.0, -17.6)"}, {"eval": "__DQ.cameraOrbit(150)"}, {"wait": 2000}, {"shot": "12-the-shrine-of-saint-alden"},
  {"eval": "__DQ.teleport('puddlewick', 11.0, 21.0)"}, {"eval": "__DQ.cameraOrbit(210)"}, {"wait": 2000}, {"shot": "13-the-gate-the-signpost-and-the-wall"},
  {"eval": "__DQ.teleport('puddlewick', -3.0, 13.0)"}, {"eval": "__DQ.cameraOrbit(20)"}, {"wait": 2000}, {"shot": "14-the-festival-green"},

  {"note": "5. the doors open as you walk up to them, and every door is a way in"},
  {"eval": "JSON.stringify((await import('/src/world/maps/puddlewick.js')).puddlewickLayout().doors.hollybank)"},
  {"eval": "__DQ.walkTo((await import('/src/world/maps/puddlewick.js')).puddlewickLayout().doors.hollybank.x, (await import('/src/world/maps/puddlewick.js')).puddlewickLayout().doors.hollybank.z)"},
  {"eval": "__DQ.face(((await import('/src/world/maps/puddlewick.js')).puddlewickLayout().doors.hollybank.facing + Math.PI) * 180 / Math.PI)"},
  {"eval": "__DQ.cameraOrbit(220)"},
  {"wait": 1600},
  {"shot": "15-a-door-opens"},
  {"assert": "__DQ.state().field.view.buildings.doors.some(d => d.open > 0.4)", "msg": "a door swings open as the hero walks up"},
  {"eval": "__DQ.state().field.view.buildings.doors.filter(d => d.open > 0.1).map(d => d.id).join(',')"},

  {"note": "6. walking into a door talks (the interiors are their own maps, P06/P23 — until then the village says so)"},
  {"eval": "__DQ.face(0)"},
  {"eval": "__DQ.walkTo((await import('/src/world/maps/puddlewick.js')).puddlewickLayout().doors.puddlewick_chapel.x, (await import('/src/world/maps/puddlewick.js')).puddlewickLayout().doors.puddlewick_chapel.z - 1.2)"},
  {"wait": 1400},
  {"shot": "16-into-the-chapel-door"},
  {"assert": "!!__DQ.state().dialogue && __DQ.state().dialogue.open === true", "msg": "a door you step into speaks"},
  {"press": "Enter", "times": 3, "delay": 500},
  {"wait": 800},

  {"note": "7. the lane out really goes to Puddlewick Vale"},
  {"eval": "__DQ.walkTo(16.5, 26.2)"},
  {"wait": 500},
  {"key": "ArrowUp", "hold": 60},
  {"wait": 2500},
  {"eval": "JSON.stringify(__DQ.state().map && __DQ.state().map.id)"},
  {"shot": "17-out-into-the-vale"},
  {"assert": "__DQ.state().map.id === 'meadow'", "msg": "the lane out of Puddlewick arrives in the vale"},
  {"assert": "Math.hypot(__DQ.state().player.x - 15.4, __DQ.state().player.z + 27.0) < 3", "msg": "you land on the vale's village lane, not inside its exit"},

  {"note": "8. and back again"},
  {"eval": "JSON.stringify(__DQ.teleport('puddlewick'))"},
  {"wait": 2000},
  {"eval": "__DQ.state().field.view.state ? 1 : 1"},
  {"assert": "__DQ.state().map.id === 'puddlewick'", "msg": "back home"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors in Puddlewick"}
]}
