{ "name": "critic P17/P18 d1 RUN B — real game: the whole join ceremony at reading pace, refuse then accept", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 45000},
  {"wait": 2500},
  {"eval": "JSON.stringify({scene: __DQ.state().scene, map: (__DQ.state().map||{}).id})"},
  {"eval": "JSON.stringify(__DQ.befriending(true))"},
  {"eval": "(()=>{const s=__DQ.rosterSnapshot(); s.recruit=Object.assign({},s.recruit,{enabled:true,kidMode:true,misses:{gloop:12},joined:{}}); __DQ.rosterRestore(s); return JSON.stringify(__DQ.rosterSnapshot().recruit);})()"},
  {"eval": "JSON.stringify(__DQ.fight(null,{enemies:['gloop','gloop']})||'started')"},
  {"wait": 2200},
  {"shot": "01-battle-open"},
  {"eval": "__DQ.playOut('auto')"},
  {"waitFor": "__DQ.state().battleUi && __DQ.state().battleUi.waiting === 'recruit'", "timeout": 120000},
  {"shot": "02-asks-to-join"},
  {"eval": "JSON.stringify({battleUi: __DQ.state().battleUi, ui: __DQ.state().ui.windows.map(w=>({id:w.id,title:w.title,text:(w.text||'').slice(0,200),selectedLabel:w.selectedLabel}))})"},
  {"wait": 900},
  {"shot": "03-asks-to-join-b"},

  {"note": "REFUSE with the real cursor: move down and confirm"},
  {"press": "ArrowDown"},
  {"wait": 350},
  {"shot": "04-cursor-on-no"},
  {"press": "Enter"},
  {"wait": 1500},
  {"shot": "05-refused"},
  {"eval": "JSON.stringify({battleUi: __DQ.state().battleUi, log: __DQ.log(8)})"},
  {"wait": 3000},
  {"shot": "06-after-refusal"},
  {"eval": "JSON.stringify({scene: __DQ.state().scene, friends: __DQ.friends().friends, party: __DQ.friends().party.map(m=>m.name)})"},

  {"note": "now a second fight, and ACCEPT, with the whole ceremony captured frame by frame"},
  {"wait": 2500},
  {"eval": "(()=>{const s=__DQ.rosterSnapshot(); s.recruit=Object.assign({},s.recruit,{enabled:true,kidMode:true,misses:{flapjack:12},joined:{}}); __DQ.rosterRestore(s); return JSON.stringify(__DQ.rosterSnapshot().recruit);})()"},
  {"eval": "JSON.stringify(__DQ.fight(null,{enemies:['flapjack']})||'started')"},
  {"wait": 2000},
  {"eval": "__DQ.playOut('auto')"},
  {"waitFor": "__DQ.state().battleUi && __DQ.state().battleUi.waiting === 'recruit'", "timeout": 120000},
  {"shot": "07-asks-again"},
  {"press": "Enter"},
  {"burst": {"name": "ceremony", "count": 14, "interval": 400}},
  {"eval": "JSON.stringify({ui: __DQ.state().ui.windows.map(w=>({id:w.id,title:w.title,text:(w.text||'').slice(0,200),selectedLabel:w.selectedLabel})), battleUi: __DQ.state().battleUi})"},
  {"eval": "JSON.stringify(Array.from(document.querySelectorAll('canvas')).map(c=>({id:c.id,w:c.width,h:c.height})))"},
  {"shot": "08-naming-window"},
  {"press": "Enter"},
  {"wait": 1200},
  {"shot": "09-after-name-confirm"},
  {"eval": "JSON.stringify({ui: __DQ.state().ui.windows.map(w=>({id:w.id,title:w.title,text:(w.text||'').slice(0,240)})), friends: __DQ.friends().friends})"},
  {"burst": {"name": "post-name", "count": 10, "interval": 500}},
  {"eval": "JSON.stringify({scene: __DQ.state().scene, friends: __DQ.friends()})"},
  {"wait": 2500},
  {"shot": "10-back-on-field"},
  {"eval": "JSON.stringify(__DQ.followers())"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors in RUN B"}
]}
