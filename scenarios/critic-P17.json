{ "name": "critic P17/P18 d1 — the whole judgment, in the order it was measured", "steps": [
  {"note": "RUN 1 (out: shots/P17-critic-d1/game) — /index.html: is any of P17/P18 reachable by a player?"},
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 45000},
  {"wait": 2000},
  {"shot": "01-real-game-boot"},
  {"eval": "JSON.stringify(__DQ.state().boot.plugins)"},
  {"eval": "JSON.stringify({friends: !!__DQ.state().friends, companions: !!__DQ.state().companions, recruit: typeof __DQ.recruit, wagonMenu: typeof __DQ.wagonMenu})"},
  {"assert": "!!__DQ.state().companions", "msg": "REACHABILITY: followers/wagon/paddock installed in /index.html"},
  {"assert": "typeof __DQ.recruit === 'function'", "msg": "REACHABILITY: the naming ceremony exists in /index.html"},

  {"note": "RUN 2 (out: shots/P17-critic-d1/game-join) — force a real join in /index.html and watch the whole ceremony."},
  {"eval": "JSON.stringify(__DQ.befriending(true))"},
  {"eval": "(() => { const s = __DQ.rosterSnapshot(); s.recruit = Object.assign({}, s.recruit, {enabled:true, kidMode:true, misses:{gloop:12}, joined:{}}); __DQ.rosterRestore(s); return JSON.stringify(__DQ.rosterSnapshot().recruit); })()"},
  {"eval": "__DQ.instantAnswer(false)"},
  {"eval": "JSON.stringify(__DQ.fight(null, {enemies: ['gloop','gloop']}) || 'started')"},
  {"waitFor": "__DQ.state().battleUi && __DQ.state().battleUi.waiting === 'recruit'", "timeout": 90000},
  {"shot": "03-it-wants-to-join-a"},
  {"wait": 700},
  {"shot": "04-it-wants-to-join-b"},
  {"eval": "__DQ.answer(true)"},
  {"wait": 500},
  {"shot": "05-said-yes"},
  {"eval": "JSON.stringify({windows: __DQ.state().ui.windows.map(w=>w.id), naming: __DQ.state().ui.windows.some(w=>String(w.id).indexOf('recruit')>=0)})"},
  {"waitFor": "__DQ.state().scene === 'field'", "timeout": 60000},
  {"wait": 1400},
  {"shot": "08-back-on-the-field-with-a-new-friend"},
  {"eval": "JSON.stringify(__DQ.roster())"},

  {"note": "RUN 3 (out: shots/P17-critic-d1/demo) — demos/P17.html, gap by gap: the naming window, the wagon footprint, the roster, the paddock, save and reload."},
  {"eval": "__DQ.stock(6)"},
  {"shot": "04-wagon-default-camera"},
  {"eval": "JSON.stringify(__DQ.cameraRig())"},
  {"eval": "(__DQ.wagonMenu(), 'opened')"},
  {"waitFor": "__DQ.state().ui.windows.some(w => w.id === 'party-wagon')", "timeout": 8000},
  {"shot": "06-wagon-roster-window"},
  {"press": "Escape"},
  {"eval": "(__DQ.recruit('cactuddle', {auto: true, heroLvl: 6}), 'offered')"},
  {"waitFor": "__DQ.state().ui.windows.some(w => w.id === 'recruit-name')", "timeout": 12000},
  {"shot": "09-naming-window"},
  {"eval": "JSON.stringify(Array.from(document.querySelectorAll('canvas')).map(c => ({w: c.width, h: c.height, id: c.id})))"},
  {"eval": "__DQ.stock(12)"},
  {"eval": "__DQ.teleport('puddlewick')"},
  {"waitFor": "__DQ.state().map && __DQ.state().map.id === 'puddlewick'", "timeout": 25000},
  {"shot": "14-village-with-procession"},
  {"eval": "!!__DQ.saveGame(3)"},
  {"eval": "!!__DQ.loadGame(3)"},
  {"wait": 2200},
  {"shot": "15-after-reload"},

  {"note": "RUN 4 (out: shots/P17-critic-d1/demo-fight) — the real path: win a fight, a Gloop asks, you name it; then the paddock."},
  {"eval": "JSON.stringify(__DQ.forceRecruit('gloop'))"},
  {"eval": "__DQ.instantAnswer(true)"},
  {"eval": "JSON.stringify(__DQ.fight(null, {enemies: ['gloop','gloop']}) || 'started')"},
  {"waitFor": "__DQ.state().battleUi && __DQ.state().battleUi.waiting === 'recruit'", "timeout": 90000},
  {"shot": "01-asks-to-join"},
  {"eval": "__DQ.answer(true)"},
  {"waitFor": "__DQ.state().ui.windows.some(w => w.id === 'recruit-name')", "timeout": 20000},
  {"shot": "05-name-it-after-the-fight"},
  {"press": "Enter"},
  {"wait": 1500},
  {"shot": "06-named-and-celebrated"},
  {"eval": "typeof __DQ.walkTo === 'function' ? JSON.stringify(__DQ.walkTo(-27.0, 3.6)) : 'no walkTo'"},
  {"eval": "__DQ.cameraRig({dist: 11, pitch: 40})"},
  {"shot": "09-the-paddock-wide"},

  {"note": "RUN 5 (out: shots/P17-critic-d1/hop and .../still) — is the monster hop driven by distance? Hero frozen at speed 0, camera dist 10 pitch 34, 12 frames at 100 ms."},
  {"eval": "JSON.stringify(__DQ.cameraRig({dist: 10, pitch: 34}))"},
  {"eval": "JSON.stringify(__DQ.face(0))"},
  {"eval": "JSON.stringify(__DQ.state().player.speed)"},
  {"burst": {"name": "still", "count": 12, "interval": 100}},

  {"note": "RUN 6 (out: shots/P17-critic-d1/fullparty) — default camera, the DQV party of four: how many monsters can a child see? Measured: none."},
  {"eval": "__DQ.stock(2)"},
  {"eval": "JSON.stringify(__DQ.state().friends.party.map(m=>m.name+':'+m.kind))"},
  {"shot": "01-default-camera-standing"},
  {"key": "ArrowUp", "hold": 1500},
  {"shot": "02-default-camera-walking"},

  {"note": "RUN 7 (out: shots/P17-critic-d1/menu and .../roster and .../battle-cmd) — the doors into the roster, and what a refusal says."},
  {"eval": "JSON.stringify(__DQ.menuOpen())"},
  {"eval": "JSON.stringify(__DQ.menuWindows())"},
  {"shot": "01-main-menu"},
  {"press": "Escape"},
  {"eval": "(__DQ.wagonMenu(), 'opened')"},
  {"waitFor": "__DQ.state().ui.windows.some(w => w.id === 'party-wagon')", "timeout": 8000},
  {"press": "Enter"},
  {"wait": 800},
  {"shot": "01-pressed-Z-on-the-hero"},
  {"eval": "JSON.stringify(__DQ.state().ui.windows.map(w=>({id:w.id,title:w.title,selectedLabel:w.selectedLabel})))"},
  {"press": "ArrowDown"},
  {"press": "Enter"},
  {"wait": 800},
  {"shot": "02-pressed-Z-on-the-guest"},
  {"eval": "JSON.stringify({windows: __DQ.state().ui.windows.map(w=>w.id), party: __DQ.state().friends.party.map(m=>m.name)})"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors anywhere in the run"}
]}
