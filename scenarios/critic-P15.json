{
 "name": "critic-P15 items, tactics, target, flee",
 "steps": [
  {
   "waitFor": "window.__DQ && __DQ.ready",
   "timeout": 40000
  },
  {
   "wait": 2500
  },
  {
   "eval": "__DQ.setLevel(8)"
  },
  {
   "eval": "__DQ.give(\"herb\",3)"
  },
  {
   "eval": "__DQ.fight({enemies:[\"gloop\",\"peckish\",\"gloop\"]})"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));let n=0;while(n++<400){const u=__DQ.state().battleUi||{};if(u.menu&&!u.typing)break;await sl(40);}return JSON.stringify({menu:!!(__DQ.state().battleUi||{}).menu,line:(__DQ.state().battleUi||{}).line});})()"
  },
  {
   "shot": "cmd-root"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));for(const k of [\"confirm\"]){__DQ.press(k);await sl(230);}return JSON.stringify({menu:__DQ.state().battleUi.menu?'open':'closed',line:__DQ.state().battleUi.line});})()"
  },
  {
   "shot": "target-window"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));for(const k of [\"right\"]){__DQ.press(k);await sl(230);}return JSON.stringify({menu:__DQ.state().battleUi.menu?'open':'closed',line:__DQ.state().battleUi.line});})()"
  },
  {
   "shot": "target-2nd"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));for(const k of [\"cancel\"]){__DQ.press(k);await sl(230);}return JSON.stringify({menu:__DQ.state().battleUi.menu?'open':'closed',line:__DQ.state().battleUi.line});})()"
  },
  {
   "shot": "target-cancelled"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));for(const k of [\"down\"]){__DQ.press(k);await sl(230);}return JSON.stringify({menu:__DQ.state().battleUi.menu?'open':'closed',line:__DQ.state().battleUi.line});})()"
  },
  {
   "shot": "cursor-items"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));for(const k of [\"confirm\"]){__DQ.press(k);await sl(230);}return JSON.stringify({menu:__DQ.state().battleUi.menu?'open':'closed',line:__DQ.state().battleUi.line});})()"
  },
  {
   "shot": "items-list"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));for(const k of [\"cancel\"]){__DQ.press(k);await sl(230);}return JSON.stringify({menu:__DQ.state().battleUi.menu?'open':'closed',line:__DQ.state().battleUi.line});})()"
  },
  {
   "shot": "items-cancelled"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));for(const k of [\"down\",\"right\"]){__DQ.press(k);await sl(230);}return JSON.stringify({menu:__DQ.state().battleUi.menu?'open':'closed',line:__DQ.state().battleUi.line});})()"
  },
  {
   "shot": "cursor-tactics"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));for(const k of [\"confirm\"]){__DQ.press(k);await sl(230);}return JSON.stringify({menu:__DQ.state().battleUi.menu?'open':'closed',line:__DQ.state().battleUi.line});})()"
  },
  {
   "shot": "tactics-who"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));for(const k of [\"confirm\"]){__DQ.press(k);await sl(230);}return JSON.stringify({menu:__DQ.state().battleUi.menu?'open':'closed',line:__DQ.state().battleUi.line});})()"
  },
  {
   "shot": "tactics-list"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));for(const k of [\"cancel\",\"cancel\"]){__DQ.press(k);await sl(230);}return JSON.stringify({menu:__DQ.state().battleUi.menu?'open':'closed',line:__DQ.state().battleUi.line});})()"
  },
  {
   "shot": "root-again"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));for(const k of [\"down\",\"down\",\"left\"]){__DQ.press(k);await sl(230);}return JSON.stringify({menu:__DQ.state().battleUi.menu?'open':'closed',line:__DQ.state().battleUi.line});})()"
  },
  {
   "shot": "cursor-flee"
  },
  {
   "eval": "(async()=>{const sl=m=>new Promise(r=>setTimeout(r,m));for(const k of [\"confirm\"]){__DQ.press(k);await sl(230);}return JSON.stringify({menu:__DQ.state().battleUi.menu?'open':'closed',line:__DQ.state().battleUi.line});})()"
  },
  {
   "wait": 400
  },
  {
   "shot": "flee-1"
  },
  {
   "burst": {
    "name": "flee",
    "count": 10,
    "interval": 220
   }
  },
  {
   "eval": "JSON.stringify({scene:__DQ.state().scene,ui:__DQ.state().battleUi,res:__DQ.battleResult()})"
  },
  {
   "assert": "__DQ.errors.length===0",
   "msg": "no runtime errors"
  }
 ]
}