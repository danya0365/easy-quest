{ "name":"critic-feel sign dialogue probe (index)", "steps":[
  {"waitFor":"window.__DQ && __DQ.ready","timeout":30000},
  {"wait":1200},
  {"eval":"__DQ.teleport('meadow', 2.2, 12.6)"},
  {"wait":800},
  {"press":"ArrowUp","delay":300},
  {"wait":500},
  {"shot":"at-sign"},
  {"eval":"JSON.stringify(__DQ.state().player.near)+' '+JSON.stringify(__DQ.state().field.prompt)"},
  {"press":"Enter","delay":10},
  {"burst":{"name":"open","count":8,"interval":20}},
  {"wait":1500},
  {"shot":"typed"},
  {"eval":"JSON.stringify(__DQ.state().dialogue)"},
  {"eval":"(()=>{const els=[...document.querySelectorAll('body *')].filter(e=>e.offsetWidth>300&&e.offsetHeight>60&&getComputedStyle(e).position!=='static');return els.map(e=>e.tagName+'#'+e.id+'.'+e.className+' '+e.offsetWidth+'x'+e.offsetHeight).join(' | ').slice(0,390)})()"}
]}
