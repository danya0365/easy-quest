{ "name": "P02/P03 in the real game — the skyline, the hours, the water", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 45000},
  {"waitFor": "__DQ.screenshotReady()", "timeout": 25000},
  {"wait": 1800},
  {"note": "1. as it opens — is there anything on the skyline, and is any of it NOT behind a tree?"},
  {"shot": "01-as-it-opens"},
  {"eval": "JSON.stringify(__DQ.state().sky)"},
  {"eval": "JSON.stringify(__DQ.landmarks())"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen())"},
  {"note": "   the skyline profile: how high the world stands on every bearing, and WHAT is standing there."},
  {"eval": "JSON.stringify(__DQ.skyline(-100, 260, 20))"},
  {"assert": "__DQ.landmarks().length >= 4", "msg": "four places stand on the skyline, one down each signposted bearing"},
  {"assert": "(function(l){return l && l.onScreen && !l.clipped && l.visiblePx > 20})(__DQ.landmarkScreen().find(l => l.id === 'puddlewick'))", "msg": "Puddlewick really renders in the opening frame"},

  {"note": "2. the destination COMES CLOSER. landmarks().dist is measured from the camera, so walking at a place"},
  {"note": "   must shorten it and grow the painted card. The cards stand in the world, not on a skybox."},
  {"eval": "JSON.stringify(__DQ.landmarkFit())"},
  {"eval": "window.__d0 = __DQ.landmarks().find(l => l.id === 'puddlewick').dist"},
  {"eval": "window.__a0 = __DQ.landmarks().find(l => l.id === 'puddlewick').angDeg"},
  {"eval": "window.__h0 = (__DQ.landmarkScreen().find(l => l.id === 'puddlewick') || {}).heightPx"},
  {"eval": "window.__s0 = JSON.stringify(__DQ.landmarks().find(l => l.id === 'puddlewick').size)"},
  {"eval": "__DQ.teleport('meadow', 14.5, -25.6)"}, {"wait": 1600}, {"eval": "__DQ.cameraOrbit(__DQ.landmarks().find(l => l.id === 'puddlewick').orbit)"}, {"wait": 1400},
  {"shot": "02-walked-up-the-lane"},
  {"eval": "JSON.stringify({dist0: window.__d0, dist1: __DQ.landmarks().find(l => l.id === 'puddlewick').dist, h0: window.__h0, h1: __DQ.landmarkScreen().find(l => l.id === 'puddlewick').heightPx, size0: window.__s0, size1: __DQ.landmarks().find(l => l.id === 'puddlewick').size})"},
  {"assert": "__DQ.landmarks().find(l => l.id === 'puddlewick').dist < window.__d0 - 25", "msg": "walking up the lane really closes 25 m on Puddlewick"},
  {"eval": "JSON.stringify({ang0: window.__a0, ang1: __DQ.landmarks().find(l => l.id === 'puddlewick').angDeg})"},
  {"assert": "__DQ.landmarks().find(l => l.id === 'puddlewick').angDeg > window.__a0 * 1.15", "msg": "and the place really grows: 19 percent closer is 19 percent bigger"},
  {"eval": "__DQ.teleport('meadow')"}, {"wait": 1600},

  {"note": "3. orbit all four compass points at spawn, with the occlusion measured every time"},
  {"eval": "__DQ.cameraOrbit(0)"}, {"wait": 1100}, {"shot": "03-look-north"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().filter(l => l.onScreen).map(l => [l.id, l.hiddenPct, l.visiblePx]))"},
  {"eval": "__DQ.cameraOrbit(90)"}, {"wait": 1100}, {"shot": "04-look-east"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().filter(l => l.onScreen).map(l => [l.id, l.hiddenPct, l.visiblePx]))"},
  {"eval": "__DQ.cameraOrbit(180)"}, {"wait": 1100}, {"shot": "05-look-south"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().filter(l => l.onScreen).map(l => [l.id, l.hiddenPct, l.visiblePx]))"},
  {"eval": "__DQ.cameraOrbit(270)"}, {"wait": 1100}, {"shot": "06-look-west"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().filter(l => l.onScreen).map(l => [l.id, l.hiddenPct, l.visiblePx]))"},

  {"note": "4. down each signposted bearing"},
  {"eval": "__DQ.landmarkView('puddlewick')"}, {"wait": 1300}, {"shot": "07-toward-puddlewick"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l => l.id === 'puddlewick'))"},
  {"eval": "__DQ.landmarkView('saltmarrow')"}, {"wait": 1300}, {"shot": "08-toward-saltmarrow"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l => l.id === 'saltmarrow'))"},
  {"eval": "__DQ.landmarkView('coddleston')"}, {"wait": 1300}, {"shot": "09-toward-coddleston"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l => l.id === 'coddleston'))"},

  {"note": "5. WHAT THE LANE MOUTHS ARE WORTH: hide the painted treetop rows (which carry no `mouth` in the map's"},
  {"note": "   WOOD_ROWS) and measure the same frames again. This is the change P02 is asking P23 for."},
  {"eval": "JSON.stringify(__DQ.blockers())"},
  {"eval": "JSON.stringify(__DQ.blockers('forestCards'))"}, {"wait": 1200}, {"shot": "10-if-the-passes-were-open"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l => l.id === 'coddleston'))"},
  {"eval": "JSON.stringify(__DQ.skyline(-100, 260, 20))"},
  {"eval": "JSON.stringify(__DQ.blockers(''))"}, {"wait": 900},

  {"note": "6. the clouds cross the sky (the phase is integrated, so it can be read as a number)"},
  {"eval": "__DQ.cameraOrbit(4)"}, {"wait": 900},
  {"eval": "window.__p0 = __DQ.cloudDrift().phaseRad"}, {"wait": 2500},
  {"eval": "JSON.stringify({p0: window.__p0, p1: __DQ.cloudDrift().phaseRad, degPerMin: __DQ.cloudDrift().degPerMin})"},
  {"assert": "__DQ.cloudDrift().phaseRad > window.__p0 + 0.005", "msg": "the cloud flock really travels"},

  {"note": "7. the hours, from the same spot: the sun travels, so no two are the same sky"},
  {"eval": "__DQ.timeOfDay(9)"}, {"wait": 900}, {"shot": "11a-nine"},
  {"eval": "__DQ.timeOfDay(12)"}, {"wait": 900}, {"shot": "11b-noon"},
  {"assert": "__DQ.state().sky.sunEl > 44", "msg": "at noon the sun stands at its highest"},
  {"eval": "__DQ.timeOfDay(18.6)"}, {"wait": 900}, {"shot": "12-dusk"},
  {"eval": "__DQ.timeOfDay(21.5)"}, {"wait": 1000}, {"shot": "13-night-2130"},
  {"eval": "__DQ.timeOfDay(3)"}, {"wait": 1000}, {"shot": "14-night-0300"},
  {"eval": "__DQ.timeOfDay(6.3)"}, {"wait": 1000}, {"shot": "15-dawn"},
  {"eval": "__DQ.timeOfDay(9)"}, {"wait": 900},

  {"note": "8. water: the Beck's edge, the hero WADING in it, and the pond — a surface, not a fill"},
  {"eval": "__DQ.teleport('meadow', 12.5, -12.5)"}, {"wait": 1400}, {"eval": "__DQ.cameraOrbit(20)"}, {"wait": 1600}, {"shot": "16-beck-edge"},
  {"eval": "__DQ.teleport('meadow', 7.5, -14.2)"}, {"wait": 1400}, {"eval": "__DQ.cameraOrbit(90)"}, {"wait": 1800}, {"shot": "17-wading"},
  {"eval": "JSON.stringify(__DQ.state().player.ground)"},
  {"assert": "__DQ.state().player.ground === 'water'", "msg": "the hero really is in the Beck, so the ripple rings are round him"},
  {"burst": {"name": "17b-ripples", "count": 4, "interval": 420}},
  {"eval": "__DQ.teleport('meadow', 26.2, -16.0)"}, {"wait": 1400}, {"eval": "__DQ.cameraOrbit(180)"}, {"wait": 1800}, {"shot": "18-pond"},
  {"eval": "__DQ.timeOfDay(18.8)"}, {"wait": 1200}, {"shot": "19-pond-at-dusk"},
  {"eval": "__DQ.timeOfDay(9)"}, {"wait": 900},

  {"note": "9. weather in the real game"},
  {"eval": "__DQ.weather('rain', {instant: true})"}, {"wait": 1700}, {"shot": "20-rain"},
  {"eval": "__DQ.weather('snow', {instant: true})"}, {"wait": 1900}, {"shot": "21-snow"},
  {"eval": "__DQ.weather('clear', {instant: true})"}, {"wait": 1500},

  {"note": "10. back to the opening and health"},
  {"eval": "__DQ.teleport('meadow')"}, {"wait": 1600}, {"eval": "__DQ.cameraOrbit(4)"}, {"wait": 1400}, {"shot": "22-opening-again"},
  {"eval": "JSON.stringify(__DQ.state().sky)"},
  {"eval": "JSON.stringify(__DQ.budget())"},
  {"eval": "JSON.stringify(__DQ.state().fps)"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"},
  {"assert": "__DQ.state().fps >= 45", "msg": "fps >= 45"}
]}
