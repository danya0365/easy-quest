{ "name": "P22 counters", "steps": [
  { "waitFor": "window.__DQ && __DQ.ready", "timeout": 30000 },
  { "wait": 1500 },
  { "shot": "01-the-corner" },
  { "eval": "JSON.stringify(__DQ.state().demo)" },
  { "eval": "JSON.stringify(__DQ.economy())" },

  { "note": "THE SHOP: the greeting and Buy/Sell/Leave land together" },
  { "eval": "__DQ.shop('puddlewick_shop')" },
  { "waitFor": "__DQ.state().shop.open === true", "timeout": 10000 },
  { "wait": 1100 },
  { "shot": "02-shop-greeting" },
  { "eval": "__DQ.shopPick('buy')" },
  { "wait": 1300 },
  { "shot": "03-the-stock-list" },
  { "eval": "JSON.stringify(__DQ.state().shop.stock)" },
  { "eval": "JSON.stringify(__DQ.state().shop.windows)" },
  { "key": "ArrowDown", "hold": 140 },
  { "wait": 300 },
  { "key": "ArrowDown", "hold": 140 },
  { "wait": 600 },
  { "shot": "04-copper-sword-preview" },
  { "eval": "__DQ.state().shop.cursor" },

  { "note": "first the cheap stick, so the sword can be bought with the stick in part-exchange. Every answer is given by name (shopPick reads whatever line is up first, then walks the cursor), so the beats cannot drift." },
  { "eval": "__DQ.shopPick('cypress_stick')" },
  { "wait": 1100 },
  { "eval": "__DQ.shopPick('yes')" },
  { "wait": 1600 },
  { "eval": "__DQ.shopPick('yes')" },
  { "wait": 1600 },
  { "note": "the Wooden Sword he came in with is not anybody's to buy, so it simply goes in the bag" },
  { "eval": "JSON.stringify(__DQ.state().shop.party)" },
  { "eval": "JSON.stringify(__DQ.state().shop.bag)" },
  { "eval": "__DQ.state().shop.gold" },

  { "note": "now the sword: I'll take it, the gold counts down, then put it on, then the stick goes back over the counter" },
  { "eval": "__DQ.shopPick('copper_sword')" },
  { "wait": 1000 },
  { "shot": "05-ill-take-it" },
  { "eval": "__DQ.shopPick('yes')" },
  { "wait": 700 },
  { "shot": "06-gold-counted-down" },
  { "eval": "__DQ.state().shop.gold" },
  { "wait": 900 },
  { "shot": "07-shall-he-put-it-on" },
  { "eval": "__DQ.shopPick('yes')" },
  { "wait": 1000 },
  { "shot": "08-he-puts-it-on" },
  { "wait": 900 },
  { "shot": "09-part-exchange" },
  { "eval": "__DQ.state().shop.gold" },
  { "note": "keep the stick this time, so the Sell list has something he has outgrown in it" },
  { "eval": "__DQ.shopPick('no')" },
  { "wait": 1400 },
  { "eval": "JSON.stringify(__DQ.state().shop.party)" },
  { "eval": "__DQ.state().shop.gold" },
  { "shot": "10-after-the-buy" },

  { "note": "SELL: the bag, and a generous price for what he has outgrown. One cancel is all it takes to come back out of the Buy list to Buy / Sell / Leave." },
  { "eval": "__DQ.shopBack(1)" },
  { "wait": 900 },
  { "eval": "__DQ.shopPick('sell')" },
  { "wait": 1200 },
  { "shot": "11-the-bag" },
  { "eval": "JSON.stringify(__DQ.state().shop.bag)" },
  { "eval": "__DQ.shopPick('cypress_stick')" },
  { "wait": 1100 },
  { "shot": "12-ill-give-you" },
  { "eval": "__DQ.shopPick('yes')" },
  { "wait": 1200 },
  { "shot": "13-sold" },
  { "eval": "__DQ.state().shop.gold" },
  { "eval": "__DQ.shopBack(1)" },
  { "wait": 900 },
  { "eval": "__DQ.shopPick('leave')" },
  { "wait": 1200 },
  { "shot": "14-farewell" },
  { "eval": "__DQ.shopClose()" },
  { "waitFor": "__DQ.state().shop.open === false", "timeout": 8000 },
  { "wait": 700 },

  { "note": "OUT OF MONEY: the line a child hears when the purse is nearly empty. The purse is set again once the list is up, so nothing a pending animation does can make this beat affordable." },
  { "eval": "__DQ.shopClose()" },
  { "wait": 700 },
  { "eval": "__DQ.purse(3)" },
  { "eval": "__DQ.shop('puddlewick_shop')" },
  { "waitFor": "__DQ.state().shop.open === true", "timeout": 10000 },
  { "wait": 1000 },
  { "eval": "__DQ.shopPick('buy')" },
  { "wait": 1200 },
  { "eval": "__DQ.purse(3)" },
  { "eval": "__DQ.shopPick('copper_sword')" },
  { "wait": 1400 },
  { "shot": "15-out-of-money" },
  { "eval": "JSON.stringify({gold: __DQ.state().shop.gold, covered: __DQ.state().shop.covered, offscreen: __DQ.state().shop.offscreen})" },
  { "eval": "__DQ.shopClose()" },
  { "waitFor": "__DQ.state().shop.open === false", "timeout": 8000 },
  { "wait": 700 },

  { "note": "THE INN: price by party size, Sleep well, the fade, the jingle, mended" },
  { "eval": "__DQ.purse(300)" },
  { "eval": "JSON.stringify(__DQ.hurt(0.4))" },
  { "eval": "__DQ.shop('puddlewick_inn')" },
  { "waitFor": "__DQ.state().shop.open === true && __DQ.state().shop.id === 'puddlewick_inn'", "timeout": 10000 },
  { "wait": 1200 },
  { "shot": "16-inn-price" },
  { "eval": "__DQ.state().shop.price" },
  { "press": "Enter", "times": 1, "delay": 900 },
  { "wait": 900 },
  { "shot": "17-sleep-well" },
  { "press": "Enter", "times": 1, "delay": 900 },
  { "wait": 1500 },
  { "shot": "18-the-night" },
  { "wait": 1500 },
  { "shot": "19-mended-in-their-beds" },
  { "eval": "JSON.stringify(__DQ.state().shop.party.map(m => m.name + ' ' + m.hp))" },
  { "wait": 2400 },
  { "shot": "19b-morning" },
  { "eval": "__DQ.state().shop.stage" },
  { "eval": "__DQ.state().shop.gold" },
  { "press": "Enter", "times": 2, "delay": 700 },
  { "wait": 900 },

  { "note": "THE CHURCH: the priest passes on the boss advice, then the mending, the book, the page" },
  { "eval": "JSON.stringify(__DQ.hurt(0.35))" },
  { "eval": "JSON.stringify(__DQ.helperAdvice())" },
  { "eval": "__DQ.shop('puddlewick_shrine')" },
  { "waitFor": "__DQ.state().shop.open === true && __DQ.state().shop.id === 'puddlewick_shrine'", "timeout": 10000 },
  { "wait": 1400 },
  { "shot": "19c-the-priest-passes-on-the-advice" },
  { "press": "Enter", "times": 2, "delay": 800 },
  { "wait": 1400 },
  { "shot": "20-the-book-the-blessing-the-quiet" },
  { "eval": "JSON.stringify(__DQ.state().shop.windows)" },
  { "eval": "__DQ.shopPick('heal')" },
  { "wait": 1500 },
  { "shot": "20b-there-hold-still" },
  { "press": "Enter", "times": 3, "delay": 700 },
  { "wait": 1000 },
  { "eval": "__DQ.shopPick('save')" },
  { "wait": 1300 },
  { "shot": "21-which-page" },
  { "eval": "__DQ.shopPick('1')" },
  { "wait": 1200 },
  { "shot": "22-write-it-down" },
  { "press": "Enter", "times": 1, "delay": 1000 },
  { "wait": 1500 },
  { "shot": "23-the-tale-is-written" },
  { "eval": "JSON.stringify(Object.keys(localStorage).filter(k => k.indexOf('dqv.save') === 0))" },
  { "press": "Enter", "times": 3, "delay": 800 },
  { "wait": 1000 },
  { "shot": "24-the-priest-again" },
  { "note": "CALLING SOMEBODY BACK: free, and they wake up with half their HP" },
  { "eval": "JSON.stringify(__DQ.fell())" },
  { "eval": "__DQ.shopPick('revive')" },
  { "wait": 1500 },
  { "shot": "24b-was-i-asleep" },
  { "eval": "JSON.stringify(__DQ.state().shop.party.map(m => m.name + ' ' + m.hp))" },
  { "press": "Enter", "times": 2, "delay": 800 },
  { "wait": 1000 },
  { "eval": "__DQ.shopPick('leave')" },
  { "wait": 1400 },
  { "shot": "25-come-back-muddy" },
  { "eval": "__DQ.shopClose()" },
  { "waitFor": "__DQ.state().shop.open === false", "timeout": 8000 },
  { "wait": 700 },

  { "note": "THE BANK: gold in hundreds" },
  { "eval": "__DQ.shop('saltmarrow_bank')" },
  { "waitFor": "__DQ.state().shop.open === true && __DQ.state().shop.id === 'saltmarrow_bank'", "timeout": 10000 },
  { "wait": 1200 },
  { "shot": "26-the-bank" },
  { "eval": "__DQ.shopPick('in')" },
  { "wait": 1200 },
  { "eval": "__DQ.shopPick('1')" },
  { "wait": 1300 },
  { "shot": "27-gold-behind-the-counter" },
  { "eval": "JSON.stringify({held: __DQ.state().shop.held, gold: __DQ.state().shop.gold})" },
  { "press": "Enter", "times": 2, "delay": 700 },
  { "wait": 800 },
  { "eval": "__DQ.shopPick('leave')" },
  { "wait": 1300 },
  { "eval": "__DQ.shopClose()" },
  { "waitFor": "__DQ.state().shop.open === false", "timeout": 8000 },
  { "wait": 900 },
  { "shot": "28-back-on-the-green" },

  { "eval": "__DQ.shopBack(4)" },
  { "wait": 900 },
  { "eval": "JSON.stringify(__DQ.state().shop)" },
  { "eval": "JSON.stringify(__DQ.errors.slice(0,4))" },
  { "eval": "__DQ.economyAudit().then(a => JSON.stringify({ok: a.ok, earned: a.earned, kit: a.kitFresh, soldBack: a.soldBack, passed: a.passedDownValue, worst: a.worstPurse, left: a.leftAtTheEnd}))" },
  { "eval": "__DQ.economyAudit().then(a => JSON.stringify(a.rows.map(r => r.leg + ': kit ' + r.kit + ' left ' + r.left)))" },
  { "eval": "__DQ.economyAudit().then(a => { window.__auditOk = a.ok && a.worstPurse >= 0; return window.__auditOk; })" },
  { "wait": 300 },
  { "assert": "__DQ.errors.length===0", "msg": "no runtime errors" },
  { "assert": "__DQ.state().fps >= 55", "msg": "55+ fps" },
  { "assert": "__DQ.economy().ok === true", "msg": "every leg affords its next big buy" },
  { "assert": "window.__auditOk === true", "msg": "the whole family's kit is affordable leg by leg" },
  { "assert": "__DQ.state().shop.open === false", "msg": "the counter closes and gives the field back" },
  { "assert": "Object.keys(localStorage).some(k => k.indexOf('dqv.save.1') === 0)", "msg": "the church wrote a tale" }
] }
