   "eval": "JSON.stringify((()=>{const c=document.querySelector('canvas');const g=document.createElement('canvas');g.width=c.width;g.height=c.height;const x=g.getContext('2d');x.drawImage(c,0,0);const d=x.getImageData(0,0,g.width,g.height).data;let mag=0,sat=0,n=0;const hits=[];for(let i=0;i<d.length;i+=4){const r=d[i],gg=d[i+1],b=d[i+2];n++;if(r>150&&b>150&&gg<110&&Math.min(r,b)-gg>60){mag++;if(hits.length<6)hits.push([((i/4)%g.width),Math.floor((i/4)/g.width),r,gg,b]);}const mx=Math.max(r,gg,b),mn=Math.min(r,gg,b);if(mx>200&&mx-mn>170)sat++;}return{w:g.width,h:g.height,px:n,magenta:mag,magentaPct:+(100*mag/n).toFixed(4),hiSat:sat,hiSatPct:+(100*sat/n).toFixed(3),samples:hits};})())"
