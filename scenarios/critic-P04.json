{ "name": "critic-P04 — blind audit of PROPS & SET DRESSING, round 1",
  "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 40000},
  {"wait": 2500},

  {"note": "dual-mode helper: in the demo drive named views, in /index.html drive the hero + camera"},
  {"eval": "(window.__C = { demo: typeof __DQ.view === 'function', go: function (v, x, z, deg, dist) { if (this.demo) { __DQ.view(v); } else { __DQ.teleport('meadow', x, z); __DQ.cameraOrbit(deg); if (dist !== undefined) __DQ.cameraZoom(dist); } return this.demo ? ('view:' + v) : ('at ' + x + ',' + z + ' facing ' + deg); } }, window.__C.demo ? 'DEMO MODE' : 'GAME MODE')"},

  {"note": "A. the frame a child sees the second the world appears — nothing touched"},
  {"shot": "01-as-it-opens"},
  {"eval": "JSON.stringify({scene:__DQ.state().scene, map:__DQ.state().map && __DQ.state().map.id, tod:__DQ.state().timeOfDay, fps:__DQ.state().fps})"},
  {"eval": "JSON.stringify(__DQ.budget && __DQ.budget()).slice(0,240)"},

  {"note": "B. the set-dressing census — what actually exists, by kind"},
  {"eval": "Object.entries((((__DQ.state().field||__DQ.state().demo||{}).view)||{}).counts||{}).slice(0,11).map(e=>e[0]+'='+e[1]).join(' ')"},
  {"eval": "Object.entries((((__DQ.state().field||__DQ.state().demo||{}).view)||{}).counts||{}).slice(11).map(e=>e[0]+'='+e[1]).join(' ')"},
  {"eval": "JSON.stringify((((__DQ.state().field||__DQ.state().demo||{}).view)||{}).grove || null)"},
  {"eval": "JSON.stringify({props:(__DQ.state().map||{}).props, inter:(__DQ.state().map||{}).interactables, coll:(__DQ.state().map||{}).colliders, npcs:(__DQ.state().map||{}).npcs, chests:(__DQ.state().map||{}).chests})"},

  {"note": "C. walk to every edge and LOOK OUT — is there a world out there or a wall?"},
  {"eval": "__C.go('rim', 0, -34, 0, 10.5)"}, {"wait": 2200}, {"shot": "02-north-edge-looking-out"},
  {"eval": "__DQ.cameraOrbit(180)"}, {"wait": 1600}, {"shot": "03-north-edge-looking-back-in"},
  {"eval": "__C.go('hills', 34, 0, 270, 10.5)"}, {"wait": 2200}, {"shot": "04-east-edge-looking-out"},
  {"eval": "__DQ.cameraOrbit(90)"}, {"wait": 1600}, {"shot": "05-east-edge-looking-back-in"},
  {"eval": "__C.go('hedge', 0, 34, 180, 10.5)"}, {"wait": 2200}, {"shot": "06-south-edge-looking-out"},
  {"eval": "__DQ.cameraOrbit(0)"}, {"wait": 1600}, {"shot": "07-south-edge-looking-back-in"},
  {"eval": "__C.go('rim', -34, 0, 90, 10.5)"}, {"wait": 2200}, {"shot": "08-west-edge-looking-out"},
  {"eval": "__DQ.cameraOrbit(270)"}, {"wait": 1600}, {"shot": "09-west-edge-looking-back-in"},
  {"eval": "JSON.stringify({pos:[(__DQ.state().player||{}).x,(__DQ.state().player||{}).z], blocked:(__DQ.state().player||{}).blocked})"},

  {"note": "D. the inhabited middle — cottage yard, the working props, the lane"},
  {"eval": "__C.go('yard', -10, 10, 60, 9)"}, {"wait": 2200}, {"shot": "10-cottage-yard"},
  {"eval": "__C.go('well', -4, 6, 150, 7)"}, {"wait": 2000}, {"shot": "11-well-and-neighbours"},
  {"eval": "__C.go('scarecrow', 12, -8, 200, 8)"}, {"wait": 2000}, {"shot": "12-field-props"},
  {"eval": "__C.go('orchard', 18, 12, 300, 8)"}, {"wait": 2000}, {"shot": "13-orchard-side"},
  {"eval": "__C.go('pond', -22, -4, 200, 9)"}, {"wait": 2200}, {"shot": "14-pond"},
  {"eval": "__C.go('bridge', 2, -12, 0, 8)"}, {"wait": 2000}, {"shot": "15-bridge-and-water"},

  {"note": "E. FLOATING TEST — put the lens near the ground so every base is at a grazing angle"},
  {"eval": "__C.go('yard', -10, 10, 60, 4)"}, {"wait": 1400},
  {"eval": "JSON.stringify(__DQ.cameraRig && __DQ.cameraRig({pitch: 4})).slice(0,200)"}, {"wait": 1400}, {"shot": "16-grazing-angle-yard"},
  {"eval": "__C.go('scarecrow', 12, -8, 200, 4)"}, {"wait": 1600}, {"shot": "17-grazing-angle-field"},
  {"eval": "__C.go('well', -4, 6, 150, 3.5)"}, {"wait": 1600}, {"shot": "18-grazing-angle-prop-bases"},
  {"eval": "JSON.stringify(__DQ.shadows && __DQ.shadows(false))"}, {"wait": 1200}, {"shot": "19-same-frame-shadows-off"},
  {"eval": "JSON.stringify(__DQ.shadows && __DQ.shadows(true))"}, {"wait": 1200}, {"shot": "20-same-frame-shadows-on"},
  {"eval": "JSON.stringify(__DQ.cameraRig && __DQ.cameraRig({pitch: 30})).slice(0,120)"}, {"wait": 1200},

  {"note": "F. Z-FIGHTING / CLIPPING — steep top-down where decals and ground meet"},
  {"eval": "__C.go('wide', 0, 0, 0, 14)"}, {"wait": 1600},
  {"eval": "JSON.stringify(__DQ.cameraRig && __DQ.cameraRig({pitch: 70})).slice(0,120)"}, {"wait": 1600}, {"shot": "21-topdown-path-decals"},
  {"eval": "__DQ.cameraZoom(30)"}, {"wait": 2000}, {"shot": "22-topdown-whole-vale"},
  {"eval": "JSON.stringify(__DQ.cameraRig && __DQ.cameraRig({pitch: 12})).slice(0,120)"},
  {"eval": "__DQ.cameraZoom(10.5)"}, {"wait": 1600},

  {"note": "G. REPETITION TEST — five corners, identical camera. One place copied five times, or five places?"},
  {"eval": "__C.go('wide', -26, -26, 45, 11)"}, {"wait": 2000}, {"shot": "23-repeat-NW"},
  {"eval": "__C.go('wide', 26, -26, 315, 11)"}, {"wait": 2000}, {"shot": "24-repeat-NE"},
  {"eval": "__C.go('wide', 26, 26, 225, 11)"}, {"wait": 2000}, {"shot": "25-repeat-SE"},
  {"eval": "__C.go('wide', -26, 26, 135, 11)"}, {"wait": 2000}, {"shot": "26-repeat-SW"},
  {"eval": "__C.go('wide', 0, 0, 0, 11)"}, {"wait": 2000}, {"shot": "27-repeat-centre"},

  {"note": "H. MOTION TEST — camera and hero dead still, seven seconds. Anything still here is a statue."},
  {"eval": "__C.go('life', -10, 6, 45, 9)"}, {"wait": 2500},
  {"burst": {"name": "28-motion-hold", "count": 7, "interval": 1000}},

  {"note": "I. SMOKE — is anything coming out of a chimney, and does it drift?"},
  {"eval": "__C.go('yard', -12, 14, 40, 7)"}, {"wait": 2000},
  {"eval": "JSON.stringify(__DQ.cameraRig && __DQ.cameraRig({pitch: 26})).slice(0,120)"}, {"wait": 1200},
  {"burst": {"name": "29-chimney-smoke", "count": 5, "interval": 1100}},

  {"note": "J. BUTTERFLIES / BIRDS — close on the flowers, five frames"},
  {"eval": "__C.go('birds', 6, 4, 90, 5)"}, {"wait": 2000},
  {"burst": {"name": "30-small-life", "count": 5, "interval": 700}},
  {"eval": "JSON.stringify(__DQ.cameraRig && __DQ.cameraRig({pitch: 12})).slice(0,120)"},
  {"eval": "__DQ.cameraZoom(10.5)"}, {"wait": 1400},

  {"note": "K. does the set dressing survive the evening? lit windows, lanterns, smoke against a dark sky"},
  {"eval": "__C.go('yard', -10, 10, 60, 10)"}, {"wait": 1600},
  {"eval": "__DQ.timeOfDay(18.6)"}, {"wait": 2000}, {"shot": "31-dusk-yard"},
  {"eval": "__DQ.timeOfDay(21.5)"}, {"wait": 2000}, {"shot": "32-night-yard"},
  {"eval": "__C.go('wide', 0, 0, 0, 16)"}, {"wait": 2000}, {"shot": "33-night-wide"},
  {"eval": "__DQ.timeOfDay(12)"}, {"wait": 1600},

  {"note": "L. what the triangles are actually spent on"},
  {"eval": "JSON.stringify(__DQ.meshStats && __DQ.meshStats(10)).slice(0,380)"},
  {"eval": "JSON.stringify({fps:__DQ.state().fps, errors:__DQ.errors.length})"},
  {"shot": "34-final"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"},
  {"assert": "__DQ.state().fps >= 55", "msg": "fps >= 55"},
  {"assert": "__DQ.screenshotReady() === true", "msg": "screenshotReady"}
]}
