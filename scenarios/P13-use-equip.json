{
  "name": "P13 Use warps + Equip blurb",
  "steps": [
    { "waitFor": "window.__DQ && __DQ.ready", "timeout": 45000 },
    { "wait": 400 },
    { "eval": "(()=>{const s=__DQ.state().scene;if(s==='title'&&__DQ.title){__DQ.title('game');return 'leaving';}return 'ok';})()" },
    { "waitFor": "__DQ.state().scene==='field'", "timeout": 45000 },
    { "wait": 800 },

    { "note": "Equip opens m-blurb with the item's own words" },
    { "eval": "__DQ.give('copper_sword',1)" },
    { "eval": "__DQ.menuOpen()" },
    { "waitFor": "__DQ.state().menu.open===true", "timeout": 8000 },
    { "wait": 500 },
    { "eval": "__DQ.menuPick('equip')" },
    { "wait": 900 },
    { "eval": "__DQ.menuChoose('m-slots','weapon')" },
    { "wait": 800 },
    { "eval": "JSON.stringify({windows:__DQ.state().menu.windows, hasBlurb:__DQ.state().menu.windows.includes('m-blurb'), blurb:(()=>{const el=document.querySelector('.dq-win.dq-blurb'); return el?(el.innerText||'').slice(0,140):'';})()})" },
    { "assert": "__DQ.state().menu.windows.includes('m-blurb')", "msg": "Equip shows m-blurb" },
    { "assert": "!!document.querySelector('.dq-win.dq-blurb') && /sword|sulk|Attack|wear/i.test(document.querySelector('.dq-win.dq-blurb').innerText||'')", "msg": "Equip blurb has item words" },
    { "eval": "__DQ.menuOpen(false)" },
    { "wait": 700 },

    { "note": "Homing Feather warps to the chapel forecourt from meadow" },
    { "eval": "(()=>{__DQ.teleport('meadow');return 'ok';})()" },
    { "waitFor": "__DQ.state().map && __DQ.state().map.id==='meadow'", "timeout": 15000 },
    { "wait": 700 },
    { "eval": "__DQ.give('homing_feather',1)" },
    { "eval": "__DQ.menuOpen()" },
    { "waitFor": "__DQ.state().menu.open===true", "timeout": 8000 },
    { "wait": 400 },
    { "eval": "__DQ.menuPick('items')" },
    { "wait": 700 },
    { "eval": "__DQ.menuChoose('m-whose','bag')" },
    { "wait": 700 },
    { "eval": "__DQ.menuChoose('m-bag','homing_feather')" },
    { "wait": 500 },
    { "eval": "__DQ.menuChoose('m-itemact','use')" },
    { "eval": "(async()=>{const sleep=ms=>new Promise(r=>setTimeout(r,ms));for(let i=0;i<20;i++){try{__DQ.press('confirm');}catch(_){ }await sleep(280);const m=__DQ.state().map;if(m&&m.id==='puddlewick')return 'landed';}return __DQ.state().map&&__DQ.state().map.id;})()" },
    { "wait": 600 },
    { "eval": "JSON.stringify({map:__DQ.state().map.id,x:__DQ.state().player&&__DQ.state().player.x,z:__DQ.state().player&&__DQ.state().player.z})" },
    { "assert": "__DQ.state().map.id==='puddlewick'", "msg": "Homing Feather lands in Puddlewick" },

    { "note": "Retreat Bell from cobwell walks you out via an exit" },
    { "eval": "(()=>{__DQ.teleport('cobwell_manor');return 'ok';})()" },
    { "waitFor": "__DQ.state().map && __DQ.state().map.id==='cobwell_manor'", "timeout": 20000 },
    { "wait": 900 },
    { "eval": "__DQ.give('retreat_bell',1)" },
    { "eval": "__DQ.menuOpen()" },
    { "waitFor": "__DQ.state().menu.open===true", "timeout": 8000 },
    { "wait": 400 },
    { "eval": "__DQ.menuPick('items')" },
    { "wait": 700 },
    { "eval": "__DQ.menuChoose('m-whose','bag')" },
    { "wait": 700 },
    { "eval": "__DQ.menuChoose('m-bag','retreat_bell')" },
    { "wait": 500 },
    { "eval": "__DQ.menuChoose('m-itemact','use')" },
    { "eval": "(async()=>{const sleep=ms=>new Promise(r=>setTimeout(r,ms));for(let i=0;i<20;i++){try{__DQ.press('confirm');}catch(_){ }await sleep(280);const m=__DQ.state().map;if(m&&m.id!=='cobwell_manor')return m.id;}return __DQ.state().map&&__DQ.state().map.id;})()" },
    { "wait": 600 },
    { "eval": "JSON.stringify({map:__DQ.state().map.id})" },
    { "assert": "__DQ.state().map.id!=='cobwell_manor'", "msg": "Retreat Bell leaves the manor" },
    { "assert": "__DQ.errors.length===0", "msg": "no errors" }
  ]
}
