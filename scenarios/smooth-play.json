{ "name": "smooth — play the whole slice like a ten-year-old (walk, orbit, talk, menus, edges) with the real hero", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 40000},
  {"wait": 2500},
  {"shot": "boot"},
  {"eval": "({scene: __DQ.state().scene, stack: __DQ.state().sceneStack, boot: __DQ.state().boot, map: __DQ.state().map, audio: __DQ.state().audio, stubs: __DQ.state().stubs, hero: __DQ.state().player.anim})"},
  {"assert": "__DQ.state().boot.phase === 'running' && __DQ.state().boot.hero === 'chars'", "msg": "booted with the real Bram"},
  {"assert": "Object.values(__DQ.state().boot.plugins).every(v => v === 'installed')", "msg": "every plugin installed"},
  {"assert": "__DQ.state().map.layers.join() === 'npcs,chests' && __DQ.state().map.missingLines.length === 0", "msg": "meadow layers merged, no missing lines"},

  {"note": "first gesture: a key press should unlock audio"},
  {"press": "ArrowUp", "times": 1, "delay": 400},
  {"wait": 1500},
  {"eval": "({audio: __DQ.state().audio})"},

  {"note": "walk up the lane to the signpost with the real keyboard, turn to it, read it"},
  {"key": "ArrowUp", "hold": 2500},
  {"shot": "lane-north"},
  {"press": "ArrowRight", "delay": 500},
  {"eval": "__DQ.state().player"},
  {"press": "Enter", "delay": 1400},
  {"shot": "sign-talk"},
  {"eval": "(async () => { const A = (await import('/src/audio/audio.js')).Audio.state(); const s = __DQ.state().audio.sfx; return { last: s.last, holds: A.holds, ctx: A.ctxState }; })()"},
  {"assert": "__DQ.state().audio.sfx.last.some(id => id.startsWith('text_'))", "msg": "glyph ticks play through Sfx in the speaker's voice"},
  {"eval": "({scene: __DQ.state().scene, dialogue: __DQ.state().dialogue, audio: __DQ.state().audio})"},
  {"press": "Enter", "times": 6, "delay": 600},
  {"wait": 800},
  {"eval": "({scene: __DQ.state().scene})"},

  {"note": "walk toward the camera and sideways: the real hero must face where he walks"},
  {"eval": "__DQ.teleport('meadow', 2, 2)"},
  {"eval": "__DQ.cameraAuto(false)"},
  {"eval": "__DQ.cameraOrbit(0)"},
  {"wait": 1200},
  {"eval": "__DQ.hold('down', 1400)"},
  {"wait": 700},
  {"burst": {"name": "walk-toward-camera", "count": 3, "interval": 110}},
  {"wait": 900},
  {"eval": "__DQ.hold('left', 1400)"},
  {"wait": 700},
  {"burst": {"name": "walk-left", "count": 2, "interval": 110}},
  {"wait": 900},
  {"eval": "__DQ.hold('run', 1500)"},
  {"eval": "__DQ.hold('up', 1500)"},
  {"wait": 800},
  {"burst": {"name": "run-away", "count": 2, "interval": 110}},
  {"eval": "__DQ.cameraAuto(true)"},
  {"wait": 900},
  {"eval": "__DQ.state().player"},

  {"note": "cross the bridge toward the village"},
  {"eval": "__DQ.teleport('meadow', -1.2, -3)"},
  {"eval": "__DQ.cameraOrbit(0)"},
  {"wait": 900},
  {"key": "ArrowUp", "hold": 2600},
  {"shot": "on-the-bridge"},
  {"eval": "__DQ.state().player"},
  {"key": "ArrowUp", "hold": 1500},
  {"key": "ArrowRight", "hold": 1800},
  {"shot": "past-the-bridge"},

  {"note": "the village lane end (sheep)"},
  {"eval": "__DQ.teleport('meadow', 16.5, -27)"},
  {"eval": "__DQ.cameraOrbit(20)"},
  {"wait": 900},
  {"key": "ArrowUp", "hold": 2500},
  {"wait": 800},
  {"shot": "village-lane-end"},
  {"eval": "({scene: __DQ.state().scene, dialogue: __DQ.state().dialogue, player: __DQ.state().player})"},
  {"press": "Enter", "times": 5, "delay": 500},

  {"note": "cottage door, sheep"},
  {"eval": "__DQ.teleport('meadow', -9.1, 0.9)"},
  {"eval": "__DQ.cameraOrbit(80)"},
  {"wait": 1000},
  {"eval": "__DQ.face(270)"},
  {"wait": 400},
  {"eval": "__DQ.state().player.near"},
  {"press": "Enter", "delay": 1600},
  {"shot": "cottage-door-talk"},
  {"eval": "({scene: __DQ.state().scene, dialogue: __DQ.state().dialogue && __DQ.state().dialogue.text})"},
  {"press": "Enter", "times": 4, "delay": 500},
  {"eval": "__DQ.teleport('meadow', -21, 9.5)"},
  {"eval": "__DQ.cameraOrbit(200)"},
  {"wait": 1000},
  {"eval": "__DQ.state().player.near"},
  {"press": "Enter", "delay": 1400},
  {"shot": "sheep-talk"},
  {"press": "Enter", "times": 4, "delay": 500},

  {"note": "open the menu, browse items and status, back out"},
  {"press": "Tab", "delay": 900},
  {"shot": "menu"},
  {"press": "ArrowDown", "delay": 250},
  {"press": "ArrowRight", "delay": 250},
  {"press": "Enter", "delay": 900},
  {"shot": "menu-items"},
  {"press": "Enter", "delay": 700},
  {"shot": "menu-item-use"},
  {"press": "Escape", "delay": 400},
  {"press": "Escape", "delay": 400},
  {"press": "ArrowLeft", "delay": 250},
  {"press": "Enter", "delay": 900},
  {"shot": "menu-status"},
  {"press": "Escape", "delay": 500},
  {"press": "Escape", "delay": 900},
  {"eval": "({scene: __DQ.state().scene, menu: __DQ.state().menu})"},
  {"press": "Tab", "delay": 700},
  {"press": "ArrowDown", "times": 2, "delay": 250},
  {"press": "ArrowRight", "delay": 250},
  {"press": "Enter", "delay": 1400},
  {"shot": "menu-search"},
  {"eval": "({scene: __DQ.state().scene, dialogue: __DQ.state().dialogue && __DQ.state().dialogue.text})"},
  {"press": "Enter", "times": 4, "delay": 500},

  {"note": "orbit all the way round in the middle of the vale"},
  {"eval": "__DQ.teleport('meadow', 2, 2)"},
  {"eval": "__DQ.cameraOrbit(0)"}, {"wait": 1200}, {"shot": "orbit-000"},
  {"eval": "__DQ.cameraOrbit(90)"}, {"wait": 1400}, {"shot": "orbit-090"},
  {"eval": "__DQ.cameraOrbit(180)"}, {"wait": 1400}, {"shot": "orbit-180"},
  {"eval": "__DQ.cameraOrbit(270)"}, {"wait": 1400}, {"shot": "orbit-270"},

  {"note": "run into the east lane end"},
  {"eval": "__DQ.teleport('meadow', 24, 3)"},
  {"eval": "__DQ.cameraOrbit(270)"},
  {"wait": 900},
  {"eval": "__DQ.hold('run', 3000)"},
  {"key": "ArrowUp", "hold": 3000},
  {"wait": 900},
  {"shot": "east-lane-end"},
  {"eval": "({scene: __DQ.state().scene, dialogue: __DQ.state().dialogue && __DQ.state().dialogue.text})"},
  {"press": "Enter", "times": 5, "delay": 500},

  {"note": "zoom in on the hero, from the front"},
  {"eval": "__DQ.teleport('meadow', 1.4, 19.2)"},
  {"eval": "__DQ.face(180)"},
  {"eval": "__DQ.cameraOrbit(180)"},
  {"eval": "__DQ.cameraZoom(4)"},
  {"wait": 1800},
  {"shot": "hero-close"},
  {"key": "ArrowRight", "hold": 900},
  {"burst": {"name": "hero-walk", "count": 3, "interval": 120}},
  {"eval": "__DQ.cameraZoom(10.5)"},
  {"wait": 600},

  {"eval": "({errors: __DQ.errors.slice(0, 12), fps: __DQ.state().fps, audio: __DQ.state().audio, stubs: __DQ.state().stubs, stack: __DQ.state().sceneStack, steps: __DQ.state().player.steps})"},
  {"assert": "__DQ.state().audio.theme === 'village' && __DQ.state().audio.ambience === 'amb_meadow'", "msg": "the meadow's CANON §9 theme and ambience are wanted"},
  {"assert": "__DQ.state().audio.sfx.played > 20", "msg": "footsteps, glyph ticks and menu blips reached Sfx"},
  {"assert": "__DQ.state().fps >= 55", "msg": ">= 55 fps"},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors during play"}
]}
