{ "name": "critic c2 — P02 sky / P03 terrain, measured in the REAL game", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 45000},
  {"waitFor": "__DQ.screenshotReady()", "timeout": 20000},
  {"wait": 7000},
  {"eval": "__DQ.timeOfDay(9)"},

  {"note": "A. what the shipped camera actually gives a child. pitch and horizon are the two numbers P02 gap 2 was opened on"},
  {"shot": "01-boot-clean"},
  {"eval": "JSON.stringify(__DQ.cameraRig())"},
  {"assert": "__DQ.cameraRig().frame.horizon > 200", "msg": "the horizon lands at least a third of the way down a 720 px frame (approved reference does)"},

  {"note": "B. the child has NO look-up. hold every plausible key and read the pitch back"},
  {"eval": "window.__pitch0 = __DQ.cameraRig().pitch"},
  {"key": "PageUp", "hold": 1500},
  {"key": "KeyR", "hold": 1200},
  {"key": "KeyQ", "hold": 1200},
  {"key": "Home", "hold": 1200},
  {"eval": "JSON.stringify([window.__pitch0, __DQ.cameraRig().pitch, __DQ.state().input.look])"},
  {"assert": "__DQ.cameraRig().pitch !== window.__pitch0", "msg": "some player input raises the camera pitch"},

  {"note": "C. orbit the plain gameplay camera through all eight bearings — is ANY of them a destination?"},
  {"eval": "__DQ.cameraOrbit(0)"}, {"wait": 1200}, {"shot": "02-n-000"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().filter(l=>l.onScreen).map(l=>[l.id,l.hiddenPct,l.visiblePx,l.visible,l.clipped]))"},
  {"eval": "__DQ.cameraOrbit(45)"}, {"wait": 1000}, {"shot": "03-ne-045"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().filter(l=>l.onScreen).map(l=>[l.id,l.hiddenPct,l.visiblePx,l.visible,l.clipped]))"},
  {"eval": "__DQ.cameraOrbit(90)"}, {"wait": 1000}, {"shot": "04-e-090"},
  {"eval": "__DQ.cameraOrbit(135)"}, {"wait": 1000}, {"shot": "05-se-135"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().filter(l=>l.onScreen).map(l=>[l.id,l.hiddenPct,l.visiblePx,l.visible,l.clipped]))"},
  {"eval": "__DQ.cameraOrbit(180)"}, {"wait": 1000}, {"shot": "06-s-180"},
  {"eval": "__DQ.cameraOrbit(225)"}, {"wait": 1000}, {"shot": "07-sw-225"},
  {"eval": "__DQ.cameraOrbit(270)"}, {"wait": 1000}, {"shot": "08-w-270"},
  {"eval": "__DQ.cameraOrbit(315)"}, {"wait": 1000}, {"shot": "09-nw-315"},
  {"assert": "__DQ.landmarkScreen().filter(l=>l.visible).length >= 1", "msg": "looking north-west there is still somewhere to go"},

  {"note": "D. the builder's OWN best camera per place. hiddenPct and the visible flag are the builder's own numbers"},
  {"eval": "__DQ.landmarkView('coddleston')"}, {"wait": 1600}, {"shot": "10-view-coddleston"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l=>l.id==='coddleston'))"},
  {"eval": "__DQ.landmarkView('saltmarrow')"}, {"wait": 1600}, {"shot": "11-view-saltmarrow"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l=>l.id==='saltmarrow'))"},
  {"assert": "__DQ.landmarkScreen().find(l=>l.id==='saltmarrow').visible", "msg": "Saltmarrow really renders down the lane the signpost names"},
  {"eval": "__DQ.landmarkView('puddlewick')"}, {"wait": 1600}, {"shot": "12-view-puddlewick"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l=>l.id==='puddlewick'))"},
  {"assert": "__DQ.landmarkScreen().find(l=>l.id==='puddlewick').visible", "msg": "Puddlewick really renders up the lane the signpost names"},
  {"eval": "__DQ.landmarkView('whispering_wood')"}, {"wait": 1600}, {"shot": "13-view-wood"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l=>l.id==='whispering_wood'))"},

  {"note": "E. stand somewhere else in the vale and aim at the castle — at (26,-8) one near tree fills the whole frame"},
  {"eval": "__DQ.teleport('meadow',12,8)"}, {"wait": 1400},
  {"eval": "__DQ.landmarkView('coddleston')"}, {"wait": 1600}, {"shot": "14-cod-from-12-8"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l=>l.id==='coddleston'))"},
  {"eval": "__DQ.teleport('meadow',26,-8)"}, {"wait": 1400},
  {"eval": "__DQ.landmarkView('coddleston')"}, {"wait": 1600}, {"shot": "15-cod-from-26-8"},
  {"eval": "JSON.stringify(__DQ.landmarkScreen().find(l=>l.id==='coddleston'))"},
  {"assert": "__DQ.landmarkScreen().find(l=>l.id==='coddleston').visiblePx > 22", "msg": "the castle is not wholly swallowed by one near tree"},

  {"note": "F. the destination really approaches — this half of P02 gap 1 passes"},
  {"eval": "__DQ.teleport('meadow',1.4,19.2)"}, {"wait": 1400},
  {"eval": "window.__d0 = __DQ.landmarks().find(l=>l.id==='coddleston').dist"},
  {"key": "ArrowUp", "hold": 6000}, {"wait": 600},
  {"eval": "JSON.stringify([window.__d0, __DQ.landmarks().find(l=>l.id==='coddleston').dist, __DQ.state().player.x, __DQ.state().player.z])"},

  {"note": "G. WHAT THE CAMERA IS THROWING AWAY. drop the pitch and the same spot is a Dragon Quest vista"},
  {"eval": "__DQ.teleport('meadow',1.4,19.2)"}, {"wait": 1200},
  {"eval": "__DQ.cameraOrbit(180)"}, {"wait": 1000},
  {"eval": "__DQ.cameraRig({pitch:4, dist:9})"}, {"wait": 1600}, {"shot": "16-what-pitch-4-shows"},
  {"eval": "__DQ.cameraRig({pitch:-16, lookUp:6, fov:52})"}, {"wait": 1600}, {"shot": "17-sky-noon"},

  {"note": "H. the clouds really cross the sky now — best-fit shift, not the CPU counter"},
  {"eval": "window.__p0 = __DQ.cloudDrift().phaseRad"},
  {"shot": "18-cloud-t0"},
  {"wait": 30000}, {"shot": "19-cloud-t30"},
  {"wait": 30000}, {"shot": "20-cloud-t60"},
  {"eval": "JSON.stringify([window.__p0, __DQ.cloudDrift()])"},
  {"eval": "__DQ.cloudDrift(10)"}, {"wait": 1000}, {"shot": "21-drift10-t0"},
  {"wait": 12000}, {"shot": "22-drift10-t12"},
  {"eval": "__DQ.cloudDrift(1)"},

  {"note": "I. the hours, seen from a camera that can actually see them"},
  {"eval": "__DQ.timeOfDay(18.6)"}, {"wait": 1400}, {"shot": "23-dusk-sky"},
  {"eval": "__DQ.timeOfDay(22)"}, {"wait": 1400}, {"shot": "24-night-sky"},
  {"eval": "__DQ.timeOfDay(6.6)"}, {"wait": 1400}, {"shot": "25-dawn-sky"},
  {"eval": "__DQ.cameraRig({pitch:26, lookUp:1.577, fov:47})"}, {"wait": 1200},
  {"eval": "__DQ.timeOfDay(18.6)"}, {"wait": 1400}, {"shot": "26-dusk-as-played"},
  {"eval": "__DQ.timeOfDay(22)"}, {"wait": 1400}, {"shot": "27-night-as-played"},
  {"eval": "__DQ.timeOfDay(11)"}, {"wait": 1200},

  {"note": "J. P03 — the near ground. painterly grass, soft lane edges, grounded props: this part is good"},
  {"eval": "__DQ.teleport('meadow',1.4,19.2)"}, {"wait": 1400}, {"eval": "__DQ.cameraOrbit(0)"}, {"wait": 1200},
  {"eval": "__DQ.cameraRig({pitch:40, dist:3.2})"}, {"wait": 1600}, {"shot": "28-grass-close"},
  {"eval": "__DQ.cameraRig({pitch:70, dist:6})"}, {"wait": 1600}, {"shot": "29-grass-topdown"},
  {"eval": "__DQ.cameraRig({pitch:26, dist:5.971, lookUp:1.577})"}, {"wait": 1200},

  {"note": "K. P03 — the bare-earth blobs. count brown in the lower frame of these four and compare 13.5 pct on docs/approved/field-opening.png"},
  {"eval": "__DQ.cameraOrbit(135)"}, {"wait": 1400}, {"shot": "30-mud-se"},
  {"eval": "__DQ.cameraOrbit(270)"}, {"wait": 1400}, {"shot": "31-mud-w"},
  {"eval": "__DQ.cameraOrbit(180)"}, {"wait": 1400}, {"shot": "32-mud-s"},

  {"note": "L. P03 — the Beck. water-only windows against grass-only windows in the same frame"},
  {"eval": "__DQ.teleport('meadow',12.5,-12.5)"}, {"wait": 1600}, {"eval": "__DQ.cameraOrbit(20)"}, {"wait": 1800}, {"shot": "33-beck-edge"},
  {"eval": "__DQ.teleport('meadow',7.5,-14.2)"}, {"wait": 1600}, {"eval": "__DQ.cameraOrbit(90)"}, {"wait": 2000}, {"shot": "34-wading"},
  {"eval": "JSON.stringify([__DQ.state().player.ground, __DQ.state().player.y])"},
  {"eval": "__DQ.cameraRig({pitch:55, dist:11})"}, {"wait": 1800}, {"shot": "35-beck-above"},
  {"eval": "__DQ.cameraRig({pitch:6, dist:8})"}, {"wait": 1800}, {"shot": "36-beck-grazing"},
  {"eval": "__DQ.cameraRig({pitch:26, dist:6, lookUp:1.577})"}, {"wait": 1200},

  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"},
  {"assert": "__DQ.state().fps >= 45", "msg": "fps >= 45"}
]}
