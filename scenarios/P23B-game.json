{ "name": "P23B in the real game — walk the vale to the belfry", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 40000},
  {"wait": 1200},
  {"note": "the whole wider world must be registered in /index.html, not only in the demo"},
  {"eval": "__DQ.listMaps().sort()"},
  {"eval": "__DQ.links()"},
  {"note": "ON FOOT out of the vale. At camera orbit 0, ArrowUp walks -z and ArrowRight walks +x (measured)."},
  {"eval": "__DQ.teleport('meadow', __DQ.links().valeTrigger.x - 11, __DQ.links().valeTrigger.z)"},
  {"eval": "__DQ.cameraOrbit(0, true)"}, {"wait": 800}, {"shot": "01-vale-east-lane"},
  {"eval": "({ map: __DQ.state().map.id, at: __DQ.state().player.x.toFixed(1) + ',' + __DQ.state().player.z.toFixed(1) })"},
  {"key": "ArrowRight", "hold": 4200}, {"wait": 1100},
  {"eval": "({ map: __DQ.state().map.id, at: __DQ.state().player.x.toFixed(1) + ',' + __DQ.state().player.z.toFixed(1) })"},
  {"shot": "02-walked-onto-the-road"},
  {"assert": "__DQ.state().map.id==='road_beck'", "msg": "walking east out of the vale really arrives on the Beck road"},
  {"note": "and on east, on foot, into Saltmarrow"},
  {"eval": "__DQ.teleport('road_beck', 18.4, -6.2)"},
  {"eval": "__DQ.cameraOrbit(0, true)"}, {"wait": 800},
  {"key": "ArrowRight", "hold": 4200}, {"wait": 1100},
  {"eval": "({ map: __DQ.state().map.id, at: __DQ.state().player.x.toFixed(1) + ',' + __DQ.state().player.z.toFixed(1) })"},
  {"shot": "03-walked-into-saltmarrow"},
  {"assert": "__DQ.state().map.id==='saltmarrow'", "msg": "the Beck road really arrives in Saltmarrow"},
  {"note": "the tide-mill door, on foot"},
  {"note": "the ground right outside the mill door must be walkable, and the doorway must fire"},
  {"eval": "__DQ.teleport('saltmarrow', -5.4, -3.8)"}, {"wait": 500},
  {"eval": "'outside the mill door: ' + __DQ.state().player.x.toFixed(2) + ',' + __DQ.state().player.z.toFixed(2) + ' ground=' + __DQ.state().player.ground"},
  {"eval": "__DQ.teleport('saltmarrow', -5.4, -1.8)"}, {"wait": 1400},
  {"eval": "({ map: __DQ.state().map.id })"},
  {"shot": "04-inside-the-mill"},
  {"assert": "__DQ.state().map.id==='saltmarrow_mill'", "msg": "the mill door is a real door"},
  {"note": "north out of Saltmarrow into the wood, on foot"},
  {"eval": "__DQ.teleport('saltmarrow', -2.7, -12.4)"},
  {"eval": "__DQ.cameraOrbit(0, true)"}, {"wait": 800},
  {"key": "ArrowUp", "hold": 3000}, {"wait": 1100},
  {"eval": "({ map: __DQ.state().map.id, at: __DQ.state().player.x.toFixed(1) + ',' + __DQ.state().player.z.toFixed(1) })"},
  {"shot": "05-walked-into-the-wood"},
  {"assert": "__DQ.state().map.id==='road_wood'", "msg": "Saltmarrow's north gate really arrives in the Whispering Wood"},
  {"note": "up the drive and through the manor's front door, on foot"},
  {"eval": "__DQ.teleport('road_wood', 0, -18.6)"},
  {"eval": "__DQ.cameraOrbit(0, true)"}, {"wait": 800},
  {"key": "ArrowUp", "hold": 1500}, {"wait": 800}, {"key": "ArrowUp", "hold": 1200}, {"wait": 1100},
  {"eval": "({ map: __DQ.state().map.id, at: __DQ.state().player.x.toFixed(1) + ',' + __DQ.state().player.z.toFixed(1) })"},
  {"shot": "06-inside-cobwell-manor"},
  {"assert": "__DQ.state().map.id==='cobwell_manor'", "msg": "the manor gates really open on the front hall"},
  {"note": "the portrait puzzle opens the two doors, then the Long Stair, the ballroom and the belfry"},
  {"eval": "__DQ.cobwell('portraits')"},
  {"eval": "__DQ.teleport('cobwell_manor', 0, -1.0)"},
  {"eval": "__DQ.cameraOrbit(0, true)"}, {"wait": 800},
  {"key": "ArrowUp", "hold": 1800}, {"wait": 1100},
  {"eval": "({ map: __DQ.state().map.id, at: __DQ.state().player.x.toFixed(1) + ',' + __DQ.state().player.z.toFixed(1) })"},
  {"shot": "07-the-ballroom"},
  {"assert": "__DQ.state().map.id==='cobwell_upper'", "msg": "the Long Stair really arrives on the ballroom floor"},
  {"eval": "__DQ.cobwell('dance')"},
  {"eval": "__DQ.teleport('cobwell_upper', 0, -6.4)"},
  {"eval": "__DQ.cameraOrbit(0, true)"}, {"wait": 800},
  {"key": "ArrowUp", "hold": 1800}, {"wait": 1100},
  {"eval": "({ map: __DQ.state().map.id, at: __DQ.state().player.x.toFixed(1) + ',' + __DQ.state().player.z.toFixed(1) })"},
  {"shot": "08-the-belfry"},
  {"assert": "__DQ.state().map.id==='cobwell_belfry'", "msg": "the belfry is reachable on foot from the vale"},
  {"note": "the boss door is armed and asks before it fights (encounter.js bossDoors)"},
  {"eval": "__DQ.state().encounter"},
  {"note": "and the way back out of the manor still works"},
  {"eval": "__DQ.teleport('cobwell_manor', 0, 18.4)"}, {"wait": 1200},
  {"eval": "({ map: __DQ.state().map.id })"},
  {"shot": "09-back-out-of-the-manor"},
  {"assert": "__DQ.state().map.id==='road_wood'", "msg": "the manor's front door lets you back out"},
  {"eval": "__DQ.state().fps"},
  {"assert": "__DQ.errors.length===0", "msg": "no runtime errors walking the whole wider world in the real game"},
  {"assert": "__DQ.listMaps().includes('saltmarrow') && __DQ.listMaps().includes('cobwell_belfry')", "msg": "the wider world is in the real game's map index"}
]}
