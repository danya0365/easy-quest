{ "name": "P04 props & set dressing — live in /index.html (meadow)", "steps": [
  {"waitFor": "window.__DQ && __DQ.ready", "timeout": 40000},
  {"wait": 2500},
  {"assert": "__DQ.state().scene === 'field' && __DQ.state().map.id === 'meadow'", "msg": "boots into the meadow"},
  {"shot": "opening"},
  {"eval": "__DQ.budget()"},
  {"eval": "(__DQ.state().field.view || {}).counts"},
  {"assert": "(__DQ.state().field.view.counts.contactShadows || 0) > 400", "msg": "every standing prop in the vale is planted with a contact pool"},
  {"assert": "__DQ.state().field.camera.seeThrough.heroWindow === false && __DQ.state().field.camera.seeThrough.fading === 0", "msg": "the screen-door dither is retired: no hero window, no dithered instances"},
  {"eval": "__DQ.cameraZoom(24)"}, {"wait": 2200}, {"shot": "opening-dist24"},
  {"eval": "__DQ.budget()"},
  {"eval": "__DQ.cameraZoom(10.5)"},
  {"eval": "__DQ.teleport('meadow', 0, -30)"}, {"eval": "__DQ.cameraOrbit(0)"}, {"wait": 2200}, {"shot": "north-edge-outward"},
  {"eval": "__DQ.budget()"},
  {"eval": "__DQ.teleport('meadow', -30, 0)"}, {"eval": "__DQ.cameraOrbit(90)"}, {"wait": 2200}, {"shot": "west-edge-outward"},
  {"eval": "__DQ.budget()"},
  {"eval": "__DQ.teleport('meadow', 0, 30)"}, {"eval": "__DQ.cameraOrbit(180)"}, {"wait": 2200}, {"shot": "south-edge-outward"},
  {"eval": "__DQ.budget()"},
  {"eval": "__DQ.teleport('meadow', 30, 0)"}, {"eval": "__DQ.cameraOrbit(270)"}, {"wait": 2200}, {"shot": "east-edge-outward"},
  {"eval": "__DQ.budget()"},
  {"eval": "__DQ.teleport('meadow', -10, 10)"}, {"eval": "__DQ.cameraOrbit(60)"}, {"wait": 2200}, {"shot": "cottage-yard"},
  {"eval": "__DQ.teleport('meadow', -22, -4)"}, {"eval": "__DQ.cameraOrbit(200)"}, {"wait": 2200}, {"shot": "pond-west"},
  {"eval": "__DQ.budget()"},

  {"note": "SEE-THROUGH: walk under the trees by the Beck with the lens in close. Whatever covers the boy fades cleanly; nothing dithers."},
  {"eval": "__DQ.teleport('meadow', 6, -14)"}, {"eval": "__DQ.cameraZoom(4.2)"}, {"wait": 1200},
  {"eval": "__DQ.cameraOrbit(20)"}, {"wait": 1600}, {"shot": "seethrough-under-the-trees"},
  {"eval": "__DQ.state().field.camera.fade"},
  {"eval": "__DQ.state().field.view.see"},
  {"assert": "__DQ.state().field.view.see.owner === 'camera'", "msg": "the props kit hands the see-through to the field camera (no double ghosting)"},
  {"note": "and with the camera's own pass switched off the props kit takes over — still a clean ghost, still no dither"},
  {"eval": "__DQ.cameraFade(false)"}, {"wait": 1600},
  {"eval": "__DQ.teleport('meadow', 15.6, 17)"}, {"eval": "__DQ.cameraZoom(4.6)"}, {"wait": 900},
  {"eval": "__DQ.cameraOrbit(210)"}, {"wait": 1800}, {"shot": "seethrough-props-kit-ghosts-the-orchard-tree"},
  {"eval": "__DQ.state().field.view.see"},
  {"assert": "__DQ.state().field.view.see.owner === null", "msg": "the props kit picks the see-through up when the camera drops it"},
  {"assert": "__DQ.state().field.view.see.ghosts >= 1", "msg": "the tree over the boy is ghosted, not dithered and not deleted"},
  {"assert": "__DQ.state().field.camera.seeThrough.heroWindow === false", "msg": "the screen-door hero window is parked: no dither in the frame"},
  {"eval": "__DQ.cameraFade(true)"}, {"wait": 900},

  {"eval": "__DQ.cameraZoom(10.5)"},
  {"eval": "__DQ.teleport('meadow', 1.4, 19.2)"}, {"eval": "__DQ.cameraOrbit(0)"}, {"wait": 2200},
  {"burst": {"name": "life", "count": 4, "interval": 400}},
  {"assert": "__DQ.errors.length === 0", "msg": "no runtime errors"}
]}
