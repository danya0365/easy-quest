  {
   "note": "GAP 3 \u2014 THE SKYLINE. Every painted place must stand ON the ring hills, not over them. sunkBelowCrest is how far its own painted horizon sits UNDER the hill crest on its bearing: positive = grounded."
  },
  {
   "eval": "JSON.stringify(__DQ.state().field.view.landmarks)"
  },
  {
   "eval": "JSON.stringify(__DQ.landmarks())"
  },
  {
   "assert": "__DQ.state().field.view.landmarks.length === 4",
   "msg": "four painted places on the skyline"
  },
  {
   "assert": "__DQ.state().field.view.landmarks.every(m => m.sunkBelowCrest > 0.8)",
   "msg": "every card's painted horizon is sunk below the ring-hill crest on its own bearing"
  },
  {
   "assert": "__DQ.state().field.view.landmarks.every(m => m.footY < 9)",
   "msg": "no card's foot is left hanging 18 units above the vale floor"
  },
  {
   "assert": "__DQ.state().field.view.landmarks.every(m => m.hillCrestDeg > 1.2)",
   "msg": "the pass in the hills is a dip, not a hole: there is a crest to stand on at every landmark bearing"
  },
  {
   "assert": "Math.abs(__DQ.landmarks().find(m=>m.id==='coddleston').bearing - 76) < 0.6",
   "msg": "the places sit on the bearings their signposts point down (no fit nudge)"
  },
