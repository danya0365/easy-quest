{ "name": "P22 in the real game", "steps": [
  { "waitFor": "window.__DQ && __DQ.ready", "timeout": 40000 },
  { "wait": 1200 },
  { "note": "src/main.js does not import src/ui/shop.js yet (it is integrator-owned), so the plugin is installed here exactly as main.js would: import once, call install(ctx)." },
  { "eval": "import('/src/ui/shop.js').then(m => m.install({ Bus: null })).then(() => 'installed')" },
  { "eval": "JSON.stringify(Object.keys(__DQ.state()).filter(k => k === 'shop'))" },
  { "eval": "__DQ.teleport('puddlewick')" },
  { "waitFor": "__DQ.state().map && __DQ.state().map.id === 'puddlewick'", "timeout": 20000 },
  { "wait": 2200 },
  { "shot": "01-puddlewick" },
  { "eval": "JSON.stringify({map: __DQ.state().map.id, gold: __DQ.state().gold, fps: __DQ.state().fps})" },

  { "note": "talk to Mr Hammond the ironmonger; when his conversation ends the shop opens by itself" },
  { "eval": "__DQ.say(['Iron, oil, and me deciding{n}whether you are ready for any of it.'], { npc: 'hammond', name: 'Mr Hammond', voice: 'low:0.86' })" },
  { "wait": 1600 },
  { "shot": "02-mr-hammond-talks" },
  { "press": "Enter", "times": 2, "delay": 900 },
  { "wait": 1600 },
  { "shot": "03-the-shop-opened-from-the-talk" },
  { "eval": "JSON.stringify({open: __DQ.state().shop.open, id: __DQ.state().shop.id, keeper: __DQ.state().shop.keeper, stage: __DQ.state().shop.stage})" },
  { "eval": "__DQ.shopPick('buy')" },
  { "wait": 1400 },
  { "shot": "04-the-stock-over-the-town" },
  { "eval": "JSON.stringify(__DQ.state().shop.windows)" },
  { "eval": "__DQ.shopPick('cypress_stick')" },
  { "wait": 1200 },
  { "press": "Enter", "times": 1, "delay": 900 },
  { "wait": 1100 },
  { "shot": "05-bought-in-the-real-game" },
  { "eval": "JSON.stringify({gold: __DQ.state().gold, bag: __DQ.state().shop.bag})" },
  { "press": "Enter", "times": 4, "delay": 800 },
  { "wait": 1200 },
  { "eval": "JSON.stringify({gold: __DQ.state().gold, bag: __DQ.state().shop.bag, party: __DQ.state().shop.party})" },
  { "eval": "__DQ.shopBack(3)" },
  { "wait": 1600 },
  { "eval": "__DQ.shopClose()" },
  { "wait": 1200 },
  { "shot": "06-back-in-the-town" },
  { "eval": "JSON.stringify({scene: __DQ.state().scene, stack: __DQ.state().sceneStack, shopOpen: __DQ.state().shop.open})" },

  { "note": "the hero can still walk: the counter gave the field back" },
  { "key": "ArrowLeft", "hold": 700 },
  { "wait": 500 },
  { "shot": "07-walking-again" },
  { "eval": "JSON.stringify(__DQ.state().player)" },

  { "note": "the inn and the church reached the same way" },
  { "eval": "__DQ.say(['%N% gold, and the soup{n}is not optional.'], { npc: 'pottle', name: 'Mrs Pottle', voice: 'high:0.98' })" },
  { "press": "Enter", "times": 2, "delay": 900 },
  { "wait": 1600 },
  { "shot": "08-mrs-pottles-beds" },
  { "eval": "JSON.stringify({id: __DQ.state().shop.id, kind: __DQ.state().shop.kind, price: __DQ.state().shop.price})" },
  { "eval": "__DQ.shopClose()" },
  { "wait": 1200 },
  { "eval": "__DQ.say(['Rest here a moment.{n}The book keeps its place.'], { npc: 'candlewick', name: 'Sister Candlewick', voice: 'high:1.0' })" },
  { "press": "Enter", "times": 2, "delay": 900 },
  { "wait": 1600 },
  { "shot": "09-the-shrine-of-saint-alden" },
  { "eval": "JSON.stringify({id: __DQ.state().shop.id, kind: __DQ.state().shop.kind})" },
  { "eval": "__DQ.shopPick('save')" },
  { "wait": 1300 },
  { "eval": "__DQ.shopPick('2')" },
  { "wait": 1200 },
  { "press": "Enter", "times": 1, "delay": 1000 },
  { "wait": 1600 },
  { "shot": "10-saved-in-the-real-game" },
  { "eval": "JSON.stringify(Object.keys(localStorage).filter(k => k.indexOf('dqv.save.2') === 0))" },
  { "press": "Enter", "times": 3, "delay": 800 },
  { "eval": "__DQ.shopBack(2)" },
  { "wait": 1200 },
  { "eval": "__DQ.shopClose()" },
  { "wait": 1600 },
  { "shot": "11-the-town-again" },
  { "eval": "JSON.stringify({scene: __DQ.state().scene, stack: __DQ.state().sceneStack})" },
  { "key": "ArrowUp", "hold": 700 },
  { "wait": 500 },
  { "shot": "12-still-walking" },

  { "eval": "JSON.stringify(__DQ.errors.slice(0,5))" },
  { "eval": "JSON.stringify({fps: __DQ.state().fps, scene: __DQ.state().scene})" },
  { "assert": "__DQ.errors.length===0", "msg": "no runtime errors in the real game" },
  { "assert": "__DQ.state().fps >= 55", "msg": "55+ fps with a counter open over the town" },
  { "assert": "__DQ.state().shop.last && __DQ.state().shop.last.id === 'puddlewick_shrine'", "msg": "the church opened from a talk" },
  { "assert": "__DQ.state().shop.open === false", "msg": "the counter closed and the field is playable" },
  { "assert": "Object.keys(localStorage).some(k => k === 'dqv.save.2')", "msg": "the church wrote a tale in the real game" }
] }
